import { Button, ScrollView, Slider } from "std-widgets.slint";
import { AppTheme } from "../theme.slint";
import { IconButton } from "icon_button.slint";

export struct LanguageItem {
    code: string,
    name: string,
    native_name: string,
    is_selected: bool,
}

export struct SettingOptionItem {
    id: string,
    name: string,
    desc: string,
    is_selected: bool,
}

export struct AudioDeviceItem {
    id: string,
    name: string,
    is_selected: bool,
}

export component SettingsView inherits Rectangle {
    in property <string> tr_settings_title;
    in property <string> app_version;
    in-out property <int> settings_active_tab;
    in property <string> tr_settings_tab_voice;
    in property <string> tr_settings_tab_language;
    in property <string> tr_settings_tab_keybinds;
    in property <string> tr_settings_tab_video_interface;
    in property <string> tr_settings_tab_security;
    in property <string> tr_settings_tab_network_proxy;
    in property <string> tr_settings_tab_updates;
    in property <string> tr_settings_output_device;
    in property <[AudioDeviceItem]> output_devices;
    in property <string> tr_settings_input_device;
    in property <[AudioDeviceItem]> input_devices;
    in-out property <float> mic_volume;
    in property <string> tr_settings_threshold;
    in-out property <float> vad_threshold;
    in property <string> tr_settings_mic_level;
    in property <float> mic_level;
    in property <bool> is_testing_mic;
    in property <string> tr_settings_btn_test_stop;
    in property <string> tr_settings_btn_test_start;
    in property <[LanguageItem]> languages;
    in property <string> tr_keybind_mute_title;
    in property <string> tr_keybind_mute_desc;
    in property <int> recording_keybind_for;
    in property <string> tr_keybind_recording_prompt;
    in property <string> keybind_mute_str;
    in property <string> tr_keybind_btn_record;
    in property <string> tr_keybind_btn_clear;
    in property <string> tr_keybind_guide_title;
    in property <string> tr_keybind_guide_desc;
    in property <string> tr_keybind_deafen_title;
    in property <string> tr_keybind_deafen_desc;
    in property <string> keybind_deafen_str;
    in property <[SettingOptionItem]> video_encoder_options;
    in property <bool> use-light-theme;
    in property <[SettingOptionItem]> video_capture_options;
    in property <[SettingOptionItem]> audio_loopback_options;
    in property <bool> enable_self_preview_notice;
    in property <bool> show_hardware_monitor;
    in property <[SettingOptionItem]> proxy_mode_options;
    in-out property <string> selected_proxy_mode;
    in-out property <string> proxy_host_input;
    in-out property <string> proxy_port_input;
    in-out property <string> proxy_username_input;
    in-out property <string> proxy_password_input;
    in property <bool> proxy_is_testing;
    in property <bool> proxy_route_media_enabled;
    in property <string> proxy_test_status_text;
    in property <bool> proxy_test_is_success;
    in property <string> update_check_feedback;
    in property <bool> is_checking_update;
    in property <string> tr_settings_done;

    callback close_settings();
    callback select_output_device(string);
    callback select_input_device(string);
    callback set_mic_volume(float);
    callback set_vad_threshold(float);
    callback toggle_test_mic();
    callback change_language(string);
    callback start_recording_keybind(int);
    callback reset_keybind(int);
    callback select_video_encoder(string);
    callback toggle_theme();
    callback select_video_capture_backend(string);
    callback select_audio_loopback_backend(string);
    callback toggle_enable_self_preview_notice();
    callback toggle_hardware_monitor();
    callback select_proxy_mode(string);
    callback test_proxy_requested(string, string, string, string, string);
    callback save_proxy_settings(string, string, string, string, string, bool);
    callback check_for_updates();

    background: AppTheme.backdrop-strong;
    width: 100%;
    height: 100%;

    // Dismiss modal and stop test loopback on clicking outside backdrop
    TouchArea {
        clicked => {
            root.close_settings();
        }
    }

    modal_box := Rectangle {
        width: Math.min(1060px, parent.width - 32px);
        height: Math.min(640px, parent.height - 32px);
        background: AppTheme.surface-sidebar;
        border-radius: 12px;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        clip: true;

        // Absorb any click inside modal box so it doesn't close modal or click through to underlying window
        modal_touch := TouchArea {
            clicked => {}
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. TOP HEADER BAR (Clean & Minimalist)
            Rectangle {
                height: 52px;
                background: AppTheme.surface-input;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/settings.svg");
                            width: 18px;
                            height: 18px;
                            colorize: AppTheme.accent;
                            image-fit: contain;
                        }
                    }

                    Text {
                        text: root.tr_settings_title;
                        color: AppTheme.text-strong;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: "Litecord " + root.app_version;
                        color: AppTheme.text-subtle;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 1px;
                            height: 16px;
                            background: AppTheme.interactive-hover;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../../assets/x.svg");
                            icon-color: AppTheme.text-muted;
                                        hover-color: AppTheme.danger-subtle;
                            clicked => { root.close_settings(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: AppTheme.surface-elevated; }

            // 2. MAIN HORIZONTAL BODY (Sidebar + Synchronized Scrollable Center & Guide)
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // =========================================================
                // LEFT SIDEBAR: CATEGORY NAVIGATION TABS (Width: 200px)
                // =========================================================
                Rectangle {
                    width: 200px;
                    background: AppTheme.surface-input;

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 4px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            Text {
                                text: "CONFIGURAÇÕES";
                                color: AppTheme.text-subtle;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                        }

                        // Tab 0: Voz & Áudio
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 0 ? AppTheme.interactive-hover : tab0_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 0: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.accent;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/microphone.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 0 ? AppTheme.accent : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_voice;
                                    color: root.settings_active_tab == 0 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 0 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab0_touch := TouchArea {
                                clicked => { root.settings_active_tab = 0; }
                            }
                        }

                        // Tab 1: Idioma / Language
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 1 ? AppTheme.interactive-hover : tab1_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 1: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.accent;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/globe.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 1 ? AppTheme.accent : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_language;
                                    color: root.settings_active_tab == 1 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 1 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab1_touch := TouchArea {
                                clicked => { root.settings_active_tab = 1; }
                            }
                        }

                        // Tab 2: Atalhos / Keybinds
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 2 ? AppTheme.interactive-hover : tab2_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 2: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.accent;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/key.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 2 ? AppTheme.accent : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_keybinds;
                                    color: root.settings_active_tab == 2 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 2 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab2_touch := TouchArea {
                                clicked => { root.settings_active_tab = 2; }
                            }
                        }

                        // Tab 5: Vídeo e Interface
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 5 ? AppTheme.interactive-hover : tab5_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 5: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.accent;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/monitor.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 5 ? AppTheme.accent : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_video_interface;
                                    color: root.settings_active_tab == 5 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 5 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab5_touch := TouchArea {
                                clicked => { root.settings_active_tab = 5; }
                            }
                        }

                        // Tab 3: Segurança & Privacidade
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 3 ? AppTheme.interactive-hover : tab3_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 3: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.success;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/settings.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 3 ? AppTheme.success : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_security;
                                    color: root.settings_active_tab == 3 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 3 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab3_touch := TouchArea {
                                clicked => { root.settings_active_tab = 3; }
                            }
                        }

                        // Tab 6: Rede & Proxy / Network & Proxy
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 6 ? AppTheme.interactive-hover : tab6_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 6: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.info;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/globe.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 6 ? AppTheme.info : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_network_proxy;
                                    color: root.settings_active_tab == 6 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 6 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab6_touch := TouchArea {
                                clicked => { root.settings_active_tab = 6; }
                            }
                        }

                        // Tab 4: Atualizações & Sistema
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: root.settings_active_tab == 4 ? AppTheme.interactive-hover : tab4_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                            if root.settings_active_tab == 4: Rectangle {
                                x: 0px;
                                y: 10px;
                                width: 3px;
                                height: 18px;
                                background: AppTheme.warning;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/rocket.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: root.settings_active_tab == 4 ? AppTheme.warning : AppTheme.text-muted;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.tr_settings_tab_updates;
                                    color: root.settings_active_tab == 4 ? AppTheme.text-strong : AppTheme.text-primary;
                                    font-size: 13px;
                                    font-weight: root.settings_active_tab == 4 ? 700 : 500;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            tab4_touch := TouchArea {
                                clicked => { root.settings_active_tab = 4; }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        // Bottom info badge in sidebar
                        Rectangle {
                            background: AppTheme.surface-elevated;
                            border-radius: 6px;
                            height: 32px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/lightning.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: AppTheme.warning;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: "Native Rust GUI";
                                    color: AppTheme.text-muted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle { width: 1px; background: AppTheme.surface-elevated; }

                // =========================================================================
                // MAIN CONTENT AREA: SYNCHRONIZED OPTIONS + GUIDE CARDS IN SINGLE SCROLL
                // =========================================================================
                Rectangle {
                    horizontal-stretch: 1;
                    background: AppTheme.surface-chat;

                    VerticalLayout {
                        padding: 0px;
                        spacing: 0px;

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                padding-top: 18px;
                                padding-bottom: 40px;
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 18px;

                                // =============================================================
                                // TAB 0: VOZ & ÁUDIO (OPTIONS AND ACCOMPANYING GUIDE CARDS)
                                // =============================================================
                                if root.settings_active_tab == 0: VerticalLayout {
                                    spacing: 16px;

                                    // --- ROW 1: OUTPUT DEVICE (SPEAKERS / HEADPHONES) + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/headphones.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_settings_output_device;
                                                    color: AppTheme.text-secondary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Rectangle {
                                                background: AppTheme.surface-input;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: AppTheme.border-subtle;

                                                VerticalLayout {
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 4px;

                                                    for dev in root.output_devices: Rectangle {
                                                        height: 38px;
                                                        background: dev.is_selected ? AppTheme.interactive-hover : (dev_out_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                        border-radius: 6px;
                                                        animate background { duration: 120ms; }

                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 12px;
                                                            spacing: 10px;

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: dev.is_selected ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                    width: 16px;
                                                                    height: 16px;
                                                                    image-fit: contain;
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Text {
                                                                    text: dev.name;
                                                                    color: dev.is_selected ? AppTheme.text-strong : AppTheme.text-primary;
                                                                    font-size: 12px;
                                                                    font-weight: dev.is_selected ? 700 : 500;
                                                                    overflow: elide;
                                                                }
                                                            }

                                                            Rectangle { horizontal-stretch: 1; }
                                                        }

                                                        dev_out_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.select_output_device(dev.name); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/headphones.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Dispositivo de Saída";
                                                    color: AppTheme.accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Para obter a melhor fidelidade posicional e evitar eco ou vazamento de som nas chamadas em grupo, utilize fones de ouvido estéreo.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 2: INPUT DEVICE (MICROPHONE) + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_settings_input_device;
                                                    color: AppTheme.text-secondary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Rectangle {
                                                background: AppTheme.surface-input;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: AppTheme.border-subtle;

                                                VerticalLayout {
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 4px;

                                                    for dev in root.input_devices: Rectangle {
                                                        height: 38px;
                                                        background: dev.is_selected ? AppTheme.interactive-hover : (dev_in_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                        border-radius: 6px;
                                                        animate background { duration: 120ms; }

                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 12px;
                                                            spacing: 10px;

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: dev.is_selected ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                    width: 16px;
                                                                    height: 16px;
                                                                    image-fit: contain;
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Text {
                                                                    text: dev.name;
                                                                    color: dev.is_selected ? AppTheme.text-strong : AppTheme.text-primary;
                                                                    font-size: 12px;
                                                                    font-weight: dev.is_selected ? 700 : 500;
                                                                    overflow: elide;
                                                                }
                                                            }

                                                            Rectangle { horizontal-stretch: 1; }
                                                        }

                                                        dev_in_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.select_input_device(dev.name); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Dispositivo de Entrada";
                                                    color: AppTheme.accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Selecione o microfone principal ou headset. Recomendamos usar o dispositivo padrão ou o microfone dedicado com cancelamento de ruído.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 3: MICROPHONE INPUT VOLUME (GAIN / AMPLIFICATION 0% TO 200%) + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "VOLUME DE ENTRADA (GANHO DO MICROFONE)";
                                                    color: AppTheme.text-secondary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }

                                                Rectangle { horizontal-stretch: 1; }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        background: root.mic_volume > 1.05 ? AppTheme.success : AppTheme.accent;
                                                        border-radius: 4px;
                                                        height: 18px;
                                                        width: 48px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: Math.round(root.mic_volume * 100) + "%";
                                                                color: AppTheme.text-on-accent;
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;

                                                Text {
                                                    text: "0%";
                                                    color: AppTheme.text-subtle;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }

                                                Slider {
                                                    horizontal-stretch: 1;
                                                    minimum: 0.0;
                                                    maximum: 2.0;
                                                    value: root.mic_volume;
                                                    changed(val) => {
                                                        root.mic_volume = val;
                                                        root.set_mic_volume(val);
                                                    }
                                                }

                                                Text {
                                                    text: "200%";
                                                    color: AppTheme.text-subtle;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Ganho do Microfone";
                                                    color: AppTheme.accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Ajuste o ganho do seu microfone. Valores acima de 100% (até 200%) amplificam o sinal da sua voz para os outros usuários na sala.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 4: VAD THRESHOLD SLIDER + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_settings_threshold;
                                                    color: AppTheme.text-secondary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }

                                                Rectangle { horizontal-stretch: 1; }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        background: AppTheme.accent;
                                                        border-radius: 4px;
                                                        height: 18px;
                                                        width: 44px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: Math.round(root.vad_threshold * 100) + "%";
                                                                color: AppTheme.text-on-accent;
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;

                                                Text {
                                                    text: "0%";
                                                    color: AppTheme.text-subtle;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }

                                                Slider {
                                                    horizontal-stretch: 1;
                                                    minimum: 0.0;
                                                    maximum: 1.0;
                                                    value: root.vad_threshold;
                                                    changed(val) => {
                                                        root.vad_threshold = val;
                                                        root.set_vad_threshold(val);
                                                    }
                                                }

                                                Text {
                                                    text: "100%";
                                                    color: AppTheme.text-subtle;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/speaker.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Sensibilidade (VAD)";
                                                    color: AppTheme.success;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Fale normalmente. Ajuste o controle para que sua voz ultrapasse a marca branca, mas ruídos como teclado mecânico e respiração fiquem abaixo.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 5: VU METER & TEST MIC + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/speaker.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_settings_mic_level;
                                                    color: AppTheme.text-secondary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }

                                                Rectangle { horizontal-stretch: 1; }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: center;

                                                    Rectangle {
                                                background: root.mic_level >= root.vad_threshold ? AppTheme.success-faint : AppTheme.surface-sidebar;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.border-subtle;
                                                        height: 18px;
                                                        width: 68px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: root.mic_level >= root.vad_threshold ? "ATIVO" : "SILÊNCIO";
                                                                color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.text-muted;
                                                                font-size: 10px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    Text {
                                                        width: 36px;
                                                        horizontal-alignment: right;
                                                        text: Math.round(root.mic_level * 100) + "%";
                                                        color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.text-muted;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                height: 22px;
                                                background: AppTheme.surface-input;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: AppTheme.border-subtle;
                                                clip: true;

                                                // Active Volume Level Fill
                                                Rectangle {
                                                    x: 3px;
                                                    y: 3px;
                                                    height: parent.height - 6px;
                                                    width: root.mic_level <= 0.005 ? 0px : Math.min(parent.width - 6px, Math.max(2px, (parent.width - 6px) * Math.min(1.0, Math.max(0.0, root.mic_level))));
                                                    background: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.warning;
                                                    border-radius: 4px;
                                                }

                                                // Threshold Position Indicator Marker Line
                                                Rectangle {
                                                    x: Math.min(parent.width - 5px, Math.max(3px, 3px + (parent.width - 6px) * Math.min(1.0, Math.max(0.0, root.vad_threshold))));
                                                    y: 0px;
                                                    width: 2px;
                                                    height: parent.height;
                                                    background: AppTheme.solid-white;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-top: 2px;
                                                Button {
                                                    icon: root.is_testing_mic ? @image-url("../../assets/microphone.svg") : @image-url("../../assets/headphones.svg");
                                                    text: root.is_testing_mic ? root.tr_settings_btn_test_stop : root.tr_settings_btn_test_start;
                                                    primary: root.is_testing_mic;
                                                    clicked => { root.toggle_test_mic(); }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/headphones.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.warning;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Teste de Retorno (Loopback)";
                                                    color: AppTheme.warning;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Permite escutar a sua voz tratada em tempo real com o filtro do Litecord nos seus fones para calibrar volume e clareza antes das partidas.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 5: SPEECH PRIORITY (DUCKING) + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/crown.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.warning;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Atenuação de Voz Inteligente (Ducking)";
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Text {
                                                    text: "ATIVO (P:1 a P:5)";
                                                    color: AppTheme.success;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: "O motor de áudio Opus PLC reduz automaticamente em 12dB o som dos outros membros quando líderes táticos com prioridade falam.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/rocket.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Vantagem Competitiva";
                                                    color: AppTheme.accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Elimina a cacofonia em momentos decisivos de jogos FPS/MOBA, garantindo que callouts críticos se sobressaiam instantaneamente.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 16px; }
                                }

                                // =============================================================
                                // TAB 1: IDIOMA / LANGUAGE (OPTIONS AND ACCOMPANYING GUIDE)
                                // =============================================================
                                if root.settings_active_tab == 1: VerticalLayout {
                                    spacing: 16px;

                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/globe.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "SELECIONE O IDIOMA DO CLIENTE";
                                                    color: AppTheme.text-secondary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Rectangle {
                                                background: AppTheme.surface-input;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: AppTheme.border-subtle;

                                                VerticalLayout {
                                                    padding-top: 8px;
                                                    padding-bottom: 8px;
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 4px;

                                                    for lang in root.languages: Rectangle {
                                                        height: 38px;
                                                        background: lang.is_selected ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                                        border-radius: 6px;

                                                        HorizontalLayout {
                                                            padding-left: 12px;
                                                            padding-right: 12px;
                                                            spacing: 10px;

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: lang.is_selected ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                    width: 16px;
                                                                    height: 16px;
                                                                    image-fit: contain;
                                                                }
                                                            }

                                                            Text {
                                                                text: lang.name;
                                                                color: lang.is_selected ? AppTheme.accent : AppTheme.text-primary;
                                                                font-size: 13px;
                                                                font-weight: lang.is_selected ? 700 : 500;
                                                                vertical-alignment: center;
                                                            }

                                                            Rectangle { horizontal-stretch: 1; }

                                                            Text {
                                                                text: lang.native_name;
                                                                color: AppTheme.text-subtle;
                                                                font-size: 12px;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        TouchArea {
                                                            clicked => { root.change_language(lang.code); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3, clean without card)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 12px;

                                            VerticalLayout {
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../../assets/globe.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Troca Instantânea";
                                                        color: AppTheme.accent;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: "A alteração de idioma é aplicada em tempo real em todas as janelas sem necessidade de reiniciar o Litecord.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // Horizontal separator between the two guides
                                            Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                            VerticalLayout {
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../../assets/rocket.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.success;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Detecção Automática";
                                                        color: AppTheme.success;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: "A opção 'Auto' identifica a região e linguagem padrão do seu sistema operacional (Windows/Linux).";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 16px; }
                                }

                                // =============================================================
                                // TAB 2: ATALHOS / KEYBINDS (OPTIONS AND ACCOMPANYING GUIDE)
                                // =============================================================
                                if root.settings_active_tab == 2: VerticalLayout {
                                    spacing: 16px;

                                    // --- ROW 1: MUTE / UNMUTE KEYBIND ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_keybind_mute_title;
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: root.tr_keybind_mute_desc;
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;

                                                // Shortcut Badge Display
                                                Rectangle {
                                                    background: root.recording_keybind_for == 1 ? AppTheme.surface-warning : AppTheme.surface-input;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: root.recording_keybind_for == 1 ? AppTheme.warning : AppTheme.border-subtle;
                                                    height: 36px;
                                                    horizontal-stretch: 1;

                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        spacing: 8px;
                                                        alignment: center;

                                                        Text {
                                                            text: root.recording_keybind_for == 1 ? root.tr_keybind_recording_prompt : (root.keybind_mute_str != "" ? root.keybind_mute_str : "Nenhum / Desativado");
                                                            color: root.recording_keybind_for == 1 ? AppTheme.warning : (root.keybind_mute_str != "" ? AppTheme.text-strong : AppTheme.text-subtle);
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                // Record / Set button
                                                Rectangle {
                                                    width: 120px;
                                                    height: 36px;
                                                    background: root.recording_keybind_for == 1 ? AppTheme.warning : (btn_rec_mute_touch.has-hover ? AppTheme.accent-hover : AppTheme.accent);
                                                    border-radius: 4px;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: root.recording_keybind_for == 1 ? "Gravando..." : root.tr_keybind_btn_record;
                                                            color: root.recording_keybind_for == 1 ? AppTheme.text-on-warning : AppTheme.text-on-accent;
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    btn_rec_mute_touch := TouchArea {
                                                        clicked => {
                                                            if root.recording_keybind_for == 1 {
                                                                root.start_recording_keybind(0);
                                                            } else {
                                                                root.start_recording_keybind(1);
                                                            }
                                                        }
                                                    }
                                                }

                                                // Reset / Clear button
                                                Rectangle {
                                                    width: 80px;
                                                    height: 36px;
                                                    background: btn_clear_mute_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                                    border-radius: 4px;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: root.tr_keybind_btn_clear;
                                                            color: AppTheme.text-primary;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    btn_clear_mute_touch := TouchArea {
                                                        clicked => { root.reset_keybind(1); }
                                                    }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/key.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_keybind_guide_title;
                                                    color: AppTheme.accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: root.tr_keybind_guide_desc;
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 2: DEAFEN / UNDEAFEN KEYBIND ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 10px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/headphones.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: root.tr_keybind_deafen_title;
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: root.tr_keybind_deafen_desc;
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;

                                                // Shortcut Badge Display
                                                Rectangle {
                                                    background: root.recording_keybind_for == 2 ? AppTheme.surface-warning : AppTheme.surface-input;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: root.recording_keybind_for == 2 ? AppTheme.warning : AppTheme.border-subtle;
                                                    height: 36px;
                                                    horizontal-stretch: 1;

                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        spacing: 8px;
                                                        alignment: center;

                                                        Text {
                                                            text: root.recording_keybind_for == 2 ? root.tr_keybind_recording_prompt : (root.keybind_deafen_str != "" ? root.keybind_deafen_str : "Nenhum / Desativado");
                                                            color: root.recording_keybind_for == 2 ? AppTheme.warning : (root.keybind_deafen_str != "" ? AppTheme.text-strong : AppTheme.text-subtle);
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                // Record / Set button
                                                Rectangle {
                                                    width: 120px;
                                                    height: 36px;
                                                    background: root.recording_keybind_for == 2 ? AppTheme.warning : (btn_rec_deaf_touch.has-hover ? AppTheme.success-hover : AppTheme.success);
                                                    border-radius: 4px;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: root.recording_keybind_for == 2 ? "Gravando..." : root.tr_keybind_btn_record;
                                                            color: root.recording_keybind_for == 2 ? AppTheme.text-on-warning : AppTheme.text-on-accent;
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    btn_rec_deaf_touch := TouchArea {
                                                        clicked => {
                                                            if root.recording_keybind_for == 2 {
                                                                root.start_recording_keybind(0);
                                                            } else {
                                                                root.start_recording_keybind(2);
                                                            }
                                                        }
                                                    }
                                                }

                                                // Reset / Clear button
                                                Rectangle {
                                                    width: 80px;
                                                    height: 36px;
                                                    background: btn_clear_deaf_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                                    border-radius: 4px;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: root.tr_keybind_btn_clear;
                                                            color: AppTheme.text-primary;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    btn_clear_deaf_touch := TouchArea {
                                                        clicked => { root.reset_keybind(2); }
                                                    }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/headphones.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Dica de Teclas";
                                                    color: AppTheme.success;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text {
                                                text: "Você pode usar teclas como F1-F12, teclas do NumPad, ou combinações com Ctrl, Shift e Alt para evitar conflitos.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 16px; }
                                }

                                // =============================================================
                                // TAB 5: VÍDEO E INTERFACE (ENCODER, CAPTURE, LOOPBACK, NOTICE)
                                // =============================================================
                                if root.settings_active_tab == 5: VerticalLayout {
                                    spacing: 16px;

                                    // --- SEÇÃO 1: CODIFICADOR DE VÍDEO (ENCODER) ---
                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/monitor.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: AppTheme.accent;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: "CODIFICADOR DE VÍDEO (H.264 ENCODER)";
                                                color: AppTheme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        Text {
                                            text: "Selecione o motor de aceleração por GPU ou CPU para codificar as transmissões de tela.";
                                            color: AppTheme.text-muted;
                                            font-size: 11px;
                                        }

                                        Rectangle {
                                            background: AppTheme.surface-input;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: AppTheme.border-subtle;

                                            VerticalLayout {
                                                padding-top: 6px;
                                                padding-bottom: 6px;
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;

                                                for opt in root.video_encoder_options: Rectangle {
                                                    height: 44px;
                                                    background: opt.is_selected ? AppTheme.interactive-hover : (opt_enc_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                    border-radius: 6px;
                                                    animate background { duration: 120ms; }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        spacing: 10px;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: opt.is_selected ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                width: 16px;
                                                                height: 16px;
                                                                image-fit: contain;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            alignment: center;
                                                            spacing: 2px;

                                                            Text {
                                                                text: opt.name;
                                                                color: opt.is_selected ? AppTheme.text-strong : AppTheme.text-primary;
                                                                font-size: 12px;
                                                                font-weight: opt.is_selected ? 700 : 500;
                                                            }

                                                            Text {
                                                                text: opt.desc;
                                                                color: opt.is_selected ? AppTheme.text-muted : AppTheme.text-subtle;
                                                                font-size: 10px;
                                                            }
                                                        }

                                                        Rectangle { horizontal-stretch: 1; }
                                                    }

                                                    opt_enc_ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.select_video_encoder(opt.id); }
                                                    }
                                                }
                                            }
                                        }

                                        // --- APARÊNCIA ---
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/moon.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: AppTheme.accent;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: "APARÊNCIA";
                                                color: AppTheme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        // Application color theme
                                        Rectangle {
                                            background: AppTheme.surface-input;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: AppTheme.border-subtle;

                                            HorizontalLayout {
                                                padding: 14px;
                                                spacing: 12px;
                                                alignment: space-between;

                                                VerticalLayout {
                                                    spacing: 4px;
                                                    horizontal-stretch: 1;

                                                    Text {
                                                        text: "Tema claro";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                    }

                                                    Text {
                                                        text: "Alterna toda a interface entre as paletas clara e escura.";
                                                        color: AppTheme.text-muted;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 42px;
                                                        height: 24px;
                                                        border-radius: 12px;
                                                        background: root.use-light-theme ? AppTheme.accent : AppTheme.surface-control;
                                                        animate background { duration: 150ms; }

                                                        Rectangle {
                                                            x: root.use-light-theme ? 20px : 2px;
                                                            y: 2px;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 10px;
                                                            background: AppTheme.solid-white;
                                                            animate x { duration: 150ms; easing: ease-out; }
                                                        }

                                                        theme_sw_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.toggle_theme(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // --- SEÇÃO 2: MÉTODO DE CAPTURA DE VÍDEO ---
                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/window.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: AppTheme.accent;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: "MÉTODO DE CAPTURA DE TELA E JANELAS";
                                                color: AppTheme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        Text {
                                            text: "Define como o Litecord captura o conteúdo visual do sistema operacional.";
                                            color: AppTheme.text-muted;
                                            font-size: 11px;
                                        }

                                        Rectangle {
                                            background: AppTheme.surface-input;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: AppTheme.border-subtle;

                                            VerticalLayout {
                                                padding-top: 6px;
                                                padding-bottom: 6px;
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;

                                                for opt in root.video_capture_options: Rectangle {
                                                    height: 44px;
                                                    background: opt.is_selected ? AppTheme.interactive-hover : (opt_vcap_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                    border-radius: 6px;
                                                    animate background { duration: 120ms; }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        spacing: 10px;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: opt.is_selected ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                width: 16px;
                                                                height: 16px;
                                                                image-fit: contain;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            alignment: center;
                                                            spacing: 2px;

                                                            Text {
                                                                text: opt.name;
                                                                color: opt.is_selected ? AppTheme.text-strong : AppTheme.text-primary;
                                                                font-size: 12px;
                                                                font-weight: opt.is_selected ? 700 : 500;
                                                            }

                                                            Text {
                                                                text: opt.desc;
                                                                color: opt.is_selected ? AppTheme.text-muted : AppTheme.text-subtle;
                                                                font-size: 10px;
                                                            }
                                                        }

                                                        Rectangle { horizontal-stretch: 1; }
                                                    }

                                                    opt_vcap_ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.select_video_capture_backend(opt.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // --- SEÇÃO 3: CAPTURA DE ÁUDIO DA TRANSMISSÃO (LOOPBACK) ---
                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/speaker.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: AppTheme.accent;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: "ÁUDIO DA TRANSMISSÃO (LOOPBACK DO SISTEMA)";
                                                color: AppTheme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        Text {
                                            text: "Define a tecnologia de captura do som interno de jogos, vídeos e do sistema.";
                                            color: AppTheme.text-muted;
                                            font-size: 11px;
                                        }

                                        Rectangle {
                                            background: AppTheme.surface-input;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: AppTheme.border-subtle;

                                            VerticalLayout {
                                                padding-top: 6px;
                                                padding-bottom: 6px;
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;

                                                for opt in root.audio_loopback_options: Rectangle {
                                                    height: 44px;
                                                    background: opt.is_selected ? AppTheme.interactive-hover : (opt_aloop_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                    border-radius: 6px;
                                                    animate background { duration: 120ms; }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        spacing: 10px;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: opt.is_selected ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                width: 16px;
                                                                height: 16px;
                                                                image-fit: contain;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            alignment: center;
                                                            spacing: 2px;

                                                            Text {
                                                                text: opt.name;
                                                                color: opt.is_selected ? AppTheme.text-strong : AppTheme.text-primary;
                                                                font-size: 12px;
                                                                font-weight: opt.is_selected ? 700 : 500;
                                                            }

                                                            Text {
                                                                text: opt.desc;
                                                                color: opt.is_selected ? AppTheme.text-muted : AppTheme.text-subtle;
                                                                font-size: 10px;
                                                            }
                                                        }

                                                        Rectangle { horizontal-stretch: 1; }
                                                    }

                                                    opt_aloop_ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.select_audio_loopback_backend(opt.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // --- SEÇÃO 4: AVISOS E INTERFACE DE TRANSMISSÃO ---
                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/info.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: AppTheme.accent;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: "AVISOS E INTERFACE DE TRANSMISSÃO";
                                                color: AppTheme.text-secondary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        Rectangle {
                                            background: AppTheme.surface-input;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: AppTheme.border-subtle;

                                            HorizontalLayout {
                                                padding: 14px;
                                                spacing: 12px;
                                                alignment: space-between;

                                                VerticalLayout {
                                                    spacing: 4px;
                                                    horizontal-stretch: 1;

                                                    Text {
                                                        text: "Aviso de Prévia Econômica";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                    }

                                                    Text {
                                                        text: "Exibe a pílula de aviso na pré-visualização própria ao iniciar a transmissão informando sobre a taxa de quadros reduzida para economizar recursos.";
                                                        color: AppTheme.text-muted;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 42px;
                                                        height: 24px;
                                                        border-radius: 12px;
                                                        background: root.enable_self_preview_notice ? AppTheme.accent : AppTheme.surface-control;
                                                        animate background { duration: 150ms; }

                                                        Rectangle {
                                                            x: root.enable_self_preview_notice ? 20px : 2px;
                                                            y: 2px;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 10px;
                                                            background: AppTheme.solid-white;
                                                            animate x { duration: 150ms; easing: ease-out; }
                                                        }

                                                        notice_sw_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.toggle_enable_self_preview_notice(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Hardware Performance HUD Toggle
                                        Rectangle {
                                            background: AppTheme.surface-input;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: AppTheme.border-subtle;

                                            HorizontalLayout {
                                                padding: 14px;
                                                spacing: 12px;
                                                alignment: space-between;

                                                VerticalLayout {
                                                    spacing: 4px;
                                                    horizontal-stretch: 1;

                                                    Text {
                                                        text: "Monitor de Desempenho (CPU / RAM / GPU)";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                    }

                                                    Text {
                                                        text: "Exibe em tempo real o percentual de uso de RAM, CPU e GPU na barra de título do aplicativo ao lado das configurações.";
                                                        color: AppTheme.text-muted;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 42px;
                                                        height: 24px;
                                                        border-radius: 12px;
                                                        background: root.show_hardware_monitor ? AppTheme.accent : AppTheme.surface-control;
                                                        animate background { duration: 150ms; }

                                                        Rectangle {
                                                            x: root.show_hardware_monitor ? 20px : 2px;
                                                            y: 2px;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 10px;
                                                            background: AppTheme.solid-white;
                                                            animate x { duration: 150ms; easing: ease-out; }
                                                        }

                                                        hw_sw_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.toggle_hardware_monitor(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 20px; }
                                }

                                // =============================================================
                                // TAB 3: SEGURANÇA & PRIVACIDADE (OPTIONS AND GUIDES)
                                // =============================================================
                                if root.settings_active_tab == 3: VerticalLayout {
                                    spacing: 16px;

                                    // --- ROW 1: E2EE VIDEO/AUDIO + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/shield.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Criptografia E2EE de Vídeo & Som";
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Text {
                                                    text: "AES-256-GCM ATIVO";
                                                    color: AppTheme.success;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: "Cada quadro a 60 FPS e áudio loopback é criptografado com chaves simétricas de 256 bits via aceleração de hardware AES-NI.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/shield.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Proteção Wi-Fi & LAN";
                                                    color: AppTheme.success;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: "Impede que qualquer pessoa no mesmo roteador capture seu stream com analisadores de pacotes como Wireshark.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 2: WINDOWS DPAPI + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/key.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Cofre de Credenciais Windows DPAPI";
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Text {
                                                    text: "PROTEGIDO";
                                                    color: AppTheme.accent;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: "Seu token do Discord é armazenado com criptografia nativa CryptProtectData vinculada à sua conta de usuário do Windows.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/shield.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Imunidade a Stealers";
                                                    color: AppTheme.accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: "Scripts e malwares não autorizados não conseguem roubar sua sessão porque a chave criptográfica reside no kernel do Windows.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 3: DISCORD DAVE + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/microphone.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Voz Discord Oficial (Protocolo DAVE)";
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Text {
                                                    text: "MLS RFC 9420";
                                                    color: AppTheme.success;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: "Comunicação de voz criptografada ponta a ponta com os servidores de voz oficiais do Discord sem intermediários.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/lightning.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Zero Intermediários";
                                                    color: AppTheme.success;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: "Conexões 100% diretas com a API do Discord. Não existem servidores de terceiros ou telemetria embutida.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 16px; }
                                }

                                // =============================================================
                                // TAB 6: REDE & PROXY (OPTIONS AND GUIDES)
                                // =============================================================
                                if root.settings_active_tab == 6: VerticalLayout {
                                    spacing: 16px;

                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Options Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 240px;
                                            padding-right: 12px;
                                            spacing: 12px;

                                            // Section 1: Proxy Mode Selector
                                            VerticalLayout {
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../../assets/globe.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.info;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Modo de Conexão Proxy";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Rectangle {
                                                    background: AppTheme.surface-input;
                                                    border-radius: 8px;
                                                    border-width: 1px;
                                                    border-color: AppTheme.surface-sidebar;

                                                    VerticalLayout {
                                                        padding-top: 4px;
                                                        padding-bottom: 4px;
                                                        padding-left: 4px;
                                                        padding-right: 4px;
                                                        spacing: 3px;

                                                        for opt in root.proxy_mode_options: Rectangle {
                                                            height: 40px;
                                                            background: (opt.id == root.selected_proxy_mode) ? AppTheme.interactive-hover : (opt_proxy_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                            border-radius: 6px;
                                                            animate background { duration: 120ms; }

                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 10px;
                                                                spacing: 8px;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: (opt.id == root.selected_proxy_mode) ? @image-url("../../assets/radio-selected.svg") : @image-url("../../assets/radio-unselected.svg");
                                                                        width: 16px;
                                                                        height: 16px;
                                                                        image-fit: contain;
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    spacing: 1px;
                                                                    horizontal-stretch: 1;

                                                                    Text {
                                                                        text: opt.name;
                                                                        color: (opt.id == root.selected_proxy_mode) ? AppTheme.text-strong : AppTheme.text-primary;
                                                                        font-size: 11px;
                                                                        font-weight: (opt.id == root.selected_proxy_mode) ? 700 : 500;
                                                                        overflow: elide;
                                                                    }

                                                                    Text {
                                                                        text: opt.desc;
                                                                        color: (opt.id == root.selected_proxy_mode) ? AppTheme.text-muted : AppTheme.text-subtle;
                                                                        font-size: 10px;
                                                                        overflow: elide;
                                                                    }
                                                                }
                                                            }

                                                            opt_proxy_ta := TouchArea {
                                                                mouse-cursor: pointer;
                                                                clicked => {
                                                                    root.selected_proxy_mode = opt.id;
                                                                    root.select_proxy_mode(opt.id);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Section 2: Host / Port / Credentials Inputs (only when HTTP or SOCKS5)
                                            if root.selected_proxy_mode == "http" || root.selected_proxy_mode == "socks5": VerticalLayout {
                                                spacing: 8px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../../assets/settings.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.info;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Endereço e Autenticação do Proxy";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                // Host & Port Row
                                                HorizontalLayout {
                                                    spacing: 8px;

                                                    // Host Field
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 130px;
                                                        spacing: 4px;
                                                        Text {
                                                            text: "Servidor / IP Host:";
                                                            color: AppTheme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                        }
                                                        Rectangle {
                                                            height: 34px;
                                                            background: AppTheme.surface-input;
                                                            border-radius: 6px;
                                                            border-width: 1px;
                                                            border-color: proxy_host_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 10px;
                                                                proxy_host_input_box := TextInput {
                                                                    text <=> root.proxy_host_input;
                                                                    color: AppTheme.text-strong;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                    single-line: true;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Port Field
                                                    VerticalLayout {
                                                        width: 80px;
                                                        spacing: 4px;
                                                        Text {
                                                            text: "Porta:";
                                                            color: AppTheme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                        }
                                                        Rectangle {
                                                            height: 34px;
                                                            background: AppTheme.surface-input;
                                                            border-radius: 6px;
                                                            border-width: 1px;
                                                            border-color: proxy_port_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 10px;
                                                                proxy_port_input_box := TextInput {
                                                                    text <=> root.proxy_port_input;
                                                                    color: AppTheme.text-strong;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                    single-line: true;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                // Username & Password Row
                                                HorizontalLayout {
                                                    spacing: 8px;

                                                    // Username Field
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 100px;
                                                        spacing: 4px;
                                                        Text {
                                                            text: "Usuário (Opcional):";
                                                            color: AppTheme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                        }
                                                        Rectangle {
                                                            height: 34px;
                                                            background: AppTheme.surface-input;
                                                            border-radius: 6px;
                                                            border-width: 1px;
                                                            border-color: proxy_user_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 10px;
                                                                proxy_user_input_box := TextInput {
                                                                    text <=> root.proxy_username_input;
                                                                    color: AppTheme.text-strong;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                    single-line: true;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Password Field
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 100px;
                                                        spacing: 4px;
                                                        Text {
                                                            text: "Senha (Opcional):";
                                                            color: AppTheme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                        }
                                                        Rectangle {
                                                            height: 34px;
                                                            background: AppTheme.surface-input;
                                                            border-radius: 6px;
                                                            border-width: 1px;
                                                            border-color: proxy_pass_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 10px;
                                                                proxy_pass_input_box := TextInput {
                                                                    text <=> root.proxy_password_input;
                                                                    color: AppTheme.text-strong;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                    single-line: true;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Action Buttons & Status Feedback
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                // Test Button
                                                Rectangle {
                                                    height: 32px;
                                                    width: 115px;
                                                    background: test_btn_ta.has-hover ? AppTheme.surface-sidebar : AppTheme.surface-input;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: AppTheme.border-subtle;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("../../assets/lightning.svg");
                                                                width: 13px;
                                                                height: 13px;
                                                                colorize: AppTheme.info;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        Text {
                                                            text: root.proxy_is_testing ? "Testando..." : "Testar Proxy";
                                                            color: AppTheme.text-strong;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    test_btn_ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.test_proxy_requested(
                                                                root.selected_proxy_mode,
                                                                root.proxy_host_input,
                                                                root.proxy_port_input,
                                                                root.proxy_username_input,
                                                                root.proxy_password_input
                                                            );
                                                        }
                                                    }
                                                }

                                                // Save & Apply Button
                                                Rectangle {
                                                    height: 32px;
                                                    width: 125px;
                                                    background: save_btn_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                                    border-radius: 6px;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        spacing: 6px;
                                                        Text {
                                                            text: "Salvar e Aplicar";
                                                            color: AppTheme.text-on-accent;
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    save_btn_ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.save_proxy_settings(
                                                                root.selected_proxy_mode,
                                                                root.proxy_host_input,
                                                                root.proxy_port_input,
                                                                root.proxy_username_input,
                                                                root.proxy_password_input,
                                                                root.proxy_route_media_enabled
                                                            );
                                                        }
                                                    }
                                                }
                                            }

                                            // Test Status Message (Flexible auto-expanding container for multi-line error/success)
                                            if root.proxy_test_status_text != "": Rectangle {
                                                background: root.proxy_test_is_success ? AppTheme.surface-success : AppTheme.surface-danger;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;

                                                VerticalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    padding-top: 8px;
                                                    padding-bottom: 8px;

                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        alignment: start;

                                                        VerticalLayout {
                                                            alignment: start;
                                                            padding-top: 1px;
                                                            Image {
                                                                source: root.proxy_test_is_success ? @image-url("../../assets/lightning.svg") : @image-url("../../assets/alert-triangle.svg");
                                                                width: 13px;
                                                                height: 13px;
                                                                colorize: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;
                                                                image-fit: contain;
                                                            }
                                                        }

                                                        Text {
                                                            text: root.proxy_test_status_text;
                                                            color: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            wrap: word-wrap;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 220px;
                                            padding-left: 12px;
                                            padding-right: 10px;
                                            padding-top: 2px;
                                            spacing: 12px;

                                            // Guide 1: Burlar Bloqueios
                                            VerticalLayout {
                                                spacing: 3px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                         alignment: center;
                                                         Image {
                                                             source: @image-url("../../assets/shield.svg");
                                                             width: 13px;
                                                             height: 13px;
                                                             colorize: AppTheme.info;
                                                             image-fit: contain;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Burlar Bloqueios";
                                                         color: AppTheme.info;
                                                         font-size: 11px;
                                                         font-weight: 700;
                                                         wrap: word-wrap;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                                 Text {
                                                     text: "Permite contornar firewalls e bloqueios de DNS em colégios ou empresas.";
                                                     color: AppTheme.text-muted;
                                                     font-size: 10px;
                                                     wrap: word-wrap;
                                                 }
                                             }

                                             // Guide 2: Tor e SOCKS5
                                             VerticalLayout {
                                                 spacing: 3px;
                                                 HorizontalLayout {
                                                     spacing: 6px;
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Image {
                                                             source: @image-url("../../assets/key.svg");
                                                             width: 13px;
                                                             height: 13px;
                                                             colorize: AppTheme.accent;
                                                             image-fit: contain;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Tor & SOCKS5";
                                                         color: AppTheme.accent;
                                                         font-size: 11px;
                                                         font-weight: 700;
                                                         wrap: word-wrap;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                                 Text {
                                                     text: "Compatível com a porta 9050 do Tor e túneis SSH locais para anonimizar seu IP.";
                                                     color: AppTheme.text-muted;
                                                     font-size: 10px;
                                                     wrap: word-wrap;
                                                 }
                                             }

                                             // Guide 3: Burp Suite & Devs
                                             VerticalLayout {
                                                 spacing: 3px;
                                                 HorizontalLayout {
                                                     spacing: 6px;
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Image {
                                                             source: @image-url("../../assets/terminal.svg");
                                                             width: 13px;
                                                             height: 13px;
                                                             colorize: AppTheme.warning;
                                                             image-fit: contain;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Debugging & Burp";
                                                         color: AppTheme.warning;
                                                         font-size: 11px;
                                                         font-weight: 700;
                                                         wrap: word-wrap;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                                 Text {
                                                     text: "Aponte para 127.0.0.1:8080 para inspecionar requisições da API REST.";
                                                     color: AppTheme.text-muted;
                                                     font-size: 10px;
                                                     wrap: word-wrap;
                                                 }
                                             }

                                             // Guide 4: Latência em Jogos
                                             VerticalLayout {
                                                 spacing: 3px;
                                                 HorizontalLayout {
                                                     spacing: 6px;
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Image {
                                                             source: @image-url("../../assets/lightning.svg");
                                                             width: 13px;
                                                             height: 13px;
                                                             colorize: AppTheme.success;
                                                             image-fit: contain;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Desempenho em Jogos";
                                                         color: AppTheme.success;
                                                         font-size: 11px;
                                                         font-weight: 700;
                                                         wrap: word-wrap;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                                 Text {
                                                     text: "Com proxy desativado, o impacto é 0%. Voz e vídeo mantêm rotas UDP diretas.";
                                                     color: AppTheme.text-muted;
                                                     font-size: 10px;
                                                     wrap: word-wrap;
                                                 }
                                             }
                                         }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 16px; }
                                }

                                // =============================================================
                                // TAB 4: ATUALIZAÇÕES & SISTEMA (OPTIONS AND GUIDES)
                                // =============================================================
                                if root.settings_active_tab == 4: VerticalLayout {
                                    spacing: 16px;

                                    // --- ROW 1: UPDATER + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 14px;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                horizontal-stretch: 1;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: "Litecord Client";
                                                        color: AppTheme.text-strong;
                                                        font-size: 14px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: root.app_version;
                                                        color: AppTheme.accent;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }

                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                if root.update_check_feedback != "": Text {
                                                    text: root.update_check_feedback;
                                                    color: AppTheme.success;
                                                    font-size: 11px;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: root.is_checking_update ? "Verificando..." : "Verificar Atualizações";
                                                    enabled: !root.is_checking_update;
                                                    clicked => { root.check_for_updates(); }
                                                }
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/rocket.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.warning;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Canal Oficial de Releases";
                                                    color: AppTheme.warning;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: "As atualizações são verificadas diretamente no repositório do GitHub com validação de assinatura de domínio.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Horizontal Row Separator
                                    Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                    // --- ROW 2: ARCHITECTURE & DEEPSLEEP + GUIDE ---
                                    HorizontalLayout {
                                        spacing: 0px;

                                        // Option Block (Left - Col 2)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            padding-right: 16px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/lightning.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.warning;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Performance Nativa em Rust";
                                                    color: AppTheme.text-strong;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: "• Uso de CPU: < 0.1% em idle (0.0% no modo DeepSleep na bandeja)\n• Memória RAM: ~32 MB (contra mais de 700 MB do Electron)\n• Pipeline de áudio Opus PLC com atenuação de volume inteligente";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // Vertical Separator Line between Col 2 and Col 3
                                        Rectangle {
                                            width: 1px;
                                            background: AppTheme.border-subtle;
                                        }

                                        // Guide Block (Right - Col 3)
                                        VerticalLayout {
                                            width: 290px;
                                            padding-left: 16px;
                                            padding-top: 2px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../../assets/moon.svg");
                                                        width: 14px;
                                                        height: 14px;
                                                        colorize: AppTheme.success;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Modo DeepSleep";
                                                    color: AppTheme.success;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: "Ao minimizar para a bandeja, a interface congela sua renderização para garantir 100% de FPS para seus jogos.";
                                                color: AppTheme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // Generous Bottom Spacer
                                    Rectangle { height: 16px; }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: AppTheme.surface-elevated; }

            // 3. BOTTOM PINNED FOOTER BAR
            Rectangle {
                height: 52px;
                background: AppTheme.surface-input;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;

                    Text {
                        text: "Litecord • Ultra-Fast Native Discord Client";
                        color: AppTheme.text-subtle;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.tr_settings_done;
                            primary: true;
                            clicked => { root.close_settings(); }
                        }
                    }
                }
            }
        }
    }
}

import { ScrollView, Slider } from "std-widgets.slint";
import { AppTheme, TypeScale } from "../theme.slint";
import { Tr } from "tr.slint";
import {
    SettingOptionItem, AudioDeviceItem, SettingsNavItem, SettingsNavGroup, SettingsPageTitle,
    SettingsSection, SettingsRow, SettingsSwitch, SettingsSwitchRow, SettingsButton,
    OptionSelect, DeviceSelect, SettingsInput,
} from "settings_kit.slint";

export { SettingOptionItem, AudioDeviceItem }

export struct LanguageItem {
    code: string,
    name: string,
    native_name: string,
    is_selected: bool,
}

export component SettingsView inherits Rectangle {
    in property <string> tr_settings_title;
    in property <string> app_version;
    in-out property <int> settings_active_tab;
    in property <string> tr_settings_tab_voice;
    in property <string> tr_settings_tab_language;
    in property <string> tr_settings_tab_keybinds;
    in property <string> tr_settings_tab_video_interface;
    in property <string> tr_settings_tab_security;
    in property <string> tr_settings_tab_network_proxy;
    in property <string> tr_settings_tab_updates;
    in property <string> tr_settings_output_device;
    in property <[AudioDeviceItem]> output_devices;
    in property <string> tr_settings_input_device;
    in property <[AudioDeviceItem]> input_devices;
    in-out property <float> mic_volume;
    in property <string> tr_settings_threshold;
    in-out property <float> vad_threshold;
    in property <string> tr_settings_mic_level;
    in property <float> mic_level;
    in property <bool> is_testing_mic;
    in property <string> tr_settings_btn_test_stop;
    in property <string> tr_settings_btn_test_start;
    in property <[LanguageItem]> languages;
    in property <string> tr_keybind_mute_title;
    in property <string> tr_keybind_mute_desc;
    in property <int> recording_keybind_for;
    in property <string> tr_keybind_recording_prompt;
    in property <string> keybind_mute_str;
    in property <string> tr_keybind_btn_record;
    in property <string> tr_keybind_btn_clear;
    in property <string> tr_keybind_guide_title;
    in property <string> tr_keybind_guide_desc;
    in property <string> tr_keybind_deafen_title;
    in property <string> tr_keybind_deafen_desc;
    in property <string> keybind_deafen_str;
    in property <[SettingOptionItem]> video_encoder_options;
    in property <bool> gpu_selection_available;
    in property <string> stream_capture_status;
    in property <bool> use-light-theme;
    in property <[SettingOptionItem]> video_capture_options;
    in property <[SettingOptionItem]> audio_loopback_options;
    in property <bool> enable_self_preview_notice;
    in property <bool> show_hardware_monitor;
    in property <bool> use_gpu_renderer;
    in property <bool> net_diag_running;
    in property <int> net_diag_verdict: -1; // -1 not run, 0 direct, 1 symmetric, 2 varying IP, 3 UDP blocked
    in property <bool> net_diag_signaling_ok: true;
    in property <bool> net_diag_copied;
    in property <[SettingOptionItem]> proxy_mode_options;
    in-out property <string> selected_proxy_mode;
    in-out property <string> proxy_host_input;
    in-out property <string> proxy_port_input;
    in-out property <string> proxy_username_input;
    in-out property <string> proxy_password_input;
    in property <bool> proxy_is_testing;
    in property <bool> proxy_route_media_enabled;
    in property <string> proxy_test_status_text;
    in property <bool> proxy_test_is_success;
    in property <string> update_check_feedback;
    in property <bool> is_checking_update;
    in property <string> tr_settings_done;

    callback close_settings();
    callback select_output_device(string);
    callback select_input_device(string);
    callback set_mic_volume(float);
    callback set_vad_threshold(float);
    callback toggle_test_mic();
    callback change_language(string);
    callback start_recording_keybind(int);
    callback reset_keybind(int);
    callback select_video_encoder(string);
    callback toggle_theme();
    callback select_video_capture_backend(string);
    callback select_audio_loopback_backend(string);
    callback toggle_enable_self_preview_notice();
    callback toggle_hardware_monitor();
    callback toggle_gpu_renderer();
    callback run_network_diagnostics();
    callback copy_network_diagnostics();
    callback select_proxy_mode(string);
    callback test_proxy_requested(string, string, string, string, string);
    callback save_proxy_settings(string, string, string, string, string, bool);
    callback check_for_updates();

    // Tabs keep their old numbers (Rust and the automation tests address them):
    // 0 voice, 5 video, 2 keybinds, 1 appearance and language, 6 network,
    // 4 privacy and about (3, the old security tab, shows the same page).

    background: AppTheme.backdrop-strong;
    width: 100%;
    height: 100%;

    // Clicking outside the window closes it (and stops a running mic test).
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.close_settings(); }
    }

    modal_box := Rectangle {
        width: Math.min(1060px, parent.width - 32px);
        height: Math.min(680px, parent.height - 32px);
        background: AppTheme.surface-window;
        border-radius: 12px;
        border-width: 1px;
        border-color: AppTheme.border-subtle;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        clip: true;

        // Clicks inside the window must not reach the backdrop.
        TouchArea { clicked => {} }

        VerticalLayout {
            // Header: title, version, close.
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text {
                        text: Tr.settings_header;
                        color: AppTheme.text-strong;
                        font-size: TypeScale.title;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "Litecord " + root.app_version;
                        color: AppTheme.text-muted;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                    }
                    close_btn := Rectangle {
                        width: 40px;
                        height: 40px;
                        y: 8px;
                        border-radius: 8px;
                        background: close_ta.has-hover ? AppTheme.interactive-hover : transparent;
                        Path {
                            width: 12px;
                            height: 12px;
                            x: 14px;
                            y: 14px;
                            commands: "M 0 0 L 12 12 M 12 0 L 0 12";
                            stroke: AppTheme.text-secondary;
                            stroke-width: 1.8px;
                        }
                        close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_settings(); }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: AppTheme.separator;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                // Navigation, grouped: calls first, then the app itself.
                Rectangle {
                    width: 220px;
                    background: AppTheme.surface-sidebar;
                    VerticalLayout {
                        padding: 12px;
                        padding-top: 20px;
                        spacing: 2px;
                        alignment: start;
                        SettingsNavGroup { text: Tr.settings_group_calls; x: 12px; height: 22px; }
                        SettingsNavItem {
                            text: root.tr_settings_tab_voice;
                            active: root.settings_active_tab == 0;
                            clicked => { root.settings_active_tab = 0; }
                        }
                        SettingsNavItem {
                            text: root.tr_settings_tab_video_interface;
                            active: root.settings_active_tab == 5;
                            clicked => { root.settings_active_tab = 5; }
                        }
                        SettingsNavItem {
                            text: root.tr_settings_tab_keybinds;
                            active: root.settings_active_tab == 2;
                            clicked => { root.settings_active_tab = 2; }
                        }
                        Rectangle { height: 14px; }
                        SettingsNavGroup { text: Tr.settings_group_app; x: 12px; height: 22px; }
                        SettingsNavItem {
                            text: Tr.settings_tab_appearance;
                            active: root.settings_active_tab == 1;
                            clicked => { root.settings_active_tab = 1; }
                        }
                        SettingsNavItem {
                            text: root.tr_settings_tab_network_proxy;
                            active: root.settings_active_tab == 6;
                            clicked => { root.settings_active_tab = 6; }
                        }
                        SettingsNavItem {
                            text: Tr.settings_tab_about;
                            active: root.settings_active_tab == 4 || root.settings_active_tab == 3;
                            clicked => { root.settings_active_tab = 4; }
                        }
                    }
                }

                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 28px;
                        padding-bottom: 40px;
                        alignment: start;

                        // ── Voice and audio ─────────────────────────────────────
                        if root.settings_active_tab == 0: VerticalLayout {
                            spacing: 28px;
                            alignment: start;
                            SettingsPageTitle { title: root.tr_settings_tab_voice; }

                            SettingsSection {
                                title: Tr.output_device;
                                DeviceSelect {
                                    devices: root.output_devices;
                                    picked(name) => { root.select_output_device(name); }
                                }
                                Text { text: Tr.output_hint; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                            }
                            SettingsSection {
                                title: Tr.input_device;
                                DeviceSelect {
                                    devices: root.input_devices;
                                    picked(name) => { root.select_input_device(name); }
                                }
                                Text { text: Tr.input_hint; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                            }

                            SettingsSection {
                                title: Tr.mic_gain;
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Slider {
                                            horizontal-stretch: 1;
                                            minimum: 0.0;
                                            maximum: 2.0;
                                            value: root.mic_volume;
                                            changed(val) => {
                                                root.mic_volume = val;
                                                root.set_mic_volume(val);
                                            }
                                        }
                                        Text { text: Math.round(root.mic_volume * 100) + "%"; width: 44px; horizontal-alignment: right; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: 600; vertical-alignment: center; }
                                    }
                                    Text { text: Tr.mic_gain_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                }

                                // Sensitivity: the live level against the threshold marker.
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: Tr.sensitivity; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: 600; horizontal-stretch: 1; }
                                        Rectangle {
                                            width: state.preferred-width + 16px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: root.mic_level >= root.vad_threshold ? AppTheme.success-faint : AppTheme.surface-elevated;
                                            state := Text {
                                                text: root.mic_level >= root.vad_threshold ? Tr.mic_state_active : Tr.mic_state_silent;
                                                color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.text-muted;
                                                font-size: TypeScale.caption;
                                                font-weight: 600;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 10px;
                                        border-radius: 5px;
                                        background: AppTheme.surface-elevated;
                                        clip: true;
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * Math.min(1.0, Math.max(0.0, root.mic_level));
                                            background: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.text-faint;
                                        }
                                        Rectangle {
                                            x: parent.width * root.vad_threshold - 1px;
                                            width: 2px;
                                            background: AppTheme.text-strong;
                                        }
                                    }
                                    Slider {
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        value: root.vad_threshold;
                                        changed(val) => {
                                            root.vad_threshold = val;
                                            root.set_vad_threshold(val);
                                        }
                                    }
                                    Text { text: Tr.sensitivity_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    SettingsButton {
                                        text: root.is_testing_mic ? root.tr_settings_btn_test_stop : root.tr_settings_btn_test_start;
                                        clicked => { root.toggle_test_mic(); }
                                    }
                                }
                            }

                            SettingsSection {
                                last: true;
                                SettingsRow {
                                    title: Tr.ducking;
                                    desc: Tr.ducking_desc;
                                    Text { text: Tr.ducking_active; color: AppTheme.success; font-size: TypeScale.caption; font-weight: 700; }
                                }
                            }
                        }

                        // ── Video and streaming ─────────────────────────────────
                        if root.settings_active_tab == 5: VerticalLayout {
                            spacing: 28px;
                            alignment: start;
                            SettingsPageTitle { title: root.tr_settings_tab_video_interface; }

                            SettingsSection {
                                title: Tr.stream_ui_title;
                                SettingsSwitchRow {
                                    title: Tr.economy_notice;
                                    desc: Tr.economy_notice_desc;
                                    checked: root.enable_self_preview_notice;
                                    toggled => { root.toggle_enable_self_preview_notice(); }
                                }
                                if root.stream_capture_status != "": Text {
                                    text: root.stream_capture_status;
                                    color: AppTheme.text-secondary;
                                    font-size: TypeScale.small;
                                    wrap: word-wrap;
                                }
                            }

                            SettingsSection {
                                title: Tr.settings_advanced;
                                last: true;
                                Text { text: Tr.settings_advanced_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: Tr.encoder_title; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: 600; }
                                    OptionSelect {
                                        options: root.video_encoder_options;
                                        picked(id) => { root.select_video_encoder(id); }
                                    }
                                    Text { text: Tr.encoder_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                    if root.gpu_selection_available: Text { text: Tr.gpu_next_stream; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: Tr.capture_method; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: 600; }
                                    OptionSelect {
                                        options: root.video_capture_options;
                                        picked(id) => { root.select_video_capture_backend(id); }
                                    }
                                    Text { text: root.gpu_selection_available ? Tr.gpu_gdi_help : Tr.capture_method_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: Tr.loopback_audio_title; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: 600; }
                                    OptionSelect {
                                        options: root.audio_loopback_options;
                                        picked(id) => { root.select_audio_loopback_backend(id); }
                                    }
                                    Text { text: Tr.loopback_audio_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                }
                            }
                        }

                        // ── Keybinds ────────────────────────────────────────────
                        if root.settings_active_tab == 2: VerticalLayout {
                            spacing: 28px;
                            alignment: start;
                            SettingsPageTitle { title: root.tr_settings_tab_keybinds; subtitle: root.tr_keybind_guide_desc; }
                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 16px;
                                    for kb in [
                                        { slot: 1, title: root.tr_keybind_mute_title, desc: root.tr_keybind_mute_desc, keys: root.keybind_mute_str },
                                        { slot: 2, title: root.tr_keybind_deafen_title, desc: root.tr_keybind_deafen_desc, keys: root.keybind_deafen_str },
                                    ]: SettingsRow {
                                        title: kb.title;
                                        desc: kb.desc;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Rectangle {
                                                width: 168px;
                                                height: 36px;
                                                border-radius: 6px;
                                                border-width: root.recording_keybind_for == kb.slot ? 2px : 1px;
                                                border-color: root.recording_keybind_for == kb.slot ? AppTheme.accent : AppTheme.border-subtle;
                                                background: root.recording_keybind_for == kb.slot ? AppTheme.surface-reply : (rec_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-elevated);
                                                Text {
                                                    text: root.recording_keybind_for == kb.slot ? Tr.recording : (kb.keys != "" ? kb.keys : Tr.keybind_none);
                                                    color: root.recording_keybind_for == kb.slot ? AppTheme.accent-soft : AppTheme.text-strong;
                                                    font-size: TypeScale.small;
                                                    font-weight: 600;
                                                }
                                                rec_ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        if root.recording_keybind_for == kb.slot {
                                                            root.start_recording_keybind(0);
                                                        } else {
                                                            root.start_recording_keybind(kb.slot);
                                                        }
                                                    }
                                                }
                                            }
                                            SettingsButton {
                                                text: root.tr_keybind_btn_clear;
                                                clicked => { root.reset_keybind(kb.slot); }
                                            }
                                        }
                                    }
                                }
                            }
                            Text { text: Tr.keys_tip_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                        }

                        // ── Appearance and language ─────────────────────────────
                        if root.settings_active_tab == 1: VerticalLayout {
                            spacing: 28px;
                            alignment: start;
                            SettingsPageTitle { title: Tr.settings_tab_appearance; }

                            SettingsSection {
                                title: Tr.appearance;
                                SettingsSwitchRow {
                                    title: Tr.light_theme;
                                    desc: Tr.light_theme_desc;
                                    checked: root.use-light-theme;
                                    toggled => { root.toggle_theme(); }
                                }
                                SettingsSwitchRow {
                                    title: Tr.perf_monitor;
                                    desc: Tr.perf_monitor_desc;
                                    checked: root.show_hardware_monitor;
                                    toggled => { root.toggle_hardware_monitor(); }
                                }
                                SettingsSwitchRow {
                                    title: Tr.gpu_render;
                                    desc: Tr.gpu_render_desc;
                                    checked: root.use_gpu_renderer;
                                    toggled => { root.toggle_gpu_renderer(); }
                                }
                            }

                            SettingsSection {
                                title: Tr.select_language;
                                last: true;
                                Rectangle {
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: AppTheme.border-subtle;
                                    VerticalLayout {
                                        padding: 4px;
                                        for lang in root.languages: Rectangle {
                                            height: 40px;
                                            border-radius: 6px;
                                            background: lang.is_selected ? AppTheme.interactive-selected : (lang_ta.has-hover ? AppTheme.interactive-hover : transparent);
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                Text { text: lang.name; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: lang.is_selected ? 600 : 500; vertical-alignment: center; horizontal-stretch: 1; }
                                                Text { text: lang.native_name; color: AppTheme.text-muted; font-size: TypeScale.small; vertical-alignment: center; }
                                            }
                                            lang_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.change_language(lang.code); }
                                            }
                                        }
                                    }
                                }
                                Text { text: Tr.instant_switch_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                            }
                        }

                        // ── Network ─────────────────────────────────────────────
                        if root.settings_active_tab == 6: VerticalLayout {
                            spacing: 28px;
                            alignment: start;
                            SettingsPageTitle { title: root.tr_settings_tab_network_proxy; }

                            SettingsSection {
                                title: Tr.proxy_mode;
                                OptionSelect {
                                    options: root.proxy_mode_options;
                                    selected-id: root.selected_proxy_mode;
                                    picked(id) => {
                                        root.selected_proxy_mode = id;
                                        root.select_proxy_mode(id);
                                    }
                                }
                                if root.selected_proxy_mode == "http" || root.selected_proxy_mode == "socks5": VerticalLayout {
                                    spacing: 12px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        SettingsInput { label: Tr.proxy_host; text <=> root.proxy_host_input; horizontal-stretch: 3; }
                                        SettingsInput { label: Tr.proxy_port; text <=> root.proxy_port_input; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        SettingsInput { label: Tr.proxy_user; text <=> root.proxy_username_input; }
                                        SettingsInput { label: Tr.proxy_pass; text <=> root.proxy_password_input; input-type: InputType.password; }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    SettingsButton {
                                        text: root.proxy_is_testing ? Tr.testing : Tr.test_proxy;
                                        enabled: !root.proxy_is_testing;
                                        clicked => {
                                            root.test_proxy_requested(root.selected_proxy_mode, root.proxy_host_input, root.proxy_port_input, root.proxy_username_input, root.proxy_password_input);
                                        }
                                    }
                                    SettingsButton {
                                        text: Tr.save_apply;
                                        primary: true;
                                        clicked => {
                                            root.save_proxy_settings(root.selected_proxy_mode, root.proxy_host_input, root.proxy_port_input, root.proxy_username_input, root.proxy_password_input, root.proxy_route_media_enabled);
                                        }
                                    }
                                }
                                if root.proxy_test_status_text != "": Rectangle {
                                    border-radius: 6px;
                                    background: root.proxy_test_is_success ? AppTheme.surface-success : AppTheme.surface-danger;
                                    HorizontalLayout {
                                        padding: 10px;
                                        Text {
                                            text: root.proxy_test_status_text;
                                            color: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;
                                            font-size: TypeScale.small;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                Text { text: Tr.gaming_perf_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                            }

                            SettingsSection {
                                title: Tr.net_diag_title;
                                last: true;
                                Text { text: Tr.net_diag_desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    SettingsButton {
                                        text: root.net_diag_running ? Tr.net_diag_running : Tr.net_diag_run;
                                        enabled: !root.net_diag_running;
                                        clicked => { root.run_network_diagnostics(); }
                                    }
                                    if root.net_diag_verdict >= 0 && !root.net_diag_running: SettingsButton {
                                        text: root.net_diag_copied ? Tr.net_diag_copied : Tr.net_diag_copy;
                                        clicked => { root.copy_network_diagnostics(); }
                                    }
                                }
                                if root.net_diag_verdict >= 0 && !root.net_diag_running: Text {
                                    color: root.net_diag_verdict == 0 && root.net_diag_signaling_ok ? AppTheme.success : AppTheme.danger;
                                    font-size: TypeScale.small;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    text: (root.net_diag_verdict == 0 ? Tr.net_diag_ok
                                        : root.net_diag_verdict == 1 ? Tr.net_diag_symmetric
                                        : root.net_diag_verdict == 2 ? Tr.net_diag_varying_ip
                                        : Tr.net_diag_udp_blocked)
                                        + (root.net_diag_signaling_ok ? "" : " " + Tr.net_diag_signaling_down);
                                }
                            }
                        }

                        // ── Privacy and about ───────────────────────────────────
                        if root.settings_active_tab == 4 || root.settings_active_tab == 3: VerticalLayout {
                            spacing: 28px;
                            alignment: start;
                            SettingsPageTitle { title: Tr.settings_tab_about; }

                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    SettingsRow {
                                        title: "Litecord " + root.app_version;
                                        desc: Tr.release_channel_desc;
                                        SettingsButton {
                                            text: root.is_checking_update ? Tr.checking : Tr.check_updates;
                                            enabled: !root.is_checking_update;
                                            clicked => { root.check_for_updates(); }
                                        }
                                    }
                                    if root.update_check_feedback != "": Text {
                                        text: root.update_check_feedback;
                                        color: AppTheme.text-secondary;
                                        font-size: TypeScale.small;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            SettingsSection {
                                title: Tr.settings_privacy_title;
                                last: true;
                                for item in [
                                    { title: Tr.vault_title, desc: Tr.vault_desc },
                                    { title: Tr.dave_title, desc: Tr.dave_desc },
                                    { title: Tr.zero_intermediaries, desc: Tr.zero_intermediaries_desc },
                                ]: HorizontalLayout {
                                    spacing: 12px;
                                    Path {
                                        width: 16px;
                                        height: 16px;
                                        commands: "M 2 8 L 6 12 L 14 3";
                                        stroke: AppTheme.success;
                                        stroke-width: 2px;
                                        fill: transparent;
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text { text: item.title; color: AppTheme.text-strong; font-size: TypeScale.body; font-weight: 600; wrap: word-wrap; }
                                        Text { text: item.desc; color: AppTheme.text-muted; font-size: TypeScale.small; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { AppTheme } from "../theme.slint";

export struct LinkItem {
    label: string,
    url: string,
}

export struct MessageBlock {
    text: string,
    is_link: bool,
    is_command: bool,
    is_emoji: bool,
    emoji_id: string,
    emoji_img: image,
    url: string,
    command_name: string,
}

export struct MessageLine {
    blocks: [MessageBlock],
}

export struct MessageAttachment {
    id: string,
    filename: string,
    url: string,
    proxy_url: string,
    size_str: string,
    width: int,
    height: int,
    is_image: bool,
    is_downloaded: bool,
    is_loading: bool,
    full_img: image,
    preview_img: image,
}

export struct MessageButton {
    label: string,
    url: string,
    emoji: string,
    emoji_id: string,
    emoji_img: image,
    style_type: int,
    is_disabled: bool,
}

export struct ChatMessage {
    id: string,
    author: string,
    timestamp: string,
    content: string,
    commands: [string],
    content_lines: [MessageLine],
    embed_content: string,
    embed_lines: [MessageLine],
    embed_color: color,
    embed_footer: string,
    code_block: string,
    reply_author: string,
    reply_content: string,
    reply_command: string,
    links: [LinkItem],
    buttons: [MessageButton],
    attachments: [MessageAttachment],
}

export component ChatMessagesView inherits Rectangle {
    in-out property <[ChatMessage]> messages;
    in-out property <bool> has_more_older_messages: false;
    in-out property <bool> is_loading_older_messages: false;
    in-out property <string> tr_replying_to: "Replying to ";
    in-out property <length> scroll_y: 0px;
    in-out property <int> scroll_trigger: 0;
    callback load_older_messages();
    callback open_link(string);
    callback download_attachment(string, string, string);
    callback click_command(string);

    changed scroll_trigger => {
        root.scroll_to_bottom();
    }

    public function scroll_to_bottom() {
        if (msg_scroll.viewport-height > msg_scroll.visible-height) {
            scroll_y = (msg_scroll.visible-height - msg_scroll.viewport-height);
        } else {
            scroll_y = 0px;
        }
    }

    msg_scroll := ScrollView {
        viewport-y <=> root.scroll_y;
        viewport-width: self.visible-width;
        height: 100%;
        width: 100%;

        VerticalLayout {
            width: 100%;
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 2px;
            alignment: end;

            // Load Older Messages Button / Header
            if root.has_more_older_messages: HorizontalLayout {
                alignment: center;
                padding-top: 2px;
                padding-bottom: 6px;

                Rectangle {
                    height: 28px;
                    background: older_btn_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: AppTheme.separator;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/arrow-up.svg");
                                width: 12px;
                                height: 12px;
                                colorize: AppTheme.accent;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.is_loading_older_messages ? "Carregando mensagens anteriores..." : "Carregar mensagens mais antigas";
                            color: AppTheme.accent;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    older_btn_touch := TouchArea {
                        enabled: !root.is_loading_older_messages;
                        clicked => { root.load_older_messages(); }
                    }
                }
            }

            for msg in root.messages: Rectangle {
                width: 100%;
                background: transparent;
                property <bool> is-collapsed: true;

                VerticalBox {
                    width: 100%;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;

                    if msg.reply-author != "" || msg.reply-command != "": Rectangle {
                        background: AppTheme.surface-reply;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: AppTheme.accent-bright;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: msg.reply-command != "" ? @image-url("../../assets/terminal.svg") : @image-url("../../assets/reply.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: AppTheme.accent-bright;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: msg.reply-command != "" ? msg.reply-author : (root.tr_replying_to + msg.reply-author);
                                    color: AppTheme.accent-link-hover;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                if msg.reply-command != "": Text {
                                    text: "usou";
                                    color: AppTheme.text-reply;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                if msg.reply-command != "": Rectangle {
                                    height: 18px;
                                    background: rep_cmd_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent-subtle;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: AppTheme.accent;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        spacing: 3px;
                                        alignment: center;
                                        Text {
                                            text: msg.reply-command;
                                            color: rep_cmd_ta.has-hover ? AppTheme.text-on-accent : AppTheme.accent-link-hover;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    rep_cmd_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.click_command(msg.reply-command); }
                                    }
                                }
                            }

                            if msg.reply-content != "": Text {
                                text: msg.reply-content;
                                color: AppTheme.text-reply;
                                font-size: 10.5px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        Text {
                            text: msg.author;
                            color: AppTheme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: msg.timestamp;
                            color: AppTheme.text-subtle;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }

                        if msg.links.length > 0 : Rectangle {
                            width: 20px;
                            height: 20px;
                            background: transparent;
                            Image {
                                source: is-collapsed ? @image-url("../../assets/chevron-down.svg") : @image-url("../../assets/chevron-up.svg");
                                width: 12px;
                                height: 12px;
                                colorize: AppTheme.text-muted;
                                image-fit: contain;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    is-collapsed = !is-collapsed;
                                }
                            }
                        }
                    }

                    // 1. Text Message Content (Rich lines with clickable blue links & command boxes, fallback to word-wrapped text)
                    if msg.content_lines.length > 0: VerticalLayout {
                        spacing: 3px;
                        for line in msg.content_lines: VerticalLayout {
                            spacing: 0px;

                            // Case 1: Pure single text line -> Native responsive word-wrap!
                            if line.blocks.length == 1 && !line.blocks[0].is_link && !line.blocks[0].is_command: Text {
                                text: line.blocks[0].text;
                                color: AppTheme.text-primary;
                                font-size: 13.5px;
                                wrap: word-wrap;
                            }

                            // Case 2: Standalone Link Line (e.g. [Song Title](url)) -> Blue link with icon & click
                            if line.blocks.length == 1 && line.blocks[0].is_link: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    background: block_ta_single.has-hover ? AppTheme.surface-reply : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 2px;
                                        padding-right: 2px;
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: line.blocks[0].text;
                                            color: block_ta_single.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                            font-size: 13.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            max-width: 450px;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../../assets/external-link.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: block_ta_single.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                    block_ta_single := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open_link(line.blocks[0].url); }
                                    }
                                }
                            }

                            // Case 3: Standalone Command Line (e.g. </play:123>) -> Blue command box with click
                            if line.blocks.length == 1 && line.blocks[0].is_command: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 20px;
                                    background: cmd_ta_single.has-hover ? AppTheme.accent-hover : AppTheme.accent-subtle;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: AppTheme.accent;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        spacing: 3px;
                                        alignment: center;
                                        Text {
                                            text: line.blocks[0].text;
                                            color: cmd_ta_single.has-hover ? AppTheme.text-on-accent : AppTheme.accent-link-hover;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    cmd_ta_single := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.click_command(line.blocks[0].command_name); }
                                    }
                                }
                            }

                            // Case 3.5: Standalone Emoji Line -> Jumbo Emoji (32x32)
                            if line.blocks.length == 1 && line.blocks[0].is_emoji: HorizontalLayout {
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: line.blocks[0].emoji_img;
                                        width: 32px;
                                        height: 32px;
                                        image-fit: contain;
                                    }
                                }
                            }

                            // Case 4: Mixed blocks line (e.g. "Listen here: [Click here](url)")
                            if line.blocks.length > 1: HorizontalLayout {
                                alignment: start;
                                spacing: 4px;

                                for block in line.blocks: HorizontalLayout {
                                    alignment: start;
                                    spacing: 0px;

                                    if block.is_command: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 20px;
                                            background: cmd_ta_mix.has-hover ? AppTheme.accent-hover : AppTheme.accent-subtle;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: AppTheme.accent;
                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                spacing: 3px;
                                                alignment: center;
                                                Text {
                                                    text: block.text;
                                                    color: cmd_ta_mix.has-hover ? AppTheme.text-on-accent : AppTheme.accent-link-hover;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            cmd_ta_mix := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.click_command(block.command_name); }
                                            }
                                        }
                                    }

                                    if block.is_emoji: VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: block.emoji_img;
                                            width: 22px;
                                            height: 22px;
                                            image-fit: contain;
                                        }
                                    }

                                    if block.is_link: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 22px;
                                            background: block_ta_mix.has-hover ? AppTheme.surface-reply : transparent;
                                            border-radius: 3px;
                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                spacing: 4px;
                                                alignment: center;
                                                Text {
                                                    text: block.text;
                                                    color: block_ta_mix.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    max-width: 380px;
                                                }
                                                Image {
                                                    source: @image-url("../../assets/external-link.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: block_ta_mix.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                    image-fit: contain;
                                                }
                                            }
                                            block_ta_mix := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_link(block.url); }
                                            }
                                        }
                                    }

                                    if !block.is_link && !block.is_command && !block.is_emoji: Text {
                                        text: block.text;
                                        color: AppTheme.text-primary;
                                        font-size: 13.5px;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        max-width: 480px;
                                    }
                                }
                            }
                        }
                    }

                    if msg.content_lines.length == 0 && msg.content != "": Text {
                        width: 100%;
                        text: msg.content;
                        color: AppTheme.text-primary;
                        font-size: 13.5px;
                        wrap: word-wrap;
                    }

                    // 2. Code Block
                    if msg.code-block != "": Rectangle {
                        width: 100%;
                        background: AppTheme.surface-input;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;

                        HorizontalLayout {
                            width: 100%;
                            padding: 8px;
                            Text {
                                width: 100%;
                                text: msg.code-block;
                                color: AppTheme.success;
                                font-family: "Courier New";
                                font-size: 12.5px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // 3. Embeds
                    if msg.embed-content != "" || msg.embed-footer != "": Rectangle {
                        width: 100%;
                        background: AppTheme.surface-elevated;
                        border-radius: 4px;

                        HorizontalLayout {
                            Rectangle {
                                width: 4px;
                                background: msg.embed_color;
                                border-top-left-radius: 4px;
                                border-bottom-left-radius: 4px;
                            }

                            VerticalLayout {
                                padding: 10px;
                                padding-left: 12px;
                                spacing: 8px;

                                if msg.embed_lines.length > 0: VerticalLayout {
                                    spacing: 3px;
                                    for line in msg.embed_lines: VerticalLayout {
                                        spacing: 0px;

                                        if line.blocks.length == 1 && !line.blocks[0].is_link && !line.blocks[0].is_command: Text {
                                            text: line.blocks[0].text;
                                            color: AppTheme.text-embed;
                                            font-size: 12.5px;
                                            wrap: word-wrap;
                                        }

                                        if line.blocks.length == 1 && line.blocks[0].is_link: HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                background: eblock_ta_single.has-hover ? AppTheme.surface-reply : transparent;
                                                border-radius: 3px;
                                                HorizontalLayout {
                                                    padding-left: 2px;
                                                    padding-right: 2px;
                                                    spacing: 4px;
                                                    alignment: start;
                                                    Text {
                                                        text: line.blocks[0].text;
                                                        color: eblock_ta_single.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                        font-size: 12.5px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        max-width: 450px;
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../../assets/external-link.svg");
                                                            width: 10px;
                                                            height: 10px;
                                                            colorize: eblock_ta_single.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                }
                                                eblock_ta_single := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open_link(line.blocks[0].url); }
                                                }
                                            }
                                        }

                                        if line.blocks.length == 1 && line.blocks[0].is_command: HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                height: 19px;
                                                background: ecmd_ta_single.has-hover ? AppTheme.accent-hover : AppTheme.accent-subtle;
                                                border-radius: 3px;
                                                border-width: 1px;
                                                border-color: AppTheme.accent;
                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    spacing: 3px;
                                                    alignment: center;
                                                    Text {
                                                        text: line.blocks[0].text;
                                                        color: ecmd_ta_single.has-hover ? AppTheme.text-on-accent : AppTheme.accent-link-hover;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                ecmd_ta_single := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.click_command(line.blocks[0].command_name); }
                                                }
                                            }
                                        }

                                        if line.blocks.length > 1: HorizontalLayout {
                                            alignment: start;
                                            spacing: 4px;

                                            for block in line.blocks: HorizontalLayout {
                                                alignment: start;
                                                spacing: 0px;

                                                if block.is_command: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 19px;
                                                        background: ecmd_ta_mix.has-hover ? AppTheme.accent-hover : AppTheme.accent-subtle;
                                                        border-radius: 3px;
                                                        border-width: 1px;
                                                        border-color: AppTheme.accent;
                                                        HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 5px;
                                                            spacing: 3px;
                                                            alignment: center;
                                                            Text {
                                                                text: block.text;
                                                                color: ecmd_ta_mix.has-hover ? AppTheme.text-on-accent : AppTheme.accent-link-hover;
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        ecmd_ta_mix := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.click_command(block.command_name); }
                                                        }
                                                    }
                                                }

                                                if block.is_link: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 20px;
                                                        background: eblock_ta_mix.has-hover ? AppTheme.surface-reply : transparent;
                                                        border-radius: 3px;
                                                        HorizontalLayout {
                                                            padding-left: 4px;
                                                            padding-right: 4px;
                                                            spacing: 4px;
                                                            alignment: center;
                                                            Text {
                                                                text: block.text;
                                                                color: eblock_ta_mix.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                                max-width: 350px;
                                                            }
                                                            Image {
                                                                source: @image-url("../../assets/external-link.svg");
                                                                width: 10px;
                                                                height: 10px;
                                                                colorize: eblock_ta_mix.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        eblock_ta_mix := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.open_link(block.url); }
                                                        }
                                                    }
                                                }

                                                if block.is_emoji: VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: block.emoji_img;
                                                        width: 18px;
                                                        height: 18px;
                                                        image-fit: contain;
                                                    }
                                                }

                                                if !block.is_link && !block.is_command && !block.is_emoji: Text {
                                                    text: block.text;
                                                    color: AppTheme.text-embed;
                                                    font-size: 12.5px;
                                                    vertical-alignment: center;
                                                    wrap: word-wrap;
                                                    max-width: 420px;
                                                }
                                            }
                                        }
                                    }
                                }

                                if msg.embed_lines.length == 0 && msg.embed-content != "": Text {
                                    width: 100%;
                                    text: msg.embed-content;
                                    color: AppTheme.text-embed;
                                    font-size: 12.5px;
                                    wrap: word-wrap;
                                }

                                if msg.embed-footer != "": Rectangle {
                                    height: 1px;
                                    background: AppTheme.separator;
                                }

                                if msg.embed-footer != "": Text {
                                    width: 100%;
                                    text: msg.embed-footer;
                                    color: AppTheme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if msg.buttons.length > 0: HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 2px;
                        alignment: start;

                        for btn in msg.buttons: Rectangle {
                            height: 32px;
                            background: btn.is_disabled ? AppTheme.surface-disabled : (btn_ta.has-hover ? (
                                btn.style_type == 1 ? AppTheme.accent-hover : (
                                btn.style_type == 3 ? AppTheme.success-hover : (
                                btn.style_type == 4 ? AppTheme.danger-action-hover : (
                                AppTheme.surface-control-hover
                                )))
                            ) : (
                                btn.style_type == 1 ? AppTheme.accent : (
                                btn.style_type == 3 ? AppTheme.success : (
                                btn.style_type == 4 ? AppTheme.danger-action : (
                                btn.style_type == 5 ? AppTheme.interactive-hover : (
                                AppTheme.surface-control
                                ))))
                            ));
                            border-radius: 4px;
                            border-width: btn.style_type == 5 ? 1px : 0px;
                            border-color: AppTheme.separator;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                if btn.emoji-img.width > 0 : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: btn.emoji-img;
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                    }
                                }

                                if btn.emoji != "" && btn.emoji-img.width == 0 : VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: btn.emoji;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: btn.label;
                                    color: btn.is_disabled ? AppTheme.text-subtle : AppTheme.text-on-accent;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                if btn.url != "": VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/external-link.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: btn.is_disabled ? AppTheme.text-subtle : AppTheme.text-secondary;
                                        image-fit: contain;
                                    }
                                }
                            }

                            btn_ta := TouchArea {
                                enabled: !btn.is_disabled && btn.url != "";
                                mouse-cursor: btn.url != "" ? pointer : default;
                                clicked => {
                                    if btn.url != "" {
                                        root.open_link(btn.url);
                                    }
                                }
                            }
                        }
                    }

                    if msg.attachments.length > 0 : VerticalLayout {
                        spacing: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: start;

                        for att in msg.attachments : Rectangle {
                            property <length> img-height: (att.width > 0 && att.height > 0) ? min(520px, max(120px, 320px * att.height / att.width)) : 200px;
                            width: att.is_image ? 320px : 280px;
                            height: att.is_image ? img-height : 48px;
                            background: AppTheme.surface-input;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: AppTheme.surface-sidebar;
                            clip: true;

                            // 1. Downloaded Full Crisp Image (Clean & Raw)
                            if att.is_image && att.is_downloaded : Image {
                                width: 100%;
                                height: 100%;
                                source: att.full_img;
                                image-fit: contain;
                            }

                            // 2. Low-res pixelated / blurred preview thumbnail
                            if att.is_image && !att.is_downloaded : Image {
                                width: 100%;
                                height: 100%;
                                source: att.preview_img;
                                image-fit: cover;
                            }

                            // 3. Darkened overlay for preview state
                            if att.is_image && !att.is_downloaded : Rectangle {
                                width: 100%;
                                height: 100%;
                                background: AppTheme.surface-backdrop;
                            }

                            // 4. Rounded Rectangle Download Button in the center (when not downloaded)
                            if att.is_image && !att.is_downloaded : VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 38px;
                                        background: dl_ta.has-hover ? AppTheme.accent-hover : AppTheme.media-action-background;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: AppTheme.accent;

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../../assets/arrow-down.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: AppTheme.text-on-accent;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: att.is_loading ? "Baixando..." : (att.size_str != "" ? ("Baixar Imagem (" + att.size_str + ")") : "Baixar Imagem");
                                                    color: AppTheme.text-on-accent;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        dl_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if (!att.is_loading) {
                                                    root.download_attachment(att.id, att.filename, att.url);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 5. Non-image attachment card (e.g. zip, pdf)
                            if !att.is_image : HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: center;

                                Image {
                                    source: @image-url("../../assets/external-link.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: AppTheme.text-muted;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: att.filename;
                                    color: AppTheme.accent-link-hover;
                                    font-size: 13px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: att.size_str;
                                    color: AppTheme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                non_img_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open_link(att.url); }
                                }
                            }
                        }
                    }

                    if msg.links.length > 0 && !is-collapsed : VerticalLayout {
                        spacing: 4px;
                        padding-top: 4px;
                        for link in msg.links : Rectangle {
                            height: 24px;
                            background: link_ta.has-hover ? AppTheme.surface-reply : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../../assets/external-link.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: link_ta.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: link.label;
                                    color: link_ta.has-hover ? AppTheme.accent-link-hover : AppTheme.link;
                                    vertical-alignment: center;
                                    font-size: 12.5px;
                                    font-weight: 500;
                                }
                            }
                            link_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open_link(link.url);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

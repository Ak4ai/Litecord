import { Tr } from "components/tr.slint";
export { Tr }
import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView, TextEdit, CheckBox, Slider } from "std-widgets.slint";
import { AppTheme, ChatTypography, ThemeMode , TypeScale } from "theme.slint";
import "../assets/fonts/Inter-Variable.ttf";

import { IconButton } from "components/icon_button.slint";
import { ChannelSidebar, ChannelItem } from "components/channel_sidebar.slint";
import { SettingsView, LanguageItem, SettingOptionItem, AudioDeviceItem } from "components/settings_view.slint";
import { OnboardingView, OnboardingPromptItem, OnboardingOptionItem } from "components/onboarding_view.slint";
import { ChatMessagesView, LinkItem, MessageBlock, MessageLine, MessageAttachment, MessageButton, ChatMessage } from "components/chat_messages_view.slint";

struct CommandSuggestion {
    name: string,
    desc: string,
    usage: string,
    app_id: string,
    app_name: string,
    cmd_id: string,
    version: string,
    param_name: string,
    param_desc: string,
    is_required: bool,
}

struct GuildItem {
    id: string,
    name: string,
    icon: string,
    has_image: bool,
    icon_image: image,
}

struct VoiceParticipant {
    user_id: string,
    username: string,
    avatar_text: string,
    avatar_url: string,
    avatar_img: image,
    is_speaking: bool,
    audio_level: float,
    is_muted: bool,
    volume: float,
    priority: int,
    is_self: bool,
    is_streaming: bool,
    is_stream_hidden: bool,
}

export struct ScreenSourceItem {
    id: int,
    name: string,
    resolution: string,
    is_primary: bool,
}

export struct WindowSourceItem {
    id: string,
    title: string,
    app_name: string,
    has_icon: bool,
    icon_image: image,
}

export struct CameraSourceItem {
    id: string,
    name: string,
}

export struct AccountItem {
    id: string,
    username: string,
    tag: string,
    avatar_initials: string,
    is_active: bool,
}


export component AppWindow inherits Window {
    title: "Litecord - Ultra-Lightweight Discord Client";
    icon: @image-url("../assets/app_icon.png");
    no-frame: true;
    preferred-width: 980px;
    preferred-height: 620px;
    min-width: 680px;
    min-height: 480px;
    background: AppTheme.surface-window;
    default-font-family: TypeScale.family;

    // Public bridge for the backend/settings layer. Theme persistence and the
    // visible selector can bind to this property without knowing token details.
    in-out property <bool> use-light-theme: false;
    changed use-light-theme => {
        AppTheme.mode = use-light-theme ? ThemeMode.light : ThemeMode.dark;
    }

    // Callbacks to Rust backend
    callback drag_window();
    callback minimize_window();
    callback maximize_window();
    callback close_window();
    callback login(string /* token */);
    callback send_message(string /* content */);
    callback select_channel(string /* channel_id */);
    callback toggle_category(string /* category_id */);
    callback select_guild(string /* guild_id */);
    callback toggle_mute();
    callback toggle_deafen();
    callback leave_voice();
    callback call_dm();    // Inicia chamada de voz em DM (ring + OP4)
    callback hangup_dm();  // Encerra chamada de voz em DM (stop-ringing + OP4 null)
    callback accept_call();  // Aceita chamada DM recebida
    callback reject_call();  // Recusa chamada DM recebida
    callback minimize_to_tray();
    callback open_settings();
    callback close_settings();
    callback select_input_device(string /* device_name */);
    callback select_output_device(string /* device_name */);
    callback start_recording_keybind(int /* 1 = mute, 2 = deafen */);
    callback reset_keybind(int /* 1 = mute, 2 = deafen */);
    callback set_custom_keybind(int /* 1 = mute, 2 = deafen */, string /* shortcut */);
    callback auto_detect_token();
    callback toggle_user_mute(string /* user_id */);
    callback set_user_volume(string /* user_id */, float /* volume */);
    callback set_user_priority(string /* user_id */, int /* priority */);
    callback toggle_voice_focus();
    callback open_link(string /* url */);
    callback download_attachment(string /* att_id */, string /* filename */, string /* url */);
    callback set_vad_threshold(float /* threshold */);
    callback set_mic_volume(float /* volume */);
    callback toggle_test_mic();
    callback logout();
    callback switch_account(string /* account_id */);
    callback add_new_account();
    callback remove_account(string /* account_id */);
    callback change_language(string /* "auto", "en", "pt" */);
    callback refresh_qr_code();
    callback drag_resize(string /* "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right" */);
    callback update_app_accept();
    callback update_app_dismiss();
    callback update_app_ignore();
    callback check_for_updates();
    callback reorder_guild(int, int);
    callback reorder_channel(int, int);
    // Row a channel dragged from row `from` by `dy` would land on (rows differ in height).
    pure callback channel_drop_row(int, length) -> int;
    in-out property <int> dragging_guild_idx: -1;
    in-out property <int> drop_target_guild_idx: -1;
    callback load_older_messages();
    callback toggle_screen_share();
    callback toggle_web_share();
    callback copy_web_share_link();
    callback toggle_stream_fullscreen();
    callback focus_stream(string /* user_id */);
    callback start_stream(int /* monitor_id */, string /* resolution */, int /* fps */);
    callback stop_stream();
    callback open_stream_modal();
    callback close_stream_modal();
    callback onboarding_toggle(int /* prompt */, int /* option */);
    callback onboarding_submit();
    callback onboarding_dismiss();
    callback popout_stream_window(string /* user_id */, string /* username */);
    callback close_popout_window();
    callback hide_stream(string /* user_id */);
    callback unhide_stream(string /* user_id */);
    callback launch_stream_browser();
    callback click_command(string /* command_name */);
    callback handle_input_change(string /* text */);
    callback execute_active_command(string /* cmd_name */, string /* arg_value */, string /* app_id */, string /* cmd_id */, string /* version */, string /* param_name */);

    in-out property <bool> is_linux: false;
    in-out property <bool> drag_area_enabled: true;

    // Smart Command Autocomplete & Parameter Properties
    in-out property <string> chat_input_text: "";
    in-out property <bool> show_command_suggestions: false;
    in-out property <int> active_suggestion_index: 0;
    in-out property <string> active_command_name: "";
    in-out property <string> active_param_name: "";
    in-out property <string> active_param_desc: "";
    in-out property <string> active_command_app_id: "";
    in-out property <string> active_command_cmd_id: "";
    in-out property <string> active_command_version: "";
    in-out property <string> command_arg_text: "";
    in-out property <[CommandSuggestion]> command_suggestions: [
        { name: "/play", desc: Tr.cmd_play_desc, usage: Tr.cmd_play_usage, app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "query", param_desc: Tr.cmd_play_param, is_required: true },
        { name: "/skip", desc: Tr.cmd_skip_desc, usage: "/skip", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/stop", desc: Tr.cmd_stop_desc, usage: "/stop", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/pause", desc: Tr.cmd_pause_desc, usage: "/pause", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/resume", desc: Tr.cmd_resume_desc, usage: "/resume", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/queue", desc: Tr.cmd_queue_desc, usage: "/queue", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/nowplaying", desc: Tr.cmd_nowplaying_desc, usage: "/nowplaying", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/volume", desc: Tr.cmd_volume_desc, usage: "/volume <1-100>", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "level", param_desc: Tr.cmd_volume_param, is_required: true },
        { name: "/loop", desc: Tr.cmd_loop_desc, usage: "/loop", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "mode", param_desc: Tr.cmd_loop_param, is_required: false },
        { name: "/shuffle", desc: Tr.cmd_shuffle_desc, usage: "/shuffle", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/lyrics", desc: Tr.cmd_lyrics_desc, usage: "/lyrics", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "song", param_desc: Tr.cmd_lyrics_param, is_required: false },
        { name: "/247", desc: Tr.cmd_247_desc, usage: "/247", app_id: "", app_name: Tr.app_music, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/help", desc: Tr.cmd_help_desc, usage: "/help", app_id: "", app_name: "Bot", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/ping", desc: Tr.cmd_ping_desc, usage: "/ping", app_id: "", app_name: "Bot", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/clear", desc: Tr.cmd_clear_desc, usage: Tr.cmd_clear_usage, app_id: "", app_name: Tr.app_moderation, cmd_id: "", version: "", param_name: "amount", param_desc: Tr.cmd_clear_param, is_required: true },
        { name: "/avatar", desc: Tr.cmd_avatar_desc, usage: Tr.cmd_avatar_usage, app_id: "", app_name: Tr.app_utility, cmd_id: "", version: "", param_name: "user", param_desc: Tr.cmd_user_param, is_required: false },
        { name: "/userinfo", desc: Tr.cmd_userinfo_desc, usage: Tr.cmd_userinfo_usage, app_id: "", app_name: Tr.app_utility, cmd_id: "", version: "", param_name: "user", param_desc: Tr.cmd_user_param, is_required: false },
        { name: "/serverinfo", desc: Tr.cmd_serverinfo_desc, usage: "/serverinfo", app_id: "", app_name: Tr.app_utility, cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false }
    ];

    // Auto-Update Properties
    in-out property <bool> show_update_dialog: false;
    in-out property <string> update_version: "";
    in-out property <string> update_release_name: "";
    in-out property <bool> is_updating: false;
    in-out property <float> update_progress: 0.0;
    in-out property <string> update_status_text: Tr.update_downloading;
    in-out property <string> app_version: "v0.2.5";
    in-out property <string> update_check_feedback: "";
    in-out property <bool> is_checking_update: false;

    // Chat Pagination Properties
    in-out property <bool> is_loading_older_messages: false;
    in-out property <bool> has_more_older_messages: false;
    in-out property <int> scroll_to_bottom_trigger: 0;

    public function scroll_chat_to_bottom() {
        root.scroll_to_bottom_trigger += 1;
    }

    changed is_voice_focused => {
        if (!root.is_voice_focused) {
            root.scroll_chat_to_bottom();
        }
    }

    changed active_channel_id => {
        root.scroll_chat_to_bottom();
    }

    public function move_suggestion_up() {
        if (root.command_suggestions.length > 0) {
            if (root.active_suggestion_index > 0) {
                root.active_suggestion_index -= 1;
            } else {
                root.active_suggestion_index = root.command_suggestions.length - 1;
            }
        }
    }

    public function move_suggestion_down() {
        if (root.command_suggestions.length > 0) {
            if (root.active_suggestion_index < root.command_suggestions.length - 1) {
                root.active_suggestion_index += 1;
            } else {
                root.active_suggestion_index = 0;
            }
        }
    }

    public function select_suggestion(idx: int) {
        if (idx >= 0 && idx < root.command_suggestions.length) {
            root.active_command_name = root.command_suggestions[idx].name;
            root.active_param_name = root.command_suggestions[idx].param_name;
            root.active_param_desc = root.command_suggestions[idx].param_desc != "" ? root.command_suggestions[idx].param_desc : (root.command_suggestions[idx].param_name != "" ? root.command_suggestions[idx].desc : Tr.press_enter_run + root.command_suggestions[idx].name);
            root.active_command_app_id = root.command_suggestions[idx].app_id;
            root.active_command_cmd_id = root.command_suggestions[idx].cmd_id;
            root.active_command_version = root.command_suggestions[idx].version;
            root.command_arg_text = "";
            root.chat_input_text = "";
            root.show_command_suggestions = false;
        }
    }

    // Translations (i18n)
    in-out property <string> current_language_code: "auto";
    in-out property <string> tr_login_title: "Sign in to Litecord";
    in-out property <string> tr_login_desc: "Enter your Discord User Token for direct connection to Gateway v9.\n(Estimated RAM usage ~15MB)";
    in-out property <string> tr_login_placeholder: "Paste your Discord User Token here...";
    in-out property <string> tr_login_btn_connect: "Connect to Gateway";
    in-out property <string> tr_login_btn_detect: "Detect Discord Token";
    in-out property <string> tr_server_channels: "SERVER CHANNELS";
    in-out property <string> tr_leave: "Leave";
    in-out property <string> tr_view_text_chat: "View Text Chat";
    in-out property <string> tr_leave_call: "Disconnect Call";
    in-out property <string> tr_voice_participants_title: "VOICE ROOM PARTICIPANTS";
    in-out property <string> tr_badge_you: "YOU";
    in-out property <string> tr_view_voice_room: "View Voice Room";
    in-out property <string> tr_replying_to: "Replying to @";
    in-out property <string> tr_chat_placeholder_prefix: "Message ";
    in-out property <string> tr_send: "Send";
    in-out property <string> tr_settings_title: "Voice & Audio Settings";
    in-out property <string> tr_settings_language_label: "LANGUAGE / IDIOMA";
    in-out property <string> tr_settings_input_device: "INPUT DEVICE (MICROPHONE)";
    in-out property <string> tr_settings_output_device: "OUTPUT DEVICE (SPEAKERS / HEADPHONES)";
    in-out property <string> tr_settings_threshold: "VOICE DETECTION SENSITIVITY (THRESHOLD)";
    in-out property <string> tr_settings_mic_level: "REAL-TIME MICROPHONE LEVEL";
    in-out property <string> tr_settings_btn_test_start: "Test Microphone (\"Hear Yourself\")";
    in-out property <string> tr_settings_btn_test_stop: "Stop Testing (Listening...)";
    in-out property <string> tr_settings_done: "Done";
    in-out property <string> tr_logout_title: "Sign Out";
    in-out property <string> tr_logout_confirm_prefix: "Do you want to log out from ";
    in-out property <string> tr_cancel: "Cancel";
    in-out property <string> tr_confirm_logout: "Sign Out";
    in-out property <string> tr_voice_connecting: "Connecting...";
    in-out property <string> tr_voice_connecting_title: "Connecting to Voice Channel...";
    in-out property <string> tr_voice_connecting_desc: "Authenticating with Voice Gateway v9 and negotiating DAVE E2EE encryption...";
    in-out property <string> tr_voice_connected: "Voice Connected";
    in-out property <string> tr_qr_title: "Log in with QR Code";
    in-out property <string> tr_qr_desc: "Scan this with the Discord mobile app to log in instantly.";
    in-out property <string> tr_qr_confirm: "Approve login on your phone!";
    in-out property <string> tr_settings_tab_voice: "Voice & Audio";
    in-out property <string> tr_settings_tab_language: "Language";
    in-out property <string> tr_settings_tab_keybinds: "Keybinds";
    in-out property <string> tr_settings_tab_video_interface: Tr.settings_tab_video;
    in-out property <string> tr_settings_tab_security: "Security & E2EE";
    in-out property <string> tr_settings_tab_network_proxy: "Network & Proxy";
    in-out property <string> tr_settings_tab_updates: "Updates & About";
    in-out property <string> tr_keybind_mute_title: "Toggle Mute";
    in-out property <string> tr_keybind_mute_desc: "Global shortcut to mute or unmute your microphone during voice calls.";
    in-out property <string> tr_keybind_deafen_title: "Toggle Deafen";
    in-out property <string> tr_keybind_deafen_desc: "Global shortcut to deafen or undeafen all voice audio and microphone.";
    in-out property <string> tr_keybind_recording_prompt: "Press desired key combination...";
    in-out property <string> tr_keybind_btn_record: "Record Keybind";
    in-out property <string> tr_keybind_btn_clear: "Disable";
    in-out property <string> tr_keybind_guide_title: "Global Shortcuts";
    in-out property <string> tr_keybind_guide_desc: "Keybinds work seamlessly across all applications and games, even when Litecord is in background.";
    in-out property <string> keybind_mute_str: "Ctrl+Shift+M";
    in-out property <string> keybind_deafen_str: "Ctrl+Shift+D";
    in-out property <int> recording_keybind_for: 0;

    // Video & Interface Settings Properties
    in-out property <string> selected_video_encoder: "auto";
    in-out property <bool> gpu_selection_available: false;
    in-out property <string> stream_capture_status;
    in-out property <string> selected_video_capture_backend: "auto";
    in-out property <string> selected_audio_loopback_backend: "auto";
    in-out property <bool> enable_self_preview_notice: true;
    in-out property <bool> show_hardware_monitor: true;
    in-out property <bool> use_gpu_renderer: false;
    in-out property <bool> net_diag_running: false;
    in-out property <int> net_diag_verdict: -1;
    in-out property <bool> net_diag_signaling_ok: true;
    in-out property <bool> net_diag_copied: false;
    in-out property <string> hardware_cpu_text: "CPU --%";
    in-out property <string> hardware_ram_text: "RAM -- MB";
    in-out property <string> hardware_gpu_text: "GPU --%";
    in-out property <int> hardware_cpu_val: 0;
    in-out property <int> hardware_ram_val: 0;
    in-out property <int> hardware_gpu_val: 0;

    in-out property <[SettingOptionItem]> video_encoder_options: [];
    in-out property <[SettingOptionItem]> video_capture_options: [];
    in-out property <[SettingOptionItem]> audio_loopback_options: [];
    in-out property <[SettingOptionItem]> noise_suppression_options: [];
    in-out property <bool> echo_cancellation: false;
    in-out property <bool> automatic_gain_control: false;

    callback select_video_encoder(string);
    callback select_video_capture_backend(string);
    callback select_audio_loopback_backend(string);
    callback toggle_enable_self_preview_notice();
    callback toggle_hardware_monitor();
    callback toggle_gpu_renderer();
    in-out property <length> channel_sidebar_width: 230px;
    callback channel_sidebar_width_committed(length);
    callback run_network_diagnostics();

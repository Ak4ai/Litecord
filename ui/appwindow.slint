import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView, TextEdit, CheckBox, Slider } from "std-widgets.slint";

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: #dbdee1;
    in property <color> hover-color: #35373c;
    callback clicked();

    width: 32px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? hover-color : #0000;

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: root.icon-color;
        image-fit: contain;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

struct LinkItem {
    label: string,
    url: string,
}

struct CommandSuggestion {
    name: string,
    desc: string,
    usage: string,
    app_id: string,
    app_name: string,
    cmd_id: string,
    version: string,
    param_name: string,
    param_desc: string,
    is_required: bool,
}

struct MessageBlock {
    text: string,
    is_link: bool,
    is_command: bool,
    is_emoji: bool,
    emoji_id: string,
    emoji_img: image,
    url: string,
    command_name: string,
}

struct MessageLine {
    blocks: [MessageBlock],
}

struct MessageAttachment {
    id: string,
    filename: string,
    url: string,
    proxy_url: string,
    size_str: string,
    width: int,
    height: int,
    is_image: bool,
    is_downloaded: bool,
    is_loading: bool,
    full_img: image,
    preview_img: image,
}

struct MessageButton {
    label: string,
    url: string,
    emoji: string,
    emoji_id: string,
    emoji_img: image,
    style_type: int,
    is_disabled: bool,
}

struct ChatMessage {
    id: string,
    author: string,
    timestamp: string,
    content: string,
    commands: [string],
    content_lines: [MessageLine],
    embed_content: string,
    embed_lines: [MessageLine],
    embed_color: color,
    embed_footer: string,
    code_block: string,
    reply_author: string,
    reply_content: string,
    reply_command: string,
    links: [LinkItem],
    buttons: [MessageButton],
    attachments: [MessageAttachment],
}

struct ChannelItem {
    id: string,
    name: string,
    is_voice: bool,
    voice_count: int,
}

struct GuildItem {
    id: string,
    name: string,
    icon: string,
    has_image: bool,
    icon_image: image,
}

struct LanguageItem {
    code: string,
    name: string,
    native_name: string,
    is_selected: bool,
}

struct AudioDeviceItem {
    id: string,
    name: string,
    is_selected: bool,
}

struct VoiceParticipant {
    user_id: string,
    username: string,
    avatar_text: string,
    is_speaking: bool,
    audio_level: float,
    is_muted: bool,
    volume: float,
    priority: int,
    is_self: bool,
    is_streaming: bool,
    is_stream_hidden: bool,
}

export struct ScreenSourceItem {
    id: int,
    name: string,
    resolution: string,
    is_primary: bool,
}

export struct WindowSourceItem {
    id: string,
    title: string,
    app_name: string,
    has_icon: bool,
    icon_image: image,
}

export struct CameraSourceItem {
    id: string,
    name: string,
}

component ChatMessagesView inherits Rectangle {
    in-out property <[ChatMessage]> messages;
    in-out property <bool> has_more_older_messages: false;
    in-out property <bool> is_loading_older_messages: false;
    in-out property <string> tr_replying_to: "Replying to ";
    in-out property <length> scroll_y: 0px;
    in-out property <int> scroll_trigger: 0;
    callback load_older_messages();
    callback open_link(string);
    callback download_attachment(string, string, string);
    callback click_command(string);

    changed scroll_trigger => {
        root.scroll_to_bottom();
    }

    public function scroll_to_bottom() {
        scroll_y = Math.min(0.0, (msg_scroll.visible-height - msg_scroll.viewport-height) / 1px) * 1px;
    }

    msg_scroll := ScrollView {
        viewport-y <=> root.scroll_y;
        viewport-width: self.visible-width;
        height: 100%;
        width: 100%;

        VerticalLayout {
            width: 100%;
            padding: 12px;
            spacing: 10px;
            alignment: end;

            // Load Older Messages Button / Header
            if root.has_more_older_messages: HorizontalLayout {
                alignment: center;
                padding-top: 2px;
                padding-bottom: 6px;

                Rectangle {
                    height: 28px;
                    background: older_btn_touch.has-hover ? #35373c : #2b2d31;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #3f4147;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/arrow-up.svg");
                                width: 12px;
                                height: 12px;
                                colorize: #5865f2;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.is_loading_older_messages ? "Carregando mensagens anteriores..." : "Carregar mensagens mais antigas";
                            color: #5865f2;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    older_btn_touch := TouchArea {
                        enabled: !root.is_loading_older_messages;
                        clicked => { root.load_older_messages(); }
                    }
                }
            }

            for msg in root.messages: Rectangle {
                width: 100%;
                background: #2b2d31;
                border-radius: 6px;
                property <bool> is-collapsed: true;

                VerticalBox {
                    width: 100%;
                    padding: 8px;
                    spacing: 4px;

                    if msg.reply-author != "" || msg.reply-command != "": Rectangle {
                        background: #1e293b;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3b82f6;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: msg.reply-command != "" ? @image-url("../assets/terminal.svg") : @image-url("../assets/reply.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: #3b82f6;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: msg.reply-command != "" ? msg.reply-author : (root.tr_replying_to + msg.reply-author);
                                    color: #58a6ff;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                if msg.reply-command != "": Text {
                                    text: "usou";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                if msg.reply-command != "": Rectangle {
                                    height: 18px;
                                    background: rep_cmd_ta.has-hover ? #4752c4 : #5865f233;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: #5865f2;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        spacing: 3px;
                                        alignment: center;
                                        Text {
                                            text: msg.reply-command;
                                            color: rep_cmd_ta.has-hover ? #ffffff : #58a6ff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    rep_cmd_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.click_command(msg.reply-command); }
                                    }
                                }
                            }

                            if msg.reply-content != "": Text {
                                text: msg.reply-content;
                                color: #94a3b8;
                                font-size: 10.5px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        Text {
                            text: msg.author;
                            color: #5865f2;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: msg.timestamp;
                            color: #80848e;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }

                        if msg.links.length > 0 : Rectangle {
                            width: 20px;
                            height: 20px;
                            background: transparent;
                            Text {
                                text: is-collapsed ? "▼" : "▲";
                                color: #949ba4;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    is-collapsed = !is-collapsed;
                                }
                            }
                        }
                    }

                    // 1. Text Message Content (Rich lines with clickable blue links & command boxes, fallback to word-wrapped text)
                    if msg.content_lines.length > 0: VerticalLayout {
                        spacing: 3px;
                        for line in msg.content_lines: VerticalLayout {
                            spacing: 0px;

                            // Case 1: Pure single text line -> Native responsive word-wrap!
                            if line.blocks.length == 1 && !line.blocks[0].is_link && !line.blocks[0].is_command: Text {
                                text: line.blocks[0].text;
                                color: #dbdee1;
                                font-size: 13.5px;
                                wrap: word-wrap;
                            }

                            // Case 2: Standalone Link Line (e.g. [Song Title](url)) -> Blue link with icon & click
                            if line.blocks.length == 1 && line.blocks[0].is_link: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    background: block_ta_single.has-hover ? #1e293b : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 2px;
                                        padding-right: 2px;
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: line.blocks[0].text;
                                            color: block_ta_single.has-hover ? #58a6ff : #00a8fc;
                                            font-size: 13.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            max-width: 450px;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/external-link.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: block_ta_single.has-hover ? #58a6ff : #00a8fc;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                    block_ta_single := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open_link(line.blocks[0].url); }
                                    }
                                }
                            }

                            // Case 3: Standalone Command Line (e.g. </play:123>) -> Blue command box with click
                            if line.blocks.length == 1 && line.blocks[0].is_command: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 20px;
                                    background: cmd_ta_single.has-hover ? #4752c4 : #5865f233;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: #5865f2;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        spacing: 3px;
                                        alignment: center;
                                        Text {
                                            text: line.blocks[0].text;
                                            color: cmd_ta_single.has-hover ? #ffffff : #58a6ff;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    cmd_ta_single := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.click_command(line.blocks[0].command_name); }
                                    }
                                }
                            }

                            // Case 3.5: Standalone Emoji Line -> Jumbo Emoji (32x32)
                            if line.blocks.length == 1 && line.blocks[0].is_emoji: HorizontalLayout {
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: line.blocks[0].emoji_img;
                                        width: 32px;
                                        height: 32px;
                                        image-fit: contain;
                                    }
                                }
                            }

                            // Case 4: Mixed blocks line (e.g. "Listen here: [Click here](url)")
                            if line.blocks.length > 1: HorizontalLayout {
                                alignment: start;
                                spacing: 4px;

                                for block in line.blocks: HorizontalLayout {
                                    alignment: start;
                                    spacing: 0px;

                                    if block.is_command: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 20px;
                                            background: cmd_ta_mix.has-hover ? #4752c4 : #5865f233;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: #5865f2;
                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                spacing: 3px;
                                                alignment: center;
                                                Text {
                                                    text: block.text;
                                                    color: cmd_ta_mix.has-hover ? #ffffff : #58a6ff;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            cmd_ta_mix := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.click_command(block.command_name); }
                                            }
                                        }
                                    }

                                    if block.is_emoji: VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: block.emoji_img;
                                            width: 22px;
                                            height: 22px;
                                            image-fit: contain;
                                        }
                                    }

                                    if block.is_link: VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 22px;
                                            background: block_ta_mix.has-hover ? #1e293b : transparent;
                                            border-radius: 3px;
                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                spacing: 4px;
                                                alignment: center;
                                                Text {
                                                    text: block.text;
                                                    color: block_ta_mix.has-hover ? #58a6ff : #00a8fc;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    max-width: 380px;
                                                }
                                                Image {
                                                    source: @image-url("../assets/external-link.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    colorize: block_ta_mix.has-hover ? #58a6ff : #00a8fc;
                                                    image-fit: contain;
                                                }
                                            }
                                            block_ta_mix := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_link(block.url); }
                                            }
                                        }
                                    }

                                    if !block.is_link && !block.is_command && !block.is_emoji: Text {
                                        text: block.text;
                                        color: #dbdee1;
                                        font-size: 13.5px;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        max-width: 480px;
                                    }
                                }
                            }
                        }
                    }

                    if msg.content_lines.length == 0 && msg.content != "": Text {
                        width: 100%;
                        text: msg.content;
                        color: #dbdee1;
                        font-size: 13.5px;
                        wrap: word-wrap;
                    }

                    // 2. Code Block
                    if msg.code-block != "": Rectangle {
                        width: 100%;
                        background: #1e1f22;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #383a40;

                        HorizontalLayout {
                            width: 100%;
                            padding: 8px;
                            Text {
                                width: 100%;
                                text: msg.code-block;
                                color: #23a55a;
                                font-family: "Courier New";
                                font-size: 12.5px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // 3. Embeds
                    if msg.embed-content != "" || msg.embed-footer != "": Rectangle {
                        width: 100%;
                        background: #232428;
                        border-radius: 4px;

                        HorizontalLayout {
                            Rectangle {
                                width: 4px;
                                background: msg.embed_color;
                                border-top-left-radius: 4px;
                                border-bottom-left-radius: 4px;
                            }

                            VerticalLayout {
                                padding: 10px;
                                padding-left: 12px;
                                spacing: 8px;

                                if msg.embed_lines.length > 0: VerticalLayout {
                                    spacing: 3px;
                                    for line in msg.embed_lines: VerticalLayout {
                                        spacing: 0px;

                                        if line.blocks.length == 1 && !line.blocks[0].is_link && !line.blocks[0].is_command: Text {
                                            text: line.blocks[0].text;
                                            color: #d2d5d9;
                                            font-size: 12.5px;
                                            wrap: word-wrap;
                                        }

                                        if line.blocks.length == 1 && line.blocks[0].is_link: HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                background: eblock_ta_single.has-hover ? #1e293b : transparent;
                                                border-radius: 3px;
                                                HorizontalLayout {
                                                    padding-left: 2px;
                                                    padding-right: 2px;
                                                    spacing: 4px;
                                                    alignment: start;
                                                    Text {
                                                        text: line.blocks[0].text;
                                                        color: eblock_ta_single.has-hover ? #58a6ff : #00a8fc;
                                                        font-size: 12.5px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        max-width: 450px;
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/external-link.svg");
                                                            width: 10px;
                                                            height: 10px;
                                                            colorize: eblock_ta_single.has-hover ? #58a6ff : #00a8fc;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                }
                                                eblock_ta_single := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open_link(line.blocks[0].url); }
                                                }
                                            }
                                        }

                                        if line.blocks.length == 1 && line.blocks[0].is_command: HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                height: 19px;
                                                background: ecmd_ta_single.has-hover ? #4752c4 : #5865f233;
                                                border-radius: 3px;
                                                border-width: 1px;
                                                border-color: #5865f2;
                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    spacing: 3px;
                                                    alignment: center;
                                                    Text {
                                                        text: line.blocks[0].text;
                                                        color: ecmd_ta_single.has-hover ? #ffffff : #58a6ff;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                ecmd_ta_single := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.click_command(line.blocks[0].command_name); }
                                                }
                                            }
                                        }

                                        if line.blocks.length > 1: HorizontalLayout {
                                            alignment: start;
                                            spacing: 4px;

                                            for block in line.blocks: HorizontalLayout {
                                                alignment: start;
                                                spacing: 0px;

                                                if block.is_command: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 19px;
                                                        background: ecmd_ta_mix.has-hover ? #4752c4 : #5865f233;
                                                        border-radius: 3px;
                                                        border-width: 1px;
                                                        border-color: #5865f2;
                                                        HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 5px;
                                                            spacing: 3px;
                                                            alignment: center;
                                                            Text {
                                                                text: block.text;
                                                                color: ecmd_ta_mix.has-hover ? #ffffff : #58a6ff;
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        ecmd_ta_mix := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.click_command(block.command_name); }
                                                        }
                                                    }
                                                }

                                                if block.is_link: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 20px;
                                                        background: eblock_ta_mix.has-hover ? #1e293b : transparent;
                                                        border-radius: 3px;
                                                        HorizontalLayout {
                                                            padding-left: 4px;
                                                            padding-right: 4px;
                                                            spacing: 4px;
                                                            alignment: center;
                                                            Text {
                                                                text: block.text;
                                                                color: eblock_ta_mix.has-hover ? #58a6ff : #00a8fc;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                                max-width: 350px;
                                                            }
                                                            Image {
                                                                source: @image-url("../assets/external-link.svg");
                                                                width: 10px;
                                                                height: 10px;
                                                                colorize: eblock_ta_mix.has-hover ? #58a6ff : #00a8fc;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        eblock_ta_mix := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.open_link(block.url); }
                                                        }
                                                    }
                                                }

                                                if block.is_emoji: VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: block.emoji_img;
                                                        width: 18px;
                                                        height: 18px;
                                                        image-fit: contain;
                                                    }
                                                }

                                                if !block.is_link && !block.is_command && !block.is_emoji: Text {
                                                    text: block.text;
                                                    color: #d2d5d9;
                                                    font-size: 12.5px;
                                                    vertical-alignment: center;
                                                    wrap: word-wrap;
                                                    max-width: 420px;
                                                }
                                            }
                                        }
                                    }
                                }

                                if msg.embed_lines.length == 0 && msg.embed-content != "": Text {
                                    width: 100%;
                                    text: msg.embed-content;
                                    color: #d2d5d9;
                                    font-size: 12.5px;
                                    wrap: word-wrap;
                                }

                                if msg.embed-footer != "": Rectangle {
                                    height: 1px;
                                    background: #3f4147;
                                }

                                if msg.embed-footer != "": Text {
                                    width: 100%;
                                    text: msg.embed-footer;
                                    color: #949ba4;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if msg.buttons.length > 0: HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        padding-bottom: 2px;
                        alignment: start;

                        for btn in msg.buttons: Rectangle {
                            height: 32px;
                            background: btn.is_disabled ? #2b2d31 : (btn_ta.has-hover ? (
                                btn.style_type == 1 ? #4752c4 : (
                                btn.style_type == 3 ? #1f8b4c : (
                                btn.style_type == 4 ? #c0353b : (
                                #3b3e45
                                )))
                            ) : (
                                btn.style_type == 1 ? #5865f2 : (
                                btn.style_type == 3 ? #23a55a : (
                                btn.style_type == 4 ? #da373c : (
                                btn.style_type == 5 ? #35373c : (
                                #4e5058
                                ))))
                            ));
                            border-radius: 4px;
                            border-width: btn.style_type == 5 ? 1px : 0px;
                            border-color: #3f4147;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                if btn.emoji-img.width > 0 : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: btn.emoji-img;
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                    }
                                }

                                if btn.emoji != "" && btn.emoji-img.width == 0 : VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: btn.emoji;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: btn.label;
                                    color: btn.is_disabled ? #80848e : #ffffff;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                if btn.url != "": VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/external-link.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: btn.is_disabled ? #80848e : #b5bac1;
                                        image-fit: contain;
                                    }
                                }
                            }

                            btn_ta := TouchArea {
                                enabled: !btn.is_disabled && btn.url != "";
                                mouse-cursor: btn.url != "" ? pointer : default;
                                clicked => {
                                    if btn.url != "" {
                                        root.open_link(btn.url);
                                    }
                                }
                            }
                        }
                    }

                    if msg.attachments.length > 0 : VerticalLayout {
                        spacing: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: start;

                        for att in msg.attachments : Rectangle {
                            property <length> img-height: (att.width > 0 && att.height > 0) ? min(520px, max(120px, 320px * att.height / att.width)) : 200px;
                            width: att.is_image ? 320px : 280px;
                            height: att.is_image ? img-height : 48px;
                            background: #1e1f22;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #2b2d31;
                            clip: true;

                            // 1. Downloaded Full Crisp Image (Clean & Raw)
                            if att.is_image && att.is_downloaded : Image {
                                width: 100%;
                                height: 100%;
                                source: att.full_img;
                                image-fit: contain;
                            }

                            // 2. Low-res pixelated / blurred preview thumbnail
                            if att.is_image && !att.is_downloaded : Image {
                                width: 100%;
                                height: 100%;
                                source: att.preview_img;
                                image-fit: cover;
                            }

                            // 3. Darkened overlay for preview state
                            if att.is_image && !att.is_downloaded : Rectangle {
                                width: 100%;
                                height: 100%;
                                background: #00000077;
                            }

                            // 4. Rounded Rectangle Download Button in the center (when not downloaded)
                            if att.is_image && !att.is_downloaded : VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 38px;
                                        background: dl_ta.has-hover ? #4752c4 : #1e1f22ee;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #5865f2;

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 10px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/arrow-down.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: #ffffff;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: att.is_loading ? "Baixando..." : (att.size_str != "" ? ("Baixar Imagem (" + att.size_str + ")") : "Baixar Imagem");
                                                    color: #ffffff;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        dl_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if (!att.is_loading) {
                                                    root.download_attachment(att.id, att.filename, att.url);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 5. Non-image attachment card (e.g. zip, pdf)
                            if !att.is_image : HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/external-link.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #949ba4;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: att.filename;
                                    color: #58a6ff;
                                    font-size: 13px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: att.size_str;
                                    color: #949ba4;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                non_img_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open_link(att.url); }
                                }
                            }
                        }
                    }

                    if msg.links.length > 0 && !is-collapsed : VerticalLayout {
                        spacing: 4px;
                        padding-top: 4px;
                        for link in msg.links : Rectangle {
                            height: 24px;
                            background: link_ta.has-hover ? #1e293b : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/external-link.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: link_ta.has-hover ? #58a6ff : #00a8fc;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: link.label;
                                    color: link_ta.has-hover ? #58a6ff : #00a8fc;
                                    vertical-alignment: center;
                                    font-size: 12.5px;
                                    font-weight: 500;
                                }
                            }
                            link_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open_link(link.url);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Litecord - Ultra-Lightweight Discord Client";
    icon: @image-url("../assets/app_icon.png");
    no-frame: true;
    preferred-width: 980px;
    preferred-height: 620px;
    min-width: 680px;
    min-height: 480px;
    background: #1e1f22;
    default-font-family: "Segoe UI, Segoe UI Emoji, Segoe UI Symbol, sans-serif";

    // Callbacks to Rust backend
    callback drag_window();
    callback minimize_window();
    callback maximize_window();
    callback close_window();
    callback login(string /* token */);
    callback send_message(string /* content */);
    callback select_channel(string /* channel_id */);
    callback select_guild(string /* guild_id */);
    callback toggle_mute();
    callback toggle_deafen();
    callback leave_voice();
    callback minimize_to_tray();
    callback open_settings();
    callback close_settings();
    callback select_input_device(string /* device_name */);
    callback select_output_device(string /* device_name */);
    callback auto_detect_token();
    callback toggle_user_mute(string /* user_id */);
    callback set_user_volume(string /* user_id */, float /* volume */);
    callback set_user_priority(string /* user_id */, int /* priority */);
    callback toggle_voice_focus();
    callback open_link(string /* url */);
    callback download_attachment(string /* att_id */, string /* filename */, string /* url */);
    callback set_vad_threshold(float /* threshold */);
    callback toggle_test_mic();
    callback logout();
    callback change_language(string /* "auto", "en", "pt" */);
    callback refresh_qr_code();
    callback drag_resize(string /* "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right" */);
    callback update_app_accept();
    callback update_app_dismiss();
    callback update_app_ignore();
    callback check_for_updates();
    callback load_older_messages();
    callback toggle_screen_share();
    callback toggle_stream_fullscreen();
    callback focus_stream(string /* user_id */);
    callback start_stream(int /* monitor_id */, string /* resolution */, int /* fps */);
    callback stop_stream();
    callback open_stream_modal();
    callback close_stream_modal();
    callback popout_stream_window(string /* user_id */, string /* username */);
    callback close_popout_window();
    callback hide_stream(string /* user_id */);
    callback unhide_stream(string /* user_id */);
    callback click_command(string /* command_name */);
    callback handle_input_change(string /* text */);
    callback execute_active_command(string /* cmd_name */, string /* arg_value */, string /* app_id */, string /* cmd_id */, string /* version */, string /* param_name */);

    in-out property <bool> is_linux: false;
    in-out property <bool> drag_area_enabled: true;

    // Smart Command Autocomplete & Parameter Properties
    in-out property <string> chat_input_text: "";
    in-out property <bool> show_command_suggestions: false;
    in-out property <int> active_suggestion_index: 0;
    in-out property <string> active_command_name: "";
    in-out property <string> active_param_name: "";
    in-out property <string> active_param_desc: "";
    in-out property <string> active_command_app_id: "";
    in-out property <string> active_command_cmd_id: "";
    in-out property <string> active_command_version: "";
    in-out property <string> command_arg_text: "";
    in-out property <[CommandSuggestion]> command_suggestions: [
        { name: "/play", desc: "Tocar música, áudio ou playlist (YouTube/Spotify/SoundCloud)", usage: "/play <nome ou link>", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "query", param_desc: "Nome da música ou link do YouTube/Spotify/SoundCloud", is_required: true },
        { name: "/skip", desc: "Pular para a próxima faixa da fila", usage: "/skip", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/stop", desc: "Parar reprodução do bot e limpar a fila", usage: "/stop", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/pause", desc: "Pausar a música em reprodução", usage: "/pause", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/resume", desc: "Retomar a reprodução pausada", usage: "/resume", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/queue", desc: "Visualizar a lista de músicas na fila", usage: "/queue", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/nowplaying", desc: "Exibir detalhes da música que está tocando agora", usage: "/nowplaying", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/volume", desc: "Ajustar o volume de reprodução do bot", usage: "/volume <1-100>", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "level", param_desc: "Volume de 1 a 100", is_required: true },
        { name: "/loop", desc: "Ativar ou desativar repetição da música ou fila", usage: "/loop", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "mode", param_desc: "Modo: track, queue ou off", is_required: false },
        { name: "/shuffle", desc: "Embaralhar a fila de músicas", usage: "/shuffle", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/lyrics", desc: "Buscar e exibir a letra da música atual", usage: "/lyrics", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "song", param_desc: "Nome da música (opcional)", is_required: false },
        { name: "/247", desc: "Manter o bot 24/7 conectado no canal de voz", usage: "/247", app_id: "", app_name: "Música", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/help", desc: "Exibir o menu de ajuda e comandos do bot", usage: "/help", app_id: "", app_name: "Bot", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/ping", desc: "Verificar a latência e tempo de resposta", usage: "/ping", app_id: "", app_name: "Bot", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false },
        { name: "/clear", desc: "Limpar mensagens recentes do canal", usage: "/clear <quantidade>", app_id: "", app_name: "Moderação", cmd_id: "", version: "", param_name: "amount", param_desc: "Quantidade de mensagens a apagar", is_required: true },
        { name: "/avatar", desc: "Exibir o avatar ampliado de um usuário", usage: "/avatar [@usuario]", app_id: "", app_name: "Utilidade", cmd_id: "", version: "", param_name: "user", param_desc: "Usuário do Discord", is_required: false },
        { name: "/userinfo", desc: "Ver informações detalhadas da conta de um usuário", usage: "/userinfo [@usuario]", app_id: "", app_name: "Utilidade", cmd_id: "", version: "", param_name: "user", param_desc: "Usuário do Discord", is_required: false },
        { name: "/serverinfo", desc: "Ver estatísticas e informações do servidor atual", usage: "/serverinfo", app_id: "", app_name: "Utilidade", cmd_id: "", version: "", param_name: "", param_desc: "", is_required: false }
    ];

    // Auto-Update Properties
    in-out property <bool> show_update_dialog: false;
    in-out property <string> update_version: "";
    in-out property <string> update_release_name: "";
    in-out property <bool> is_updating: false;
    in-out property <float> update_progress: 0.0;
    in-out property <string> update_status_text: "Baixando atualização...";
    in-out property <string> app_version: "v0.2.5";
    in-out property <string> update_check_feedback: "";
    in-out property <bool> is_checking_update: false;

    // Chat Pagination Properties
    in-out property <bool> is_loading_older_messages: false;
    in-out property <bool> has_more_older_messages: false;
    in-out property <int> scroll_to_bottom_trigger: 0;

    public function scroll_chat_to_bottom() {
        root.scroll_to_bottom_trigger += 1;
    }

    public function move_suggestion_up() {
        if (root.command_suggestions.length > 0) {
            if (root.active_suggestion_index > 0) {
                root.active_suggestion_index -= 1;
            } else {
                root.active_suggestion_index = root.command_suggestions.length - 1;
            }
        }
    }

    public function move_suggestion_down() {
        if (root.command_suggestions.length > 0) {
            if (root.active_suggestion_index < root.command_suggestions.length - 1) {
                root.active_suggestion_index += 1;
            } else {
                root.active_suggestion_index = 0;
            }
        }
    }

    public function select_suggestion(idx: int) {
        if (idx >= 0 && idx < root.command_suggestions.length) {
            root.active_command_name = root.command_suggestions[idx].name;
            root.active_param_name = root.command_suggestions[idx].param_name;
            root.active_param_desc = root.command_suggestions[idx].param_desc != "" ? root.command_suggestions[idx].param_desc : (root.command_suggestions[idx].param_name != "" ? root.command_suggestions[idx].desc : "Pressione Enter para executar " + root.command_suggestions[idx].name);
            root.active_command_app_id = root.command_suggestions[idx].app_id;
            root.active_command_cmd_id = root.command_suggestions[idx].cmd_id;
            root.active_command_version = root.command_suggestions[idx].version;
            root.command_arg_text = "";
            root.chat_input_text = "";
            root.show_command_suggestions = false;
        }
    }

    // Translations (i18n)
    in-out property <string> current_language_code: "auto";
    in-out property <string> tr_login_title: "Sign in to Litecord";
    in-out property <string> tr_login_desc: "Enter your Discord User Token for direct connection to Gateway v9.\n(Estimated RAM usage ~15MB)";
    in-out property <string> tr_login_placeholder: "Paste your Discord User Token here...";
    in-out property <string> tr_login_btn_connect: "Connect to Gateway";
    in-out property <string> tr_login_btn_detect: "Detect Discord Token";
    in-out property <string> tr_server_channels: "SERVER CHANNELS";
    in-out property <string> tr_leave: "Leave";
    in-out property <string> tr_view_text_chat: "View Text Chat";
    in-out property <string> tr_leave_call: "Disconnect Call";
    in-out property <string> tr_voice_participants_title: "VOICE ROOM PARTICIPANTS";
    in-out property <string> tr_badge_you: "YOU";
    in-out property <string> tr_view_voice_room: "View Voice Room";
    in-out property <string> tr_replying_to: "Replying to @";
    in-out property <string> tr_chat_placeholder_prefix: "Message ";
    in-out property <string> tr_send: "Send";
    in-out property <string> tr_settings_title: "Voice & Audio Settings";
    in-out property <string> tr_settings_language_label: "LANGUAGE / IDIOMA";
    in-out property <string> tr_settings_input_device: "INPUT DEVICE (MICROPHONE)";
    in-out property <string> tr_settings_output_device: "OUTPUT DEVICE (SPEAKERS / HEADPHONES)";
    in-out property <string> tr_settings_threshold: "VOICE DETECTION SENSITIVITY (THRESHOLD)";
    in-out property <string> tr_settings_mic_level: "REAL-TIME MICROPHONE LEVEL";
    in-out property <string> tr_settings_btn_test_start: "🎧 Test Microphone (\"Hear Yourself\")";
    in-out property <string> tr_settings_btn_test_stop: "🎙️ Stop Testing (Listening...)";
    in-out property <string> tr_settings_done: "Done";
    in-out property <string> tr_logout_title: "Sign Out";
    in-out property <string> tr_logout_confirm_prefix: "Do you want to log out from ";
    in-out property <string> tr_cancel: "Cancel";
    in-out property <string> tr_confirm_logout: "Sign Out";
    in-out property <string> tr_voice_connecting: "Connecting...";
    in-out property <string> tr_voice_connecting_title: "Connecting to Voice Channel...";
    in-out property <string> tr_voice_connecting_desc: "Authenticating with Voice Gateway v9 and negotiating DAVE E2EE encryption...";
    in-out property <string> tr_voice_connected: "Voice Connected";
    in-out property <string> tr_qr_title: "Log in with QR Code";
    in-out property <string> tr_qr_desc: "Scan this with the Discord mobile app to log in instantly.";
    in-out property <string> tr_qr_confirm: "Approve login on your phone!";

    // QR Code Login Properties
    in-out property <image> qr_code_image;
    in-out property <bool> has_qr_code: false;
    in-out property <bool> is_qr_loading: false;
    in-out property <string> qr_scanned_user: "";

    // Properties exposed to Rust backend
    in-out property <bool> is_logged_in: false;
    in-out property <string> connection_status: "Aguardando Token de Acesso...";
    in-out property <string> user_tag: "Não conectado";
    in-out property <string> active_channel_name: "Selecione um canal";
    in-out property <bool> is_muted: false;
    in-out property <bool> is_deafened: false;
    in-out property <bool> is_in_voice: false;
    in-out property <bool> is_voice_connecting: false;
    in-out property <string> current_voice_channel: "";
    in-out property <bool> is_voice_focused: false;
    in-out property <[VoiceParticipant]> voice_participants: [];
    in-out property <bool> show_user_menu: false;

    // Voice & Audio Settings Properties
    in-out property <bool> show_settings_modal: false;
    in-out property <[LanguageItem]> languages: [];
    in-out property <[AudioDeviceItem]> input_devices: [];
    in-out property <[AudioDeviceItem]> output_devices: [];
    in-out property <string> selected_input_device: "Microfone Padrão do Sistema";
    in-out property <string> selected_output_device: "Alto-falantes Padrão do Sistema";
    in-out property <float> mic_level: 0.0; // Real-time mic volume level (0.0 to 1.0)
    in-out property <float> vad_threshold: 0.05; // Voice Activity Detection Threshold (0.0 to 1.0)
    in-out property <bool> is_testing_mic: false; // Mic loopback ("Se ouvir") test active

    // Screen Share / Live Video Grid Properties
    in-out property <bool> is_screen_sharing: false;
    in-out property <bool> show_stream_modal: false;
    in-out property <string> stream_source_tab: "screens";
    in-out property <string> stream_selected_res: "1080p";
    in-out property <int> stream_selected_fps: 60;
    in-out property <int> stream_selected_source_index: 0;
    in-out property <string> stream_selected_window_id: "";
    in-out property <bool> stream_include_audio: true;
    in-out property <[ScreenSourceItem]> available_screens: [];
    in-out property <[WindowSourceItem]> available_windows: [];
    in-out property <[CameraSourceItem]> available_cameras: [];
    in-out property <string> stream_selected_camera_id: "";
    in-out property <string> popped_out_stream_uid: "";
    in-out property <bool> has_active_stream: false;
    in-out property <string> active_stream_user: "";
    in-out property <string> active_stream_user_id: "";
    in-out property <image> active_stream_frame;
    in-out property <image> remote_stream_frame;
    in-out property <bool> is_stream_fullscreen: false;
    in-out property <string> focused_stream_uid: "";
    in-out property <string> tr_start_screen_share: "Transmitir";
    in-out property <string> tr_stop_screen_share: "Parar Transmissão";
    in-out property <string> tr_watching_stream: "Assistindo Transmissão";
    in-out property <string> tr_live_badge: "AO VIVO";
    in-out property <string> tr_stream_quality: "720p 30fps";
    in-out property <string> local_preview_fps: "";
    in-out property <float> stream_remote_volume: 1.0;
    in-out property <bool> is_popout_intangible: false;
    callback set_stream_volume(string, float);
    callback toggle_popout_intangible();

    in-out property <[GuildItem]> guilds: [];
    in-out property <[ChannelItem]> channels: [];
    in-out property <[ChatMessage]> messages: [
        { author: "Litecord System", timestamp: "Agora", content: "Bem-vindo ao Litecord! Seus servidores carregarão na barra lateral à esquerda." }
    ];

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Status Header Bar (Frameless Custom Titlebar)
        Rectangle {
            height: 32px;
            background: #111214;

            if root.drag_area_enabled: TouchArea {
                width: parent.width - 150px;
                height: 100%;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.drag_window();
                    }
                }
            }

            HorizontalBox {
                padding-left: 12px;
                padding-right: 146px;
                padding-top: 0px;
                padding-bottom: 0px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/app_icon.png");
                                width: 16px;
                                height: 16px;
                                colorize: #ffffff;
                                image-fit: contain;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "LITECORD";
                                color: #ffffff;
                                font-weight: 800;
                                font-size: 13px;
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.connection_status;
                        color: #949ba4;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("../assets/settings.svg");
                        clicked => { root.open_settings(); }
                    }
                }
            }

            // Custom Window Control Buttons (Minimize, Maximize, Close)
            HorizontalLayout {
                x: parent.width - 138px;
                y: 0px;
                width: 138px;
                height: 32px;
                spacing: 0px;

                // Minimize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: min-touch.has-hover ? #2b2d31 : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-minimize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: #dbdee1;
                                image-fit: contain;
                            }
                        }
                    }

                    min-touch := TouchArea {
                        clicked => { root.minimize_window(); }
                    }
                }

                // Maximize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: max-touch.has-hover ? #2b2d31 : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-maximize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: #dbdee1;
                                image-fit: contain;
                            }
                        }
                    }

                    max-touch := TouchArea {
                        clicked => { root.maximize_window(); }
                    }
                }

                // Close
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: close-touch.has-hover ? #f23f43 : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-close.svg");
                                width: 10px;
                                height: 10px;
                                colorize: close-touch.has-hover ? #ffffff : #dbdee1;
                                image-fit: contain;
                            }
                        }
                    }

                    close-touch := TouchArea {
                        clicked => { root.close_window(); }
                    }
                }
            }
        }

        // Body Content
        if !root.is_logged_in: Rectangle {
            background: #1e1f22;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 720px;
                        height: 380px;
                        background: #2b2d31;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #383a40;

                        HorizontalLayout {
                            padding: 32px;
                            spacing: 32px;

                            // Left Column: Token / Auto-Detect Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;

                                    Image {
                                        source: @image-url("../assets/app_icon.png");
                                        width: 26px;
                                        height: 26px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: root.tr_login_title;
                                        color: #f2f3f5;
                                        font-size: 20px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.tr_login_desc;
                                    color: #949ba4;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                token_input := LineEdit {
                                    placeholder-text: root.tr_login_placeholder;
                                    input-type: password;
                                    accepted => {
                                        if (token_input.text != "") {
                                            root.login(token_input.text);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/rocket.svg");
                                        text: root.tr_login_btn_connect;
                                        primary: true;
                                        clicked => {
                                            if (token_input.text != "") {
                                                root.login(token_input.text);
                                            }
                                        }
                                    }

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/search.svg");
                                        text: root.tr_login_btn_detect;
                                        clicked => {
                                            root.auto_detect_token();
                                        }
                                    }
                                }
                            }

                            // Middle Divider
                            Rectangle {
                                width: 1px;
                                background: #383a40;
                            }

                            // Right Column: Official QR Code Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 12px;

                                // QR Code Card Container
                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 160px;
                                        height: 160px;
                                        background: #ffffff;
                                        border-radius: 8px;
                                        clip: true;

                                        if root.has_qr_code: Image {
                                            source: root.qr_code_image;
                                            width: 160px;
                                            height: 160px;
                                            image-fit: contain;
                                        }

                                        if !root.has_qr_code: VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/qr.svg");
                                                    width: 32px;
                                                    height: 32px;
                                                    colorize: #5865f2;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Gerar QR";
                                                    clicked => { root.refresh_qr_code(); }
                                                }
                                            }
                                        }

                                        // User Scanned Overlay Badge
                                        if root.qr_scanned_user != "": Rectangle {
                                            background: #111214e6;
                                            width: 100%;
                                            height: 100%;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                padding: 8px;

                                                Text {
                                                    text: "✅ " + root.qr_scanned_user;
                                                    color: #23a55a;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: root.tr_qr_confirm;
                                                    color: #ffffff;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.tr_qr_title;
                                    color: #f2f3f5;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_qr_desc;
                                    color: #949ba4;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.is_logged_in: HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // 1. Guilds Sidebar (Servidores com Scroll e tamanho fixado)
            Rectangle {
                width: 72px;
                background: #1e1f22;

                VerticalBox {
                    padding: 8px;
                    spacing: 0px;

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 10px;
                                alignment: start;

                                for guild in root.guilds: Rectangle {
                                    height: 48px;
                                    width: 48px;
                                    background: #313338;
                                    border-radius: 24px;
                                    clip: true;

                                    if guild.has_image: Image {
                                        source: guild.icon_image;
                                        width: 48px;
                                        height: 48px;
                                        image-fit: cover;
                                    }

                                    if !guild.has_image: Text {
                                        text: guild.icon;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    TouchArea {
                                        clicked => { root.select_guild(guild.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Channels Sidebar (Canais com Scroll e tamanho fixado)
            Rectangle {
                width: 230px;
                background: #2b2d31;

                VerticalBox {
                    padding: 8px;
                    spacing: 6px;

                    Text {
                        text: root.tr_server_channels;
                        color: #949ba4;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 4px;
                                alignment: start;

                                for channel in root.channels: Rectangle {
                                    height: 34px;
                                    background: #35373c;
                                    border-radius: 6px;

                                    HorizontalBox {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;

                                        if channel.is_voice : Image {
                                            source: @image-url("../assets/speaker.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #23a55a;
                                        }
                                        if !channel.is_voice : Text {
                                            text: "#";
                                            color: #80848e;
                                            font-size: 16px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: channel.name;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if channel.is_voice && channel.voice_count > 0 : Rectangle {
                                            width: 22px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: #23a55a;

                                            Text {
                                                text: "\{channel.voice_count}";
                                                color: #ffffff;
                                                font-size: 10px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.select_channel(channel.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Active Voice Channel Banner
                    if root.is_in_voice: Rectangle {
                        height: 44px;
                        background: root.is_voice_connecting ? #d97706 : #23a55a;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: #ffffff;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: root.is_voice_connecting ? root.tr_voice_connecting : root.tr_voice_connected;
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 800;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.current_voice_channel;
                                    color: #f1f5f9;
                                    font-size: 10px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_leave;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // User Footer in Channels bar
                    Rectangle {
                        height: 58px;
                        background: #232428;
                        border-radius: 6px;

                        VerticalBox {
                            padding-top: 4px;
                            padding-bottom: 6px;
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;

                            Rectangle {
                                background: user_tag_touch.has-hover ? #35373c : transparent;
                                border-radius: 4px;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 4px;

                                    Text {
                                        text: root.user_tag;
                                        color: user_tag_touch.has-hover ? #5865f2 : #f2f3f5;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                user_tag_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = !root.show_user_menu;
                                    }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 4px;

                                IconButton {
                                    icon: root.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                    icon-color: root.is_muted ? #f23f43 : #dbdee1;
                                    clicked => { root.toggle_mute(); }
                                }

                                IconButton {
                                    icon: root.is_deafened ? @image-url("../assets/headphones-mute.svg") : @image-url("../assets/headphones.svg");
                                    icon-color: root.is_deafened ? #f23f43 : #dbdee1;
                                    clicked => { root.toggle_deafen(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/settings.svg");
                                    clicked => { root.open_settings(); }
                                }
                            }
                        }
                    }
                }
            }

            // 3. Main Content View (Text Chat OR Voice Room View)
            Rectangle {
                background: #313338;
                horizontal-stretch: 1;

                if root.is_voice_focused && root.is_in_voice: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Voice Room Header Bar
                    Rectangle {
                        height: 44px;
                        background: #2b2d31;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #ffffff;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.current_voice_channel;
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 800;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/monitor.svg");
                                    text: root.is_screen_sharing ? root.tr_stop_screen_share : root.tr_start_screen_share;
                                    clicked => {
                                        if root.is_screen_sharing {
                                            root.toggle_screen_share();
                                        } else {
                                            root.open_stream_modal();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/message-square.svg");
                                    text: root.tr_view_text_chat;
                                    clicked => { root.toggle_voice_focus(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_leave_call;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // Voice Room Connecting Loading State
                    if root.is_voice_connecting: Rectangle {
                        vertical-stretch: 1;
                        background: #1e1f22;

                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 68px;
                                    height: 68px;
                                    border-radius: 34px;
                                    background: #2b2d31;
                                    border-width: 2px;
                                    border-color: #5865f2;

                                    Image {
                                        source: @image-url("../assets/speaker.svg");
                                        width: 28px;
                                        height: 28px;
                                        colorize: #5865f2;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.tr_voice_connecting_title;
                                    color: #ffffff;
                                    font-size: 16px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_voice_connecting_desc;
                                    color: #949ba4;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_cancel;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // Voice Room Participants Dynamic Stage Grid
                    if !root.is_voice_connecting: Rectangle {
                        vertical-stretch: 1;
                        background: #313338;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: root.tr_voice_participants_title + " (" + root.voice_participants.length + ")";
                                color: #949ba4;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            ListView {
                                for p in root.voice_participants: Rectangle {
                                    property <bool> is_streaming_attached: (p.is_self && root.is_screen_sharing)
                                        ? (!p.is_stream_hidden && root.popped_out_stream_uid != p.user_id && root.popped_out_stream_uid != "self")
                                        : (root.has_active_stream && p.is_streaming && !p.is_stream_hidden && root.popped_out_stream_uid != p.user_id);
                                    property <bool> is_this_stream_focused: (root.focused_stream_uid == p.user_id || (p.is_self && (root.focused_stream_uid == "self" || root.focused_stream_uid == p.user_id)));

                                    height: is_streaming_attached ? (is_this_stream_focused ? 480px : 260px) : 76px;
                                    animate height { duration: 200ms; }
                                    background: #00000000;

                                    // 1. EXPANDED STREAM VIEWPORT (When Streaming in the room & NOT popped out)
                                    if is_streaming_attached: Rectangle {
                                        y: 4px;
                                        height: parent.height - 8px;
                                        background: #111214;
                                        border-radius: 8px;
                                        border-width: p.is_speaking ? 3px : ((p.is_self && root.is_screen_sharing) ? 2px : 1px);
                                        border-color: p.is_speaking ? #23a55a : ((p.is_self && root.is_screen_sharing) ? #5865f2 : #383a40);
                                        clip: true;

                                        // Video Canvas (Independent dual buffers: active_stream_frame for self transmitter, remote_stream_frame for remote peer)
                                        Image {
                                            source: (p.is_self && root.is_screen_sharing) ? root.active_stream_frame : root.remote_stream_frame;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                        }

                                        // Top Overlay Bar (Left: Live badge, username, mute, prio | Right: Popout, Fullscreen)
                                        Rectangle {
                                            x: 8px;
                                            y: 8px;
                                            width: parent.width - 16px;
                                            height: 32px;
                                            background: transparent;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: space-between;

                                                // Left side: Badge, User Info, Mute and Priority
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;

                                                    // Live Badge
                                                    Rectangle {
                                                        background: #f23f43;
                                                        border-radius: 4px;
                                                        height: 24px;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 5px;
                                                            VerticalLayout {
                                                                alignment: center;
                                                                Rectangle {
                                                                    width: 6px;
                                                                    height: 6px;
                                                                    border-radius: 3px;
                                                                    background: #ffffff;
                                                                }
                                                            }
                                                            Text {
                                                                text: root.tr_live_badge;
                                                                color: #ffffff;
                                                                font-size: 10px;
                                                                font-weight: 800;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // Username & Quality Pill
                                                    Rectangle {
                                                        background: #000000aa;
                                                        border-radius: 4px;
                                                        height: 24px;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            Text {
                                                                text: p.username + " • " + root.tr_stream_quality;
                                                                color: #dbdee1;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // Local Transmitter FPS Counter Badge (Displayed ONLY on local transmitter preview)
                                                    if (p.is_self && root.is_screen_sharing) && root.local_preview_fps != "": Rectangle {
                                                        background: #23a55a22;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #23a55a;
                                                        height: 24px;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 5px;
                                                            VerticalLayout {
                                                                alignment: center;
                                                                Rectangle {
                                                                    width: 6px;
                                                                    height: 6px;
                                                                    border-radius: 3px;
                                                                    background: #23a55a;
                                                                }
                                                            }
                                                            Text {
                                                                text: root.local_preview_fps;
                                                                color: #23a55a;
                                                                font-size: 11px;
                                                                font-weight: 800;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // Stream Audio Volume Slider (only shown for remote stream cards)
                                                    if !(p.is_self && root.is_screen_sharing): Rectangle {
                                                        background: #000000aa;
                                                        border-radius: 4px;
                                                        height: 24px;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            spacing: 6px;
                                                            alignment: center;

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: root.stream_remote_volume <= 0.01 ? @image-url("../assets/volume-x.svg") : @image-url("../assets/speaker.svg");
                                                                    width: 12px;
                                                                    height: 12px;
                                                                    colorize: root.stream_remote_volume <= 0.01 ? #f23f43 : #949ba4;
                                                                    image-fit: contain;
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Rectangle {
                                                                    width: 55px;
                                                                    height: 5px;
                                                                    background: #35373c;
                                                                    border-radius: 2.5px;

                                                                    // Progress fill
                                                                    Rectangle {
                                                                        x: 0;
                                                                        y: 0;
                                                                        width: parent.width * (root.stream_remote_volume.clamp(0.0, 1.0));
                                                                        height: 100%;
                                                                        background: root.stream_remote_volume <= 0.01 ? #f23f43 : #5865f2;
                                                                        border-radius: 2.5px;
                                                                    }

                                                                    TouchArea {
                                                                        mouse-cursor: pointer;
                                                                        clicked => {
                                                                            let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                                                            root.stream_remote_volume = new_vol;
                                                                            root.set_stream_volume(p.user_id, new_vol);
                                                                        }
                                                                        moved => {
                                                                            if self.pressed {
                                                                                let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                                                                root.stream_remote_volume = new_vol;
                                                                                root.set_stream_volume(p.user_id, new_vol);
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Text {
                                                                    text: "\{Math.round(root.stream_remote_volume * 100)}%";
                                                                    color: #949ba4;
                                                                    font-size: 9px;
                                                                    font-weight: 700;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // If another user is streaming: Mute button and Priority controls directly on the stream card!
                                                    if !(p.is_self && root.is_screen_sharing): HorizontalLayout {
                                                        spacing: 4px;
                                                        alignment: start;

                                                        // Stream Mute Button
                                                        Rectangle {
                                                            width: 26px;
                                                            height: 24px;
                                                            border-radius: 4px;
                                                            background: str_mute_ta.has-hover ? #000000dd : #000000aa;

                                                            VerticalLayout {
                                                                alignment: center;
                                                                HorizontalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                                        width: 12px;
                                                                        height: 12px;
                                                                        colorize: p.is_muted ? #f23f43 : #dbdee1;
                                                                        image-fit: contain;
                                                                    }
                                                                }
                                                            }

                                                            str_mute_ta := TouchArea {
                                                                mouse-cursor: pointer;
                                                                clicked => { root.toggle_user_mute(p.user_id); }
                                                            }
                                                        }

                                                        // Stream Speech Priority Control Box
                                                        Rectangle {
                                                            width: 76px;
                                                            height: 24px;
                                                            background: #000000aa;
                                                            border-radius: 4px;
                                                            border-width: 1px;
                                                            border-color: p.priority > 0 ? #5865f2 : #383a40;

                                                            HorizontalLayout {
                                                                padding: 1px;
                                                                spacing: 2px;

                                                                Rectangle {
                                                                    width: 18px;
                                                                    height: 20px;
                                                                    border-radius: 3px;
                                                                    background: str_pdec_ta.has-hover ? #383a40 : transparent;
                                                                    Text { text: "-"; color: #dbdee1; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                                    str_pdec_ta := TouchArea {
                                                                        mouse-cursor: pointer;
                                                                        clicked => { if p.priority > 0 { root.set_user_priority(p.user_id, p.priority - 1); } }
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    horizontal-stretch: 1;
                                                                    alignment: center;
                                                                    Text {
                                                                        text: p.priority == 0 ? "Normal" : ("P" + p.priority);
                                                                        color: p.priority > 0 ? #5865f2 : #949ba4;
                                                                        font-size: 9px;
                                                                        font-weight: 700;
                                                                        horizontal-alignment: center;
                                                                    }
                                                                }

                                                                Rectangle {
                                                                    width: 18px;
                                                                    height: 20px;
                                                                    border-radius: 3px;
                                                                    background: str_pinc_ta.has-hover ? #383a40 : transparent;
                                                                    Text { text: "+"; color: #dbdee1; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                                    str_pinc_ta := TouchArea {
                                                                        mouse-cursor: pointer;
                                                                        clicked => { if p.priority < 3 { root.set_user_priority(p.user_id, p.priority + 1); } }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                // Right side: Stop, Popout and Fullscreen buttons
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: end;

                                                    // Stop Screen Share Button (Direct on stream card!)
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_stop_ta.has-hover ? #f23f43 : #000000aa;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/chrome-close.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: #ffffff;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_stop_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if (p.is_self && root.is_screen_sharing) {
                                                                    root.toggle_screen_share();
                                                                } else {
                                                                    root.hide_stream(p.user_id);
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Popout Button
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_pop_ta.has-hover ? #000000dd : #000000aa;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/popout.svg");
                                                                    width: 12px;
                                                                    height: 12px;
                                                                    colorize: #ffffff;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_pop_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.popped_out_stream_uid = p.user_id;
                                                                root.popout_stream_window(p.user_id, p.username);
                                                            }
                                                        }
                                                    }

                                                    // Stream Card Focus / Expand Toggle
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_fs_ta.has-hover ? #000000dd : #000000aa;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: is_this_stream_focused ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: is_this_stream_focused ? #5865f2 : #ffffff;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_fs_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if is_this_stream_focused {
                                                                    root.focused_stream_uid = "";
                                                                } else {
                                                                    root.focused_stream_uid = (p.is_self && root.is_screen_sharing) ? "self" : p.user_id;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Self-Stream Discord-Style Banner Overlay
                                        if (p.is_self && root.is_screen_sharing): Rectangle {
                                            x: (parent.width - 200px) / 2;
                                            y: parent.height - 34px;
                                            width: 200px;
                                            height: 26px;
                                            background: #000000cc;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: #5865f2;

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/monitor.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: #5865f2;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Você está transmitindo";
                                                    color: #ffffff;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // 2. STANDARD VOICE AUDIO RECTANGLE (When NOT streaming OR when Popped Out)
                                    if !is_streaming_attached: Rectangle {
                                        y: 4px;
                                        height: 68px;
                                        background: p.is_self ? #232738 : #2b2d31;
                                        border-radius: 8px;
                                        border-width: p.is_speaking ? 2px : (p.is_self ? 1px : 0px);
                                        border-color: p.is_speaking ? #23a55a : (p.is_self ? #5865f2 : #00000000);

                                        HorizontalBox {
                                             padding-left: 12px;
                                             padding-right: 12px;
                                             spacing: 12px;

                                             // Avatar Badge with Glowing Green Ring when speaking / Blue accent for self!
                                             VerticalLayout {
                                                 alignment: center;
                                                 Rectangle {
                                                     width: 42px;
                                                     height: 42px;
                                                     border-radius: 21px;
                                                     background: p.is_speaking ? #23a55a : (p.is_self ? #5865f2 : #383a40);
                                                     border-width: p.is_speaking ? 3px : (p.is_self ? 2px : 0px);
                                                     border-color: p.is_speaking ? #23a55a : (p.is_self ? #7983f5 : #00000000);

                                                     Text {
                                                         text: p.avatar_text;
                                                         color: #ffffff;
                                                         font-size: 16px;
                                                         font-weight: 700;
                                                         horizontal-alignment: center;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                             }

                                             // Username & Controls in a Vertical Stack!
                                             VerticalBox {
                                                 horizontal-stretch: 1;
                                                 alignment: center;
                                                 spacing: 6px;
                                                 padding: 0px;

                                                 // Row 1: Username & Badges
                                                 HorizontalLayout {
                                                     spacing: 8px;
                                                     Text {
                                                         text: p.username;
                                                         color: p.is_self ? #7983f5 : (p.is_speaking ? #ffffff : #dbdee1);
                                                         font-weight: 700;
                                                         font-size: 14px;
                                                         vertical-alignment: center;
                                                     }

                                                     if p.is_self: Rectangle {
                                                         background: #5865f2;
                                                         border-radius: 4px;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: root.tr_badge_you;
                                                                 color: #ffffff;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     if (root.popped_out_stream_uid == p.user_id || (p.is_self && root.popped_out_stream_uid == "self")): Rectangle {
                                                         background: #5865f233;
                                                         border-radius: 4px;
                                                         border-width: 1px;
                                                         border-color: #5865f2;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: "DESANEXADO";
                                                                 color: #5865f2;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     // Live Badge if streaming while card is audio-only/hidden
                                                     if (p.is_streaming || (p.is_self && root.is_screen_sharing)): Rectangle {
                                                         background: #f23f4333;
                                                         border-radius: 4px;
                                                         border-width: 1px;
                                                         border-color: #f23f43;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             spacing: 4px;
                                                             VerticalLayout {
                                                                 alignment: center;
                                                                 Rectangle {
                                                                     width: 4px;
                                                                     height: 4px;
                                                                     border-radius: 2px;
                                                                     background: #f23f43;
                                                                 }
                                                             }
                                                             Text {
                                                                 text: "AO VIVO";
                                                                 color: #f23f43;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     if p.is_muted: HorizontalLayout {
                                                         spacing: 4px;
                                                         alignment: start;
                                                         Image {
                                                             source: @image-url("../assets/volume-x.svg");
                                                             width: 12px;
                                                             height: 12px;
                                                             colorize: #f23f43;
                                                         }
                                                         Text {
                                                             text: "MUTED";
                                                             color: #f23f43;
                                                             font-size: 11px;
                                                             font-weight: 700;
                                                             vertical-alignment: center;
                                                         }
                                                     }

                                                     Rectangle { horizontal-stretch: 1; }

                                                      // Intangible Deactivation Button (Active when popout is clicked-through)
                                                      if (root.is_popout_intangible && (root.popped_out_stream_uid == p.user_id || (p.is_self && root.popped_out_stream_uid == "self"))): Rectangle {
                                                          height: 22px;
                                                          border-radius: 4px;
                                                          background: ghost_deact_ta.has-hover ? #208b4c : #23a55a;

                                                          HorizontalLayout {
                                                              padding-left: 8px;
                                                              padding-right: 8px;
                                                              spacing: 5px;

                                                              VerticalLayout {
                                                                  alignment: center;
                                                                  Image {
                                                                      source: @image-url("../assets/ghost.svg");
                                                                      width: 12px;
                                                                      height: 12px;
                                                                      colorize: #ffffff;
                                                                      image-fit: contain;
                                                                  }
                                                              }

                                                              Text {
                                                                  text: "Desativar Intangível";
                                                                  color: #ffffff;
                                                                  font-size: 10px;
                                                                  font-weight: 700;
                                                                  vertical-alignment: center;
                                                              }
                                                          }

                                                          ghost_deact_ta := TouchArea {
                                                              mouse-cursor: pointer;
                                                              clicked => {
                                                                  root.toggle_popout_intangible();
                                                              }
                                                          }
                                                      }

                                                     // Square button in top-right corner to re-enable/unhide stream (ONLY visible if user is currently streaming!)
                                                     if (p.is_streaming || (p.is_self && root.is_screen_sharing)): Rectangle {
                                                         width: 26px;
                                                         height: 22px;
                                                         border-radius: 4px;
                                                         background: unhide_stream_ta.has-hover ? #5865f2 : #35373c;

                                                         VerticalLayout {
                                                             alignment: center;
                                                             HorizontalLayout {
                                                                 alignment: center;
                                                                 Image {
                                                                     source: @image-url("../assets/window.svg");
                                                                     width: 12px;
                                                                     height: 12px;
                                                                     colorize: #ffffff;
                                                                     image-fit: contain;
                                                                 }
                                                             }
                                                         }

                                                         unhide_stream_ta := TouchArea {
                                                             mouse-cursor: pointer;
                                                             clicked => {
                                                                 root.unhide_stream(p.user_id);
                                                             }
                                                         }
                                                     }
                                                 }

                                                 // Row 2: Controls vs Self Info
                                                 if p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Mic Volume Meter Bar for Self
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: #1e1f22;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? #23a55a : #5865f2;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Status description for Self
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: root.is_muted ? "Muted" : (p.is_speaking ? "Transmitting..." : "Mic active");
                                                             color: root.is_muted ? #f23f43 : (p.is_speaking ? #23a55a : #80848e);
                                                             font-size: 11px;
                                                             font-weight: 600;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                 }

                                                 if !p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Volume Level Meter Bar
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: #1e1f22;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? #23a55a : #5865f2;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Mute Button
                                                     VerticalLayout {
                                                         alignment: center;
                                                         IconButton {
                                                             icon: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                             icon-color: p.is_muted ? #f23f43 : #dbdee1;
                                                             clicked => { root.toggle_user_mute(p.user_id); }
                                                         }
                                                     }

                                                     // Volume Text
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: "Vol: " + Math.round(p.volume * 100) + "%";
                                                             color: #b5bac1;
                                                             font-size: 11px;
                                                             vertical-alignment: center;
                                                         }
                                                     }

                                                      // Slider (0% to 200% with amplification boost like Discord)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Slider {
                                                              width: 110px;
                                                              minimum: 0.0;
                                                              maximum: 2.0;
                                                              value: p.volume;
                                                              changed(val) => { root.set_user_volume(p.user_id, val); }
                                                          }
                                                      }

                                                      // Speech Priority Control Box (Prioridade de Fala)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Rectangle {
                                                              width: 86px;
                                                              height: 24px;
                                                              background: #2b2d31;
                                                              border-radius: 6px;
                                                              border-width: 1px;
                                                              border-color: p.priority > 0 ? #5865f2 : #383a40;

                                                              HorizontalLayout {
                                                                  padding: 2px;
                                                                  spacing: 2px;

                                                                  // "-" Decrement Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: prio_dec_ta.has-hover ? #383a40 : transparent;

                                                                      Text {
                                                                          text: "-";
                                                                          color: #dbdee1;
                                                                          font-size: 12px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      prio_dec_ta := TouchArea {
                                                                          clicked => {
                                                                              if p.priority > 0 {
                                                                                  root.set_user_priority(p.user_id, p.priority - 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }

                                                                  // Priority Display
                                                                  VerticalLayout {
                                                                      horizontal-stretch: 1;
                                                                      alignment: center;
                                                                      Text {
                                                                          text: p.priority == 0 ? "Normal" : ("Prio " + p.priority);
                                                                          color: p.priority > 0 ? #5865f2 : #949ba4;
                                                                          font-size: 10px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }
                                                                  }

                                                                  // "+" Increment Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: prio_inc_ta.has-hover ? #383a40 : transparent;

                                                                      Text {
                                                                          text: "+";
                                                                          color: #dbdee1;
                                                                          font-size: 12px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      prio_inc_ta := TouchArea {
                                                                          clicked => {
                                                                              if p.priority < 3 {
                                                                                  root.set_user_priority(p.user_id, p.priority + 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }
                                                              }
                                                          }
                                                      }
                                                 }
                                             }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if (!root.is_voice_focused || !root.is_in_voice): VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Channel Header
                    Rectangle {
                        height: 42px;
                        background: #313338;

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;

                            Text {
                                text: root.active_channel_name;
                                color: #f2f3f5;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.is_in_voice: Button {
                                icon: @image-url("../assets/speaker.svg");
                                text: root.tr_view_voice_room;
                                clicked => { root.toggle_voice_focus(); }
                            }
                        }
                    }

                    // Messages Chat Feed View
                    chat_view := ChatMessagesView {
                        vertical-stretch: 1;
                        messages: root.messages;
                        has_more_older_messages: root.has_more_older_messages;
                        is_loading_older_messages: root.is_loading_older_messages;
                        tr_replying_to: root.tr_replying_to;
                        scroll_trigger: root.scroll_to_bottom_trigger;
                        load_older_messages => { root.load_older_messages(); }
                        open_link(url) => { root.open_link(url); }
                        download_attachment(id, fn, url) => { root.download_attachment(id, fn, url); }
                        click_command(cmd) => {
                            root.click_command(cmd);
                        }
                    }

                    // Smart Slash Command Autocomplete / Suggestions Box (Discord Style)
                    if root.show_command_suggestions : Rectangle {
                        height: Math.min(220px, (root.command_suggestions.length * 44 + 36) * 1px);
                        background: #2b2d31;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;
                        border-width: 1px;
                        border-color: #383a40;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000066;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/terminal.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: #5865f2;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: "COMANDOS INTELIGENTES DO DISCORD";
                                    color: #949ba4;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "Clique para autocompletar";
                                    color: #5865f2;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 3px;
                                    for cmd[idx] in root.command_suggestions: Rectangle {
                                        height: 38px;
                                        background: (idx == root.active_suggestion_index || cmd_sug_ta.has-hover) ? #35373c : #1e1f22;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: (idx == root.active_suggestion_index) ? #5865f2 : (cmd_sug_ta.has-hover ? #5865f288 : transparent);

                                         HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/terminal.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: (idx == root.active_suggestion_index) ? #58a6ff : #80848e;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.name;
                                                    color: (idx == root.active_suggestion_index) ? #ffffff : #58a6ff;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Bot Identifier Badge (e.g. [ Jockie Music ] or [ FredBoat ])
                                            if cmd.app_name != "" : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 18px;
                                                    background: (idx == root.active_suggestion_index) ? #5865f255 : #5865f222;
                                                    border-radius: 3px;
                                                    border-width: 1px;
                                                    border-color: (idx == root.active_suggestion_index) ? #5865f2aa : #5865f255;
                                                    HorizontalLayout {
                                                        padding-left: 5px;
                                                        padding-right: 5px;
                                                        alignment: center;
                                                        Text {
                                                            text: cmd.app_name;
                                                            color: (idx == root.active_suggestion_index) ? #ffffff : #a5b4fc;
                                                            font-size: 10px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.desc;
                                                    color: (idx == root.active_suggestion_index) ? #dbdee1 : #949ba4;
                                                    font-size: 11.5px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.usage;
                                                    color: (idx == root.active_suggestion_index) ? #949ba4 : #636b75;
                                                    font-size: 10.5px;
                                                    font-family: "Courier New";
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        cmd_sug_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.select_suggestion(idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Message / Smart Command Input Box
                    Rectangle {
                        height: 56px;
                        background: #313338;

                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;

                            if root.active_command_name != "" : HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                // Command Pill (e.g. /play or /247)
                                Rectangle {
                                    background: #5865f233;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #5865f2;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/terminal.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: #58a6ff;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.active_command_name;
                                            color: #58a6ff;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/x.svg");
                                                width: 10px;
                                                height: 10px;
                                                colorize: close_cmd_ta.has-hover ? #ffffff : #949ba4;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                    close_cmd_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active_command_name = "";
                                            root.command_arg_text = "";
                                        }
                                    }
                                }

                                // Parameter Pill (e.g. [query] or [song] or [volume])
                                if root.active_param_name != "" : Rectangle {
                                    background: #232428;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #3f4147;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/param.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: #5865f2;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.active_param_name + ":";
                                            color: #5865f2;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Value Input
                                msg_arg_input := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.command_arg_text;
                                    placeholder-text: root.active_param_name != "" ? (root.active_param_desc != "" ? root.active_param_desc : "Digite o valor para " + root.active_param_name + "...") : "Pressione Enter ou Enviar para executar " + root.active_command_name + "...";
                                    accepted => {
                                        root.execute_active_command(
                                            root.active_command_name,
                                            root.command_arg_text,
                                            root.active_command_app_id,
                                            root.active_command_cmd_id,
                                            root.active_command_version,
                                            root.active_param_name
                                        );
                                        root.active_command_name = "";
                                        root.command_arg_text = "";
                                    }
                                }
                            }

                            if root.active_command_name == "" : Rectangle {
                                horizontal-stretch: 1;
                                background: #1e1f22;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: chat_text_input.has-focus ? #5865f2 : #383a40;
                                clip: true;

                                if root.chat_input_text == "" : Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text: root.tr_chat_placeholder_prefix + root.active_channel_name + "...";
                                    color: #80848e;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                }

                                chat_text_input := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text <=> root.chat_input_text;
                                    color: #dbdee1;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    key-pressed(event) => {
                                        if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                            if (event.text == Key.UpArrow) {
                                                root.move_suggestion_up();
                                                return accept;
                                            }
                                            if (event.text == Key.DownArrow) {
                                                root.move_suggestion_down();
                                                return accept;
                                            }
                                            if (event.text == Key.Tab) {
                                                root.select_suggestion(root.active_suggestion_index);
                                                return accept;
                                            }
                                            if (event.text == Key.Escape) {
                                                root.show_command_suggestions = false;
                                                return accept;
                                            }
                                        }
                                        reject
                                    }
                                    edited => {
                                        root.active_suggestion_index = 0;
                                        root.handle_input_change(self.text);
                                    }
                                    accepted => {
                                        if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                            root.select_suggestion(root.active_suggestion_index);
                                        } else if (root.chat_input_text != "") {
                                            root.send_message(root.chat_input_text);
                                            root.chat_input_text = "";
                                            root.show_command_suggestions = false;
                                        }
                                    }
                                }
                            }

                            Button {
                                text: root.tr_send;
                                primary: true;
                                clicked => {
                                    if (root.active_command_name != "") {
                                        root.execute_active_command(
                                            root.active_command_name,
                                            root.command_arg_text,
                                            root.active_command_app_id,
                                            root.active_command_cmd_id,
                                            root.active_command_version,
                                            root.active_param_name
                                        );
                                        root.active_command_name = "";
                                        root.command_arg_text = "";
                                    } else if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                        root.select_suggestion(root.active_suggestion_index);
                                    } else if (root.chat_input_text != "") {
                                        root.send_message(root.chat_input_text);
                                        root.chat_input_text = "";
                                        root.show_command_suggestions = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Popup Overlay for Voice & Audio Settings (Discord Style)
    if root.show_settings_modal: Rectangle {
        background: #000000bb;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 580px;
            height: Math.min(560px, parent.height - 40px);
            background: #2b2d31;
            border-radius: 12px;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                // Header Title & Close Button
                HorizontalBox {
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/settings.svg");
                            width: 20px;
                            height: 20px;
                        }
                        Text {
                            text: root.tr_settings_title;
                            color: #f2f3f5;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        icon: @image-url("../assets/x.svg");
                        text: root.tr_leave;
                        clicked => { root.close_settings(); }
                    }
                }

                // Scrollable Settings Content Body
                ScrollView {
                    vertical-stretch: 1;

                    VerticalBox {
                        padding-right: 6px;
                        spacing: 12px;

                        // 0. Language Selector (Idioma / Language)
                        HorizontalLayout {
                            spacing: 6px;
                            Image {
                                source: @image-url("../assets/globe.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #5865f2;
                            }
                            Text {
                                text: root.tr_settings_language_label;
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 105px;
                            background: #1e1f22;
                            border-radius: 8px;

                            ScrollView {
                                height: 100%;
                                width: 100%;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for lang in root.languages: Rectangle {
                                        height: 30px;
                                        background: lang.is_selected ? #35373c : #2b2d31;
                                        border-radius: 6px;

                                        HorizontalBox {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: lang.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                width: 14px;
                                                height: 14px;
                                            }

                                            Text {
                                                text: lang.name;
                                                color: lang.is_selected ? #5865f2 : #dbdee1;
                                                font-size: 12px;
                                                font-weight: lang.is_selected ? 700 : 400;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            Text {
                                                text: lang.native_name;
                                                color: #80848e;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.change_language(lang.code); }
                                        }
                                    }
                                }
                            }
                        }

                        // 1. Microphone Input Device Selection
                        HorizontalLayout {
                            spacing: 6px;
                            Image {
                                source: @image-url("../assets/microphone.svg");
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                text: root.tr_settings_input_device;
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 95px;
                            background: #1e1f22;
                            border-radius: 8px;

                            ScrollView {
                                height: 100%;
                                width: 100%;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for dev in root.input_devices: Rectangle {
                                        height: 30px;
                                        background: dev.is_selected ? #35373c : #2b2d31;
                                        border-radius: 6px;

                                        HorizontalBox {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                width: 14px;
                                                height: 14px;
                                            }

                                            Text {
                                                text: dev.name;
                                                color: dev.is_selected ? #5865f2 : #dbdee1;
                                                font-size: 12px;
                                                font-weight: dev.is_selected ? 700 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.select_input_device(dev.name); }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Speaker / Headphone Output Device Selection
                        HorizontalLayout {
                            spacing: 6px;
                            Image {
                                source: @image-url("../assets/headphones.svg");
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                text: root.tr_settings_output_device;
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 95px;
                            background: #1e1f22;
                            border-radius: 8px;

                            ScrollView {
                                height: 100%;
                                width: 100%;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for dev in root.output_devices: Rectangle {
                                        height: 30px;
                                        background: dev.is_selected ? #35373c : #2b2d31;
                                        border-radius: 6px;

                                        HorizontalBox {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                width: 14px;
                                                height: 14px;
                                            }

                                            Text {
                                                text: dev.name;
                                                color: dev.is_selected ? #5865f2 : #dbdee1;
                                                font-size: 12px;
                                                font-weight: dev.is_selected ? 700 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.select_output_device(dev.name); }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. VAD Threshold Control Slider
                        HorizontalBox {
                            HorizontalLayout {
                                spacing: 6px;
                                Image {
                                    source: @image-url("../assets/microphone.svg");
                                    width: 14px;
                                    height: 14px;
                                }
                                Text {
                                    text: root.tr_settings_threshold;
                                    color: #b5bac1;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // High-visibility Percentage Badge
                            Rectangle {
                                background: #5865f2;
                                border-radius: 4px;
                                height: 18px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: Math.round(root.vad_threshold * 100) + "%";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;

                            Text {
                                text: "0%";
                                color: #80848e;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0.0;
                                maximum: 0.40;
                                value: root.vad_threshold;
                                changed(val) => {
                                    root.vad_threshold = val;
                                    root.set_vad_threshold(val);
                                }
                            }

                            Text {
                                text: "40%";
                                color: #80848e;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // 4. Mic Level Test Indicator Bar (Dynamic Real-Time Level & Threshold Marker)
                        HorizontalBox {
                            HorizontalLayout {
                                spacing: 6px;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 14px;
                                    height: 14px;
                                }
                                Text {
                                    text: root.tr_settings_mic_level;
                                    color: #b5bac1;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.mic_level >= root.vad_threshold 
                                    ? "VOICE ACTIVE (" + Math.round(root.mic_level * 100) + "% / Lim: " + Math.round(root.vad_threshold * 100) + "%)" 
                                    : "SILENCE (" + Math.round(root.mic_level * 100) + "% / Lim: " + Math.round(root.vad_threshold * 100) + "%)";
                                color: root.mic_level >= root.vad_threshold ? #23a55a : #949ba4;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            background: #1e1f22;
                            border-radius: 6px;

                            // Active Mic Volume Fill
                            HorizontalBox {
                                padding: 3px;
                                spacing: 0px;

                                Rectangle {
                                    width: root.mic_level <= 0.01 ? 0px : Math.max(2px, (root.mic_level * 460) * 1px);
                                    height: 14px;
                                    background: root.mic_level >= root.vad_threshold ? #23a55a : #f0b232;
                                    border-radius: 4px;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            // Threshold position indicator marker line
                            Rectangle {
                                x: (root.vad_threshold * 460) * 1px;
                                y: 0px;
                                width: 2px;
                                height: 20px;
                                background: #ffffff;
                            }
                        }

                        // 5. Section: Version & Auto-Updates
                        VerticalBox {
                            spacing: 8px;
                            padding: 0px;

                            Text {
                                text: "VERSÃO E ATUALIZAÇÕES";
                                color: #949ba4;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            Rectangle {
                                background: #1e1f22;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #383a40;

                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Litecord";
                                                color: #f2f3f5;
                                                font-size: 13px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                background: #5865f233;
                                                border-radius: 4px;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    padding-top: 2px;
                                                    padding-bottom: 2px;
                                                    Text {
                                                        text: root.app_version;
                                                        color: #5865f2;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                    }
                                                }
                                            }
                                        }

                                        if root.update_check_feedback != "": Text {
                                            text: root.update_check_feedback;
                                            color: #23a55a;
                                            font-size: 11px;
                                        }
                                    }

                                    Button {
                                        text: root.is_checking_update ? "Verificando..." : "Verificar Atualizações";
                                        enabled: !root.is_checking_update;
                                        clicked => { root.check_for_updates(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // 6. Pinned Footer Action Bar (Always Visible!)
                HorizontalBox {
                    spacing: 10px;

                    Button {
                        text: root.is_testing_mic ? root.tr_settings_btn_test_stop : root.tr_settings_btn_test_start;
                        primary: root.is_testing_mic;
                        clicked => { root.toggle_test_mic(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: root.tr_settings_done;
                        primary: true;
                        clicked => { root.close_settings(); }
                    }
                }
            }
        }
    }

    // Small Centered Logout Confirmation Modal
    if root.show_user_menu: Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => { root.show_user_menu = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 280px;
                    height: 135px;
                    background: #2b2d31;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #383a40;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000088;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.tr_logout_title;
                            color: #f2f3f5;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.tr_logout_confirm_prefix + root.user_tag + "?";
                            color: #b5bac1;
                            font-size: 12px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        HorizontalBox {
                            spacing: 8px;
                            padding: 0px;

                            // Voltar Button
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                background: back_touch.has-hover ? #3b3e45 : #35373c;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.tr_cancel;
                                        color: #dbdee1;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                back_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = false;
                                    }
                                }
                            }

                            // Sair Button (Danger Red / Logout)
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                background: logout_btn_touch.has-hover ? #c0353b : #da373c;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/log-out.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #ffffff;
                                            image-fit: contain;
                                        }
                                    }

                                    Text {
                                        text: root.tr_confirm_logout;
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                logout_btn_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = false;
                                        root.logout();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Window Drag Resize Borders & Corner Handles (on PointerEventKind.down for 0-latency instant resize)
    // Left edge
    if root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge
    if root.drag_area_enabled: TouchArea {
        x: parent.width - 7px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge
    if root.drag_area_enabled: TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    if root.drag_area_enabled: TouchArea {
        x: 12px;
        y: parent.height - 7px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    if root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Top-Right Corner
    if root.drag_area_enabled: TouchArea {
        x: parent.width - 12px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }
    // Bottom-Left Corner
    if root.drag_area_enabled: TouchArea {
        x: 0px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    if root.drag_area_enabled: TouchArea {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }

    // Modal Update Available Dialog
    if root.show_update_dialog: Rectangle {
        background: #000000aa;
        width: 100%;
        height: 100%;
        z: 9999;

        TouchArea {
            // Block background click events
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 440px;
                    background: #2b2d31;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #383a40;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000099;

                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;

                        // Header Icon and Title
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;

                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: #5865f222;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../assets/rocket.svg");
                                    width: 20px;
                                    height: 20px;
                                    colorize: #5865f2;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Nova Atualização Disponível! 🚀";
                                    color: #f2f3f5;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Litecord " + root.update_version;
                                    color: #23a55a;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Body Description
                        Text {
                            text: root.is_updating ? root.update_status_text : "Uma nova versão do Litecord com melhorias e correções está pronta para instalação. Deseja atualizar agora?";
                            color: #b5bac1;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        // Progress Bar (when downloading)
                        if root.is_updating: VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 8px;
                                background: #1e1f22;
                                border-radius: 4px;
                                clip: true;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    height: 8px;
                                    width: root.update_progress * parent.width;
                                    background: #23a55a;
                                    border-radius: 4px;
                                }
                            }

                            Text {
                                text: Math.round(root.update_progress * 100) + "%";
                                color: #80848e;
                                font-size: 11px;
                                horizontal-alignment: right;
                            }
                        }

                        // Action Buttons
                        if !root.is_updating: HorizontalLayout {
                            spacing: 10px;

                            // Não Mostrar Mais (Ignore)
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: ignore_touch.has-hover ? #35373c : #2b2d31;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #3f4147;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Não mostrar mais";
                                        color: #949ba4;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                ignore_touch := TouchArea {
                                    clicked => { root.update_app_ignore(); }
                                }
                            }

                            // Lembrar Depois (Não)
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: dismiss_touch.has-hover ? #3b3e45 : #35373c;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Lembrar Depois";
                                        color: #dbdee1;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                dismiss_touch := TouchArea {
                                    clicked => { root.update_app_dismiss(); }
                                }
                            }

                            // Sim, Atualizar
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: accept_touch.has-hover ? #4752c4 : #5865f2;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "Sim, Atualizar";
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                accept_touch := TouchArea {
                                    clicked => { root.update_app_accept(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // DISCORD-STYLE SCREEN SHARE SELECTION MODAL
    // ==========================================
    if root.show_stream_modal: Rectangle {
        background: #000000aa;
        width: 100%;
        height: 100%;

        // Dismiss when clicking outer backdrop
        TouchArea {
            clicked => { root.show_stream_modal = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 500px;
                    background: #313338;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #383a40;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000099;
                    clip: true;

                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;

                        // 1. Modal Header
                        Rectangle {
                            height: 52px;
                            background: #313338;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Compartilhe sua tela";
                                        color: #f2f3f5;
                                        font-size: 16px;
                                        font-weight: 700;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: close_modal_ta.has-hover ? #35373c : transparent;

                                        Image {
                                            source: @image-url("../assets/chrome-close.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: #b5bac1;
                                            image-fit: contain;
                                        }

                                        close_modal_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_stream_modal = false; }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Tabs Bar (Captura de Tela vs Captura de Janela)
                        Rectangle {
                            height: 38px;
                            background: #2b2d31;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 24px;

                                // Tab: Telas (Captura de Tela)
                                Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/monitor.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "screens" ? #ffffff : #949ba4;
                                            }
                                            Text {
                                                text: root.is_linux ? "Telas / Janelas" : "Telas";
                                                color: root.stream_source_tab == "screens" ? #ffffff : #949ba4;
                                                font-size: 13px;
                                                font-weight: root.stream_source_tab == "screens" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "screens": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: #5865f2;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "screens";
                                            root.stream_selected_source_index = 0;
                                            root.stream_selected_window_id = "";
                                        }
                                    }
                                }

                                // Tab: Janelas (Captura de Janela apenas no Windows)
                                if !root.is_linux: Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/window.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "windows" ? #ffffff : #949ba4;
                                            }
                                            Text {
                                                text: "Janelas";
                                                color: root.stream_source_tab == "windows" ? #ffffff : #949ba4;
                                                font-size: 13px;
                                                font-weight: root.stream_source_tab == "windows" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "windows": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: #5865f2;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "windows";
                                            root.stream_selected_source_index = 0;
                                            if root.available_windows.length > 0 {
                                                root.stream_selected_window_id = root.available_windows[0].id;
                                            }
                                        }
                                    }
                                }

                                // Tab: Câmera (Webcam)
                                Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/camera.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "cameras" ? #ffffff : #949ba4;
                                            }
                                            Text {
                                                text: "Câmera";
                                                color: root.stream_source_tab == "cameras" ? #ffffff : #949ba4;
                                                font-size: 13px;
                                                font-weight: root.stream_source_tab == "cameras" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "cameras": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: #5865f2;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "cameras";
                                            root.stream_selected_source_index = 0;
                                            root.stream_include_audio = false;
                                            if root.available_cameras.length > 0 {
                                                root.stream_selected_camera_id = root.available_cameras[0].id;
                                            }
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        // 3. Source Selection Preview Area
                        VerticalBox {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 14px;

                            // Source Cards (Telas vs Janelas)
                            if root.stream_source_tab == "screens": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for scr[idx] in root.available_screens: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? #5865f222 : #2b2d31;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? #5865f2 : #383a40;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            // Screen Illustration Box
                                            Rectangle {
                                                height: 52px;
                                                background: #1e1f22;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? #5865f288 : #383a40;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/monitor.svg");
                                                            width: 24px;
                                                            height: 24px;
                                                            colorize: root.stream_selected_source_index == idx ? #5865f2 : #80848e;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: root.is_linux ? "Tela / Janela" : scr.name;
                                                color: root.stream_selected_source_index == idx ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: root.is_linux ? "Portal nativo do sistema" : scr.resolution;
                                                color: #80848e;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_window_id = "";
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.is_linux && root.stream_source_tab == "windows": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for win[idx] in root.available_windows: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? #5865f222 : #2b2d31;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? #5865f2 : #383a40;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                height: 52px;
                                                background: #1e1f22;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? #5865f288 : #383a40;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: win.has_icon ? win.icon_image : (win.app_name == "Litecord" ? @image-url("../assets/app_icon.png") : (win.app_name == "Google Chrome" ? @image-url("../assets/globe.svg") : @image-url("../assets/window.svg")));
                                                            width: 28px;
                                                            height: 28px;
                                                            colorize: win.has_icon || win.app_name == "Litecord" ? transparent : (root.stream_selected_source_index == idx ? #5865f2 : #80848e);
                                                            image-fit: contain;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: win.title;
                                                color: root.stream_selected_source_index == idx ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: win.app_name;
                                                color: #80848e;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_window_id = win.id;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "cameras": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for cam[idx] in root.available_cameras: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? #5865f222 : #2b2d31;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? #5865f2 : #383a40;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                height: 52px;
                                                background: #1e1f22;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? #5865f288 : #383a40;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/camera.svg");
                                                            width: 24px;
                                                            height: 24px;
                                                            colorize: root.stream_selected_source_index == idx ? #5865f2 : #80848e;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: cam.name;
                                                color: root.stream_selected_source_index == idx ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: "Webcam";
                                                color: #80848e;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_camera_id = cam.id;
                                            }
                                        }
                                    }

                                    if root.available_cameras.length == 0: Rectangle {
                                        width: 440px;
                                        height: 110px;
                                        background: #2b2d31;
                                        border-radius: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: "Nenhuma câmera / webcam detectada no sistema.";
                                                color: #949ba4;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // 4. Stream Quality Section (Displayed ONLY for Screens and Windows, as Cameras use their optimal native sensor stream)
                            if root.stream_source_tab != "cameras": Text {
                                text: "QUALIDADE DA TRANSMISSÃO";
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 800;
                            }

                            // Resolution Selection (1080p, 720p, 480p)
                            if root.stream_source_tab != "cameras": VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                Text {
                                    text: "RESOLUÇÃO";
                                    color: #949ba4;
                                    font-size: 10px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    // 1080p (1920x1080)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "1080p" ? #5865f2 : (res_1080_ta.has-hover ? #35373c : #2b2d31);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "1080p" ? #5865f2 : #383a40;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "1080p (1920×1080)";
                                                color: root.stream_selected_res == "1080p" ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_1080_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "1080p"; }
                                        }
                                    }

                                    // 720p (1280x720)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "720p" ? #5865f2 : (res_720_ta.has-hover ? #35373c : #2b2d31);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "720p" ? #5865f2 : #383a40;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "720p (1280×720)";
                                                color: root.stream_selected_res == "720p" ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_720_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "720p"; }
                                        }
                                    }

                                    // 480p (854x480)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "480p" ? #5865f2 : (res_480_ta.has-hover ? #35373c : #2b2d31);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "480p" ? #5865f2 : #383a40;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "480p (854×480)";
                                                color: root.stream_selected_res == "480p" ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_480_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "480p"; }
                                        }
                                    }
                                }
                            }

                            // Framerate Selection (60 FPS, 30 FPS, 15 FPS)
                            if root.stream_source_tab != "cameras": VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                Text {
                                    text: "TAXA DE QUADROS (FPS)";
                                    color: #949ba4;
                                    font-size: 10px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    // 60 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 60 ? #5865f2 : (fps_60_ta.has-hover ? #35373c : #2b2d31);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 60 ? #5865f2 : #383a40;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "60 FPS";
                                                color: root.stream_selected_fps == 60 ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_60_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 60; }
                                        }
                                    }

                                    // 30 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 30 ? #5865f2 : (fps_30_ta.has-hover ? #35373c : #2b2d31);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 30 ? #5865f2 : #383a40;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "30 FPS";
                                                color: root.stream_selected_fps == 30 ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_30_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 30; }
                                        }
                                    }

                                    // 15 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 15 ? #5865f2 : (fps_15_ta.has-hover ? #35373c : #2b2d31);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 15 ? #5865f2 : #383a40;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "15 FPS";
                                                color: root.stream_selected_fps == 15 ? #ffffff : #dbdee1;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_15_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 15; }
                                        }
                                    }
                                }
                            }

                            // Camera Info Note (Single sleek note only when cameras exist)
                            if root.stream_source_tab == "cameras" && root.available_cameras.length > 0: Rectangle {
                                background: #2b2d31;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #383a40;
                                height: 44px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/camera.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: #5865f2;
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "A webcam transmitirá utilizando a resolução e taxa nativas do seu dispositivo.";
                                            color: #949ba4;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }

                            // 5. Stream Audio Toggle Section (Disabled/informational for Cameras)
                            if root.stream_source_tab != "cameras": Rectangle {
                                background: #2b2d31;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #383a40;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: root.stream_include_audio ? @image-url("../assets/speaker.svg") : @image-url("../assets/volume-x.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: root.stream_include_audio ? #5865f2 : #80848e;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "Transmitir Áudio do Computador / Janela";
                                                color: #f2f3f5;
                                                font-size: 12px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Inclui o som do aplicativo ou jogo durante a transmissão";
                                                color: #949ba4;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    // Switch Toggle Button
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 40px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: root.stream_include_audio ? #23a55a : #4e5058;

                                            // Knob
                                            Rectangle {
                                                x: root.stream_include_audio ? 20px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: #ffffff;
                                                animate x { duration: 150ms; easing: ease-out; }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.stream_include_audio = !root.stream_include_audio;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "cameras": Rectangle {
                                background: #2b2d31;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #383a40;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/camera.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: #5865f2;
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Transmissão Direta de Câmera";
                                            color: #f2f3f5;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Apenas vídeo da webcam (sem captura de áudio do sistema)";
                                            color: #949ba4;
                                            font-size: 10px;
                                        }
                                    }
                                }
                            }
                        }

                        // 6. Pinned Modal Footer Action Bar
                        Rectangle {
                            height: 60px;
                            background: #2b2d31;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 12px;
                                alignment: space-between;

                                // Cancelar Button
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 4px;
                                        background: modal_cancel_ta.has-hover ? #35373c : transparent;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: "Cancelar";
                                                color: #dbdee1;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }

                                        modal_cancel_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_stream_modal = false; }
                                        }
                                    }
                                }

                                // Transmitir Button
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 4px;
                                        background: modal_start_ta.has-hover ? #4752c4 : #5865f2;

                                        HorizontalLayout {
                                            alignment: center;
                                            padding-left: 18px;
                                            padding-right: 18px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: root.stream_source_tab == "cameras" ? @image-url("../assets/camera.svg") : (root.stream_source_tab == "windows" ? @image-url("../assets/window.svg") : @image-url("../assets/monitor.svg"));
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: #ffffff;
                                                    image-fit: contain;
                                                }
                                            }

                                            Text {
                                                text: "Transmitir";
                                                color: #ffffff;
                                                font-size: 13px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        modal_start_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.show_stream_modal = false;
                                                root.toggle_screen_share();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Popout Detached Video Window Component
export component PopoutStreamWindow inherits Window {
    title: "Litecord - Transmissão Desanexada";
    no-frame: true;
    background: #111214;
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 320px;
    min-height: 180px;
    default-font-family: "Segoe UI, Segoe UI Emoji, Segoe UI Symbol, sans-serif";

    // Visual boundary border
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: #2b2d31;
    }

    in-out property <image> stream_frame;
    in-out property <string> username: "Transmissão";
    in-out property <string> user_id: "";
    in-out property <string> stream_fps: "";
    in-out property <float> stream_volume: 1.0;
    in-out property <bool> is_pinned: false;
    in-out property <bool> is_intangible: false;
    in-out property <bool> show_controls: true;
    in-out property <bool> is_maximized: false;
    in-out property <bool> drag_area_enabled: true;
    in-out property <bool> is_linux: false;

    callback toggle_pin();
    callback toggle_intangible();
    callback start_window_drag();
    callback toggle_fullscreen();
    callback close_popout();
    callback minimize_popout();
    callback drag_resize(string);
    callback mouse_activity();
    callback stream_volume_changed(string, float);

    // Global mouse activity tracker
    TouchArea {
        pointer-event(event) => {
            root.mouse_activity();
        }
    }

    // Video Canvas Viewport
    Image {
        width: 100%;
        height: 100%;
        source: root.stream_frame;
        image-fit: contain;
    }

    // Top Autohiding Controls Bar (Discord Floating Overlay Style)
    if root.show_controls: Rectangle {
        y: 8px;
        x: 8px;
        width: parent.width - 16px;
        height: 38px;
        background: #111214e6;
        border-radius: 8px;
        border-width: 1px;
        border-color: #2b2d31cc;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000088;

        // Background Drag Handle (placed first so buttons on top receive clicks!)
        if root.drag_area_enabled: TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                root.mouse_activity();
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.start_window_drag();
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // Left Side: Live Badge & Username Pill & Dynamic Volume Slider (Vertically Centered)
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Live Badge
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: #f23f43;
                        border-radius: 4px;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #ffffff;
                                }
                            }
                            Text {
                                text: "AO VIVO";
                                color: #ffffff;
                                font-size: 10px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // FPS Counter Badge (Local)
                if root.stream_fps != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: #23a55a22;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #23a55a;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #23a55a;
                                }
                            }
                            Text {
                                text: root.stream_fps;
                                color: #23a55a;
                                font-size: 10px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Stream Username & Tag
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.username;
                        color: #f2f3f5;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Dynamic Volume Slider (only shown if popout width has enough space > 380px)
                if root.width > 380px : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.stream_volume <= 0.01 ? @image-url("../assets/volume-x.svg") : @image-url("../assets/speaker.svg");
                            width: 13px;
                            height: 13px;
                            colorize: root.stream_volume <= 0.01 ? #f23f43 : #949ba4;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 65px;
                            height: 6px;
                            background: #35373c;
                            border-radius: 3px;

                            // Volume fill bar
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * (root.stream_volume.clamp(0.0, 1.0));
                                height: 100%;
                                background: root.stream_volume <= 0.01 ? #f23f43 : #5865f2;
                                border-radius: 3px;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                    root.stream_volume = new_vol;
                                    root.stream_volume_changed(root.user_id, new_vol);
                                }
                                moved => {
                                    if self.pressed {
                                        let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                        root.stream_volume = new_vol;
                                        root.stream_volume_changed(root.user_id, new_vol);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "\{Math.round(root.stream_volume * 100)}%";
                            color: #949ba4;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right Side: Window Control Action Buttons (Vertically Centered)
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                // Intangible / Click-Through Ghost Mode Toggle (Left of Pin)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.is_intangible ? #23a55a : (pop_ghost_ta.has-hover ? #35373c : transparent);

                        Image {
                            source: @image-url("../assets/ghost.svg");
                            width: 13px;
                            height: 13px;
                            colorize: root.is_intangible ? #ffffff : (pop_ghost_ta.has-hover ? #ffffff : #dbdee1);
                            image-fit: contain;
                        }

                        pop_ghost_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_intangible(); }
                        }
                    }
                }

                // Pin / Always-On-Top Toggle Button (Left of Minimize)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.is_pinned ? #5865f2 : (pop_pin_ta.has-hover ? #35373c : transparent);

                        Image {
                            source: @image-url("../assets/pin.svg");
                            width: 12px;
                            height: 12px;
                            colorize: root.is_pinned ? #ffffff : (pop_pin_ta.has-hover ? #ffffff : #dbdee1);
                            image-fit: contain;
                        }

                        pop_pin_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_pin(); }
                        }
                    }
                }

                // Minimize Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_min_ta.has-hover ? #35373c : transparent;

                        Image {
                            source: @image-url("../assets/chrome-minimize.svg");
                            width: 12px;
                            height: 12px;
                            colorize: #dbdee1;
                            image-fit: contain;
                        }

                        pop_min_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.minimize_popout(); }
                        }
                    }
                }

                // Fullscreen / Maximize Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_fs_ta.has-hover ? #35373c : transparent;

                        Image {
                            source: root.is_maximized ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                            width: 12px;
                            height: 12px;
                            colorize: #dbdee1;
                            image-fit: contain;
                        }

                        pop_fs_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_fullscreen(); }
                        }
                    }
                }

                // Close / Re-attach Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_close_ta.has-hover ? #f23f43 : transparent;

                        Image {
                            source: @image-url("../assets/chrome-close.svg");
                            width: 12px;
                            height: 12px;
                            colorize: pop_close_ta.has-hover ? #ffffff : #dbdee1;
                            image-fit: contain;
                        }

                        pop_close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_popout(); }
                        }
                    }
                }
            }
        }
    }

    // Window Drag Resize Borders & Corner Handles (0-latency hardware resize)
    // Left edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 12px;
        width: 8px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 8px;
        y: 12px;
        width: 8px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: parent.height - 8px;
        width: parent.width - 24px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 0px;
        width: 14px;
        height: 14px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Top-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 14px;
        y: 0px;
        width: 14px;
        height: 14px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }
    // Bottom-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 14px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }
}

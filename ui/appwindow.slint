    callback toggle_proxy_route_media();

    // QR Code Login Properties
    in-out property <image> qr_code_image;
    in-out property <bool> has_qr_code: false;
    in-out property <bool> is_qr_loading: false;
    in-out property <string> qr_scanned_user: "";

    // Properties exposed to Rust backend
    in-out property <bool> is_logged_in: false;
    in-out property <string> connection_status: "Aguardando Token de Acesso...";
    in-out property <string> user_tag: "Não conectado";

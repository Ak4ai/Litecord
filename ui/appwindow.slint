                                                        vertical-alignment: center;
                                                    }

                                                    Slider {
                                                        horizontal-stretch: 1;
                                                        minimum: 0.0;
                                                        maximum: 1.0;
                                                        value: root.vad_threshold;
                                                        changed(val) => {
                                                            root.vad_threshold = val;
                                                            root.set_vad_threshold(val);
                                                        }
                                                    }

                                                    Text {
                                                        text: "100%";
                                                        color: AppTheme.text-subtle;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3, clean without card)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/speaker.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.success;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Sensibilidade (VAD)";
                                                        color: AppTheme.success;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Text {
                                                    text: "Fale normalmente. Ajuste o controle para que sua voz ultrapasse a marca branca, mas ruídos como teclado mecânico e respiração fiquem abaixo.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Horizontal Row Separator
                                        Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                        // --- ROW 5: VU METER & TEST MIC + GUIDE ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 8px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/speaker.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.tr_settings_mic_level;
                                                        color: AppTheme.text-secondary;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }

                                                    Rectangle { horizontal-stretch: 1; }

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: center;

                                                        Rectangle {
                                                    background: root.mic_level >= root.vad_threshold ? AppTheme.success-faint : AppTheme.surface-sidebar;
                                                            border-radius: 4px;
                                                            border-width: 1px;
                                                            border-color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.border-subtle;
                                                            height: 18px;
                                                            width: 68px;

                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Text {
                                                                    text: root.mic_level >= root.vad_threshold ? "ATIVO" : "SILÊNCIO";
                                                                    color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.text-muted;
                                                                    font-size: 10px;
                                                                    font-weight: 700;
                                                                    vertical-alignment: center;
                                                                    horizontal-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        Text {
                                                            width: 36px;
                                                            horizontal-alignment: right;
                                                            text: Math.round(root.mic_level * 100) + "%";
                                                            color: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                Rectangle {
                                                    height: 22px;
                                                    background: AppTheme.surface-input;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: AppTheme.border-subtle;
                                                    clip: true;

                                                    // Active Volume Level Fill
                                                    Rectangle {
                                                        x: 3px;
                                                        y: 3px;
                                                        height: parent.height - 6px;
                                                        width: root.mic_level <= 0.005 ? 0px : Math.min(parent.width - 6px, Math.max(2px, (parent.width - 6px) * Math.min(1.0, Math.max(0.0, root.mic_level))));
                                                        background: root.mic_level >= root.vad_threshold ? AppTheme.success : AppTheme.warning;
                                                        border-radius: 4px;
                                                    }

                                                    // Threshold Position Indicator Marker Line
                                                    Rectangle {
                                                        x: Math.min(parent.width - 5px, Math.max(3px, 3px + (parent.width - 6px) * Math.min(1.0, Math.max(0.0, root.vad_threshold))));
                                                        y: 0px;
                                                        width: 2px;
                                                        height: parent.height;
                                                        background: AppTheme.solid-white;
                                                    }
                                                }

                                                HorizontalLayout {
                                                    padding-top: 2px;
                                                    Button {
                                                        icon: root.is_testing_mic ? @image-url("../assets/microphone.svg") : @image-url("../assets/headphones.svg");
                                                        text: root.is_testing_mic ? root.tr_settings_btn_test_stop : root.tr_settings_btn_test_start;
                                                        primary: root.is_testing_mic;
                                                        clicked => { root.toggle_test_mic(); }
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3, clean without card)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/headphones.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.warning;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Teste de Retorno (Loopback)";
                                                        color: AppTheme.warning;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Text {
                                                    text: "Permite escutar a sua voz tratada em tempo real com o filtro do Litecord nos seus fones para calibrar volume e clareza antes das partidas.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Horizontal Row Separator
                                        Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                        // --- ROW 5: SPEECH PRIORITY (DUCKING) + GUIDE ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/crown.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.warning;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Atenuação de Voz Inteligente (Ducking)";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text {
                                                        text: "ATIVO (P:1 a P:5)";
                                                        color: AppTheme.success;
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: "O motor de áudio Opus PLC reduz automaticamente em 12dB o som dos outros membros quando líderes táticos com prioridade falam.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3, clean without card)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/rocket.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Vantagem Competitiva";
                                                        color: AppTheme.accent;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Text {
                                                    text: "Elimina a cacofonia em momentos decisivos de jogos FPS/MOBA, garantindo que callouts críticos se sobressaiam instantaneamente.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Generous Bottom Spacer
                                        Rectangle { height: 16px; }
                                    }

                                    // =============================================================
                                    // TAB 1: IDIOMA / LANGUAGE (OPTIONS AND ACCOMPANYING GUIDE)
                                    // =============================================================
                                    if root.settings_active_tab == 1: VerticalLayout {
                                        spacing: 16px;

                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 8px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/globe.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "SELECIONE O IDIOMA DO CLIENTE";
                                                        color: AppTheme.text-secondary;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Rectangle {
                                                    background: AppTheme.surface-input;
                                                    border-radius: 8px;
                                                    border-width: 1px;
                                                    border-color: AppTheme.border-subtle;

                                                    VerticalLayout {
                                                        padding-top: 8px;
                                                        padding-bottom: 8px;
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        spacing: 4px;

                                                        for lang in root.languages: Rectangle {
                                                            height: 38px;
                                                            background: lang.is_selected ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                                            border-radius: 6px;

                                                            HorizontalLayout {
                                                                padding-left: 12px;
                                                                padding-right: 12px;
                                                                spacing: 10px;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: lang.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                                        width: 16px;
                                                                        height: 16px;
                                                                        image-fit: contain;
                                                                    }
                                                                }

                                                                Text {
                                                                    text: lang.name;
                                                                    color: lang.is_selected ? AppTheme.accent : AppTheme.text-primary;
                                                                    font-size: 13px;
                                                                    font-weight: lang.is_selected ? 700 : 500;
                                                                    vertical-alignment: center;
                                                                }

                                                                Rectangle { horizontal-stretch: 1; }

                                                                Text {
                                                                    text: lang.native_name;
                                                                    color: AppTheme.text-subtle;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                }
                                                            }

                                                            TouchArea {
                                                                clicked => { root.change_language(lang.code); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3, clean without card)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 12px;

                                                VerticalLayout {
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("../assets/globe.svg");
                                                                width: 14px;
                                                                height: 14px;
                                                                colorize: AppTheme.accent;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        Text {
                                                            text: "Troca Instantânea";
                                                            color: AppTheme.accent;
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                    Text {
                                                        text: "A alteração de idioma é aplicada em tempo real em todas as janelas sem necessidade de reiniciar o Litecord.";
                                                        color: AppTheme.text-muted;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                // Horizontal separator between the two guides
                                                Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                                VerticalLayout {
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("../assets/rocket.svg");
                                                                width: 14px;
                                                                height: 14px;
                                                                colorize: AppTheme.success;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        Text {
                                                            text: "Detecção Automática";
                                                            color: AppTheme.success;
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                    Text {
                                                        text: "A opção 'Auto' identifica a região e linguagem padrão do seu sistema operacional (Windows/Linux).";
                                                        color: AppTheme.text-muted;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }

                                        // Generous Bottom Spacer
                                        Rectangle { height: 16px; }
                                    }

                                    // =============================================================
                                    // TAB 2: ATALHOS / KEYBINDS (OPTIONS AND ACCOMPANYING GUIDE)
                                    // =============================================================
                                    if root.settings_active_tab == 2: VerticalLayout {
                                        spacing: 16px;

                                        // --- ROW 1: MUTE / UNMUTE KEYBIND ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 10px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/microphone.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.tr_keybind_mute_title;
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Text {
                                                    text: root.tr_keybind_mute_desc;
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }

                                                HorizontalLayout {
                                                    spacing: 10px;

                                                    // Shortcut Badge Display
                                                    Rectangle {
                                                        background: root.recording_keybind_for == 1 ? AppTheme.surface-warning : AppTheme.surface-input;
                                                        border-radius: 6px;
                                                        border-width: 1px;
                                                        border-color: root.recording_keybind_for == 1 ? AppTheme.warning : AppTheme.border-subtle;
                                                        height: 36px;
                                                        horizontal-stretch: 1;

                                                        HorizontalLayout {
                                                            padding-left: 12px;
                                                            padding-right: 12px;
                                                            spacing: 8px;
                                                            alignment: center;

                                                            Text {
                                                                text: root.recording_keybind_for == 1 ? root.tr_keybind_recording_prompt : (root.keybind_mute_str != "" ? root.keybind_mute_str : "Nenhum / Desativado");
                                                                color: root.recording_keybind_for == 1 ? AppTheme.warning : (root.keybind_mute_str != "" ? AppTheme.text-strong : AppTheme.text-subtle);
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // Record / Set button
                                                    Rectangle {
                                                        width: 120px;
                                                        height: 36px;
                                                        background: root.recording_keybind_for == 1 ? AppTheme.warning : (btn_rec_mute_touch.has-hover ? AppTheme.accent-hover : AppTheme.accent);
                                                        border-radius: 4px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: root.recording_keybind_for == 1 ? "Gravando..." : root.tr_keybind_btn_record;
                                                                color: root.recording_keybind_for == 1 ? AppTheme.text-on-warning : AppTheme.text-on-accent;
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        btn_rec_mute_touch := TouchArea {
                                                            clicked => {
                                                                if root.recording_keybind_for == 1 {
                                                                    root.start_recording_keybind(0);
                                                                } else {
                                                                    root.start_recording_keybind(1);
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Reset / Clear button
                                                    Rectangle {
                                                        width: 80px;
                                                        height: 36px;
                                                        background: btn_clear_mute_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                                        border-radius: 4px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: root.tr_keybind_btn_clear;
                                                                color: AppTheme.text-primary;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        btn_clear_mute_touch := TouchArea {
                                                            clicked => { root.reset_keybind(1); }
                                                        }
                                                    }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/key.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.tr_keybind_guide_title;
                                                        color: AppTheme.accent;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Text {
                                                    text: root.tr_keybind_guide_desc;
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Horizontal Row Separator
                                        Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                        // --- ROW 2: DEAFEN / UNDEAFEN KEYBIND ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 10px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/headphones.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.success;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.tr_keybind_deafen_title;
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Text {
                                                    text: root.tr_keybind_deafen_desc;
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }

                                                HorizontalLayout {
                                                    spacing: 10px;

                                                    // Shortcut Badge Display
                                                    Rectangle {
                                                        background: root.recording_keybind_for == 2 ? AppTheme.surface-warning : AppTheme.surface-input;
                                                        border-radius: 6px;
                                                        border-width: 1px;
                                                        border-color: root.recording_keybind_for == 2 ? AppTheme.warning : AppTheme.border-subtle;
                                                        height: 36px;
                                                        horizontal-stretch: 1;

                                                        HorizontalLayout {
                                                            padding-left: 12px;
                                                            padding-right: 12px;
                                                            spacing: 8px;
                                                            alignment: center;

                                                            Text {
                                                                text: root.recording_keybind_for == 2 ? root.tr_keybind_recording_prompt : (root.keybind_deafen_str != "" ? root.keybind_deafen_str : "Nenhum / Desativado");
                                                                color: root.recording_keybind_for == 2 ? AppTheme.warning : (root.keybind_deafen_str != "" ? AppTheme.text-strong : AppTheme.text-subtle);
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // Record / Set button
                                                    Rectangle {
                                                        width: 120px;
                                                        height: 36px;
                                                        background: root.recording_keybind_for == 2 ? AppTheme.warning : (btn_rec_deaf_touch.has-hover ? AppTheme.success-hover : AppTheme.success);
                                                        border-radius: 4px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Text {
                                                                text: root.recording_keybind_for == 2 ? "Gravando..." : root.tr_keybind_btn_record;
                                                                color: root.recording_keybind_for == 2 ? AppTheme.text-on-warning : AppTheme.text-on-accent;
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        btn_rec_deaf_touch := TouchArea {
                                                            clicked => {
                                                                if root.recording_keybind_for == 2 {
                                                                    root.start_recording_keybind(0);
                                                                } else {
                                                                    root.start_recording_keybind(2);
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Reset / Clear button
                                                    Rectangle {
                                                        width: 80px;

                                                        for dev in root.input_devices: Rectangle {
                                                            height: 38px;
                                                            background: dev.is_selected ? AppTheme.interactive-hover : (dev_in_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                            border-radius: 6px;
                                                            animate background { duration: 120ms; }

                                                            HorizontalLayout {

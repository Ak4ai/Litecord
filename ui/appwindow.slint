                                                            source: @image-url("../assets/headphones.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.tr_settings_output_device;
                                                        color: AppTheme.text-secondary;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }

                                                Rectangle {
                                                    background: AppTheme.surface-input;
                                                    border-radius: 8px;
                                                    border-width: 1px;
                                                    border-color: AppTheme.border-subtle;

                                                    VerticalLayout {
                                                        padding-top: 6px;
                                                        padding-bottom: 6px;
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        spacing: 4px;

                                                        for dev in root.output_devices: Rectangle {
                                                            height: 38px;
                                                            background: dev.is_selected ? AppTheme.interactive-hover : (dev_out_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                            border-radius: 6px;
                                                            animate background { duration: 120ms; }

                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 12px;
                                                                spacing: 10px;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                                        width: 16px;
                                                                        height: 16px;
                                                                        image-fit: contain;
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Text {
                                                                        text: dev.name;
                                                                        color: dev.is_selected ? AppTheme.text-strong : AppTheme.text-primary;
                                                                        font-size: 12px;
                                                                        font-weight: dev.is_selected ? 700 : 500;
                                                                        overflow: elide;
                                                                    }
                                                                }

                                                                Rectangle { horizontal-stretch: 1; }
                                                            }

                                                            dev_out_ta := TouchArea {
                                                                mouse-cursor: pointer;
                                                                clicked => { root.select_output_device(dev.name); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3, clean without card)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/headphones.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {

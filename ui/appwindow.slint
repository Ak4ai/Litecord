                                                            font-size: 13px;
                                                            font-weight: 700;
                                                        }

                                                        Text {
                                                            text: "Exibe a pílula de aviso na pré-visualização própria ao iniciar a transmissão informando sobre a taxa de quadros reduzida para economizar recursos.";

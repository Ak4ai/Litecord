                                        // Horizontal Row Separator
                                        Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                        // --- ROW 3: MICROPHONE INPUT VOLUME (GAIN / AMPLIFICATION 0% TO 200%) + GUIDE ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 8px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/microphone.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "VOLUME DE ENTRADA (GANHO DO MICROFONE)";
                                                        color: AppTheme.text-secondary;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }

                                                    Rectangle { horizontal-stretch: 1; }

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            background: root.mic_volume > 1.05 ? AppTheme.success : AppTheme.accent;
                                                            border-radius: 4px;
                                                            height: 18px;
                                                            width: 48px;

                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Text {
                                                                    text: Math.round(root.mic_volume * 100) + "%";
                                                                    color: AppTheme.text-on-accent;
                                                                    font-size: 11px;
                                                                    font-weight: 700;
                                                                    vertical-alignment: center;
                                                                    horizontal-alignment: center;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 10px;

                                                    Text {
                                                        text: "0%";
                                                        color: AppTheme.text-subtle;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }

                                                    Slider {
                                                        horizontal-stretch: 1;
                                                        minimum: 0.0;
                                                        maximum: 2.0;
                                                        value: root.mic_volume;
                                                        changed(val) => {
                                                            root.mic_volume = val;
                                                            root.set_mic_volume(val);
                                                        }
                                                    }

                                                    Text {
                                                        text: "200%";
                                                        color: AppTheme.text-subtle;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }

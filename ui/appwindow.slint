    in-out property <image> remote_stream_frame;
    in-out property <bool> is_stream_fullscreen: false;
    in-out property <string> focused_stream_uid: "";
    in-out property <string> tr_start_screen_share: "Transmitir";
    in-out property <string> tr_stop_screen_share: "Parar Transmissão";
    in-out property <string> tr_watching_stream: "Assistindo Transmissão";
    in-out property <string> tr_live_badge: "AO VIVO";
    in-out property <string> tr_stream_quality: "720p 30fps";
    in-out property <string> local_preview_fps: "";
    in-out property <string> remote_stream_fps: "";
    in-out property <float> stream_remote_volume: 1.0;
    in-out property <bool> is_popout_intangible: false;
    in-out property <bool> is_maximized: false;
    callback set_stream_volume(string, float);
    callback toggle_popout_intangible();

    in-out property <[GuildItem]> guilds: [];
    in-out property <[ChannelItem]> channels: [];
    in-out property <[ChatMessage]> messages: [
        { author: "Litecord System", timestamp: "Agora", content: "Bem-vindo ao Litecord! Seus servidores carregarão na barra lateral à esquerda." }
    ];

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Status Header Bar (Frameless Custom Titlebar)
        Rectangle {
            height: 32px;
            background: AppTheme.surface-titlebar;

            if root.drag_area_enabled: TouchArea {
                width: parent.width - 150px;
                height: 100%;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.drag_window();
                    }
                }
            }

            HorizontalBox {
                padding-left: 12px;
                padding-right: 146px;
                padding-top: 0px;
                padding-bottom: 0px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/app_icon.png");
                                width: 16px;
                                height: 16px;
                                colorize: AppTheme.text-strong;
                                image-fit: contain;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "LITECORD";
                                color: AppTheme.text-strong;
                                font-weight: 800;
                                font-size: 13px;
                            }
                        }

                        // Versioning string aligned right next to LITECORD
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.app_version;
                                color: AppTheme.text-muted;
                                font-weight: 600;
                                font-size: 11px;
                            }
                        }

                        // Discretely show active connection/system error when logged in
                        if root.titlebar_error != "" && root.is_logged_in: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: "-";
                                    color: AppTheme.danger;
                                    font-weight: 700;
                                    font-size: 11px;
                                }
                                Text {
                                    text: root.titlebar_error;
                                    color: AppTheme.danger;
                                    font-weight: 600;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            // Custom Window Control Buttons (Hardware Monitor HUD, Settings, Minimize, Maximize, Close)
            HorizontalLayout {
                x: parent.width - (root.show_hardware_monitor ? 390px : 176px);
                y: 0px;
                width: root.show_hardware_monitor ? 390px : 176px;
                height: 32px;
                spacing: 0px;

                // Hardware Monitor HUD (CPU / RAM / GPU) - Centered vertically & matching app theme
                if root.show_hardware_monitor: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-right: 8px;

                        // CPU
                        Text {
                            text: root.hardware_cpu_text;
                            color: root.hardware_cpu_val > 85 ? AppTheme.danger : AppTheme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "•";
                            color: AppTheme.surface-control;
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        // RAM
                        Text {
                            text: root.hardware_ram_text;
                            color: root.hardware_ram_val > 500 ? AppTheme.danger : AppTheme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "•";
                            color: AppTheme.surface-control;
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        // GPU
                        Text {
                            text: root.hardware_gpu_text;
                            color: root.hardware_gpu_val > 90 ? AppTheme.danger : AppTheme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // Settings (Accessible on login and main window)
                Rectangle {
                    width: 38px;
                    height: 32px;
                    background: sett_title_touch.has-hover ? AppTheme.surface-sidebar : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/settings.svg");
                                width: 14px;
                                height: 14px;
                                colorize: sett_title_touch.has-hover ? AppTheme.text-strong : AppTheme.text-muted;
                                image-fit: contain;
                            }
                        }
                    }

                    sett_title_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open_settings(); }
                    }
                }

                // Minimize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: min-touch.has-hover ? AppTheme.surface-sidebar : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-minimize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: AppTheme.text-primary;
                                image-fit: contain;
                            }
                        }
                    }

                    min-touch := TouchArea {
                        clicked => { root.minimize_window(); }
                    }
                }

                // Maximize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: max-touch.has-hover ? AppTheme.surface-sidebar : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: root.is_maximized ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: AppTheme.text-primary;
                                image-fit: contain;
                            }
                        }
                    }

                    max-touch := TouchArea {
                        clicked => { root.maximize_window(); }
                    }
                }

                // Close
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: close-touch.has-hover ? AppTheme.danger : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-close.svg");
                                width: 10px;
                                height: 10px;
                                colorize: close-touch.has-hover ? AppTheme.text-on-accent : AppTheme.text-primary;
                                image-fit: contain;
                            }
                        }
                    }

                    close-touch := TouchArea {
                        clicked => { root.close_window(); }
                    }
                }
            }
        }

        // Body Content
        if !root.is_logged_in: Rectangle {
            background: AppTheme.surface-input;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;

                    VerticalLayout {
                        spacing: 10px;
                        width: 720px;

                        // Alert / Status Banner on Login Screen
                        if root.login_alert_message != "": Rectangle {
                            min-height: 38px;
                            background: alert_ta.has-hover ? (root.login_alert_is_error ? AppTheme.danger-action-faint : AppTheme.accent-faint) : (root.login_alert_is_error ? AppTheme.danger-action-subtle : AppTheme.accent-subtle);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.login_alert_is_error ? AppTheme.danger-action-border : AppTheme.accent-border-muted;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: root.login_alert_is_error ? @image-url("../assets/alert-triangle.svg") : @image-url("../assets/info.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: root.login_alert_is_error ? AppTheme.danger : AppTheme.accent;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.login_alert_message;
                                    color: root.login_alert_is_error ? AppTheme.danger : AppTheme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    wrap: word-wrap;
                                }

                                if root.login_alert_is_error : VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/settings.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: AppTheme.danger;
                                        opacity: alert_ta.has-hover ? 1.0 : 0.75;
                                    }
                                }
                            }

                            alert_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.settings_active_tab = 6;
                                    root.open_settings();
                                }
                            }
                        }


                        Rectangle {
                            height: 400px;
                            background: AppTheme.surface-sidebar;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: AppTheme.border-subtle;

                        HorizontalLayout {
                            padding: 32px;
                            spacing: 32px;

                            // Left Column: Token / Auto-Detect Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;

                                    Image {
                                        source: @image-url("../assets/app_icon.png");
                                        width: 26px;
                                        height: 26px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: root.tr_login_title;
                                        color: AppTheme.text-strong;
                                        font-size: 20px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.tr_login_desc;
                                    color: AppTheme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                token_input := LineEdit {
                                    placeholder-text: root.tr_login_placeholder;
                                    input-type: password;
                                    accepted => {
                                        if (token_input.text != "") {
                                            root.login(token_input.text);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/rocket.svg");
                                        text: root.tr_login_btn_connect;
                                        primary: true;
                                        clicked => {
                                            if (token_input.text != "") {
                                                root.login(token_input.text);
                                            }
                                        }
                                    }

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/search.svg");
                                        text: root.tr_login_btn_detect;
                                        clicked => {
                                            root.auto_detect_token();
                                        }
                                    }
                                }
                            }

                            // Middle Divider
                            Rectangle {
                                width: 1px;
                                background: AppTheme.border-subtle;
                            }

                            // Right Column: Official QR Code Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 10px;

                                // QR Code Card Container
                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 155px;
                                        height: 155px;
                                        background: AppTheme.solid-white;
                                        border-radius: 8px;
                                        clip: true;

                                        if root.has_qr_code: Image {
                                            source: root.qr_code_image;
                                            width: 155px;
                                            height: 155px;
                                            image-fit: contain;
                                        }

                                        if !root.has_qr_code: VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/qr.svg");
                                                    width: 32px;
                                                    height: 32px;
                                                    colorize: AppTheme.accent;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Gerar QR";
                                                    clicked => { root.refresh_qr_code(); }
                                                }
                                            }
                                        }

                                        // User Scanned Overlay Badge
                                        if root.qr_scanned_user != "": Rectangle {
                                            background: AppTheme.surface-media-overlay;
                                            width: 100%;
                                            height: 100%;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                padding: 8px;

                                                Text {
                                                    text: "✓ " + root.qr_scanned_user;
                                                    color: AppTheme.success;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: root.tr_qr_confirm;
                                                    color: AppTheme.text-on-accent;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.tr_qr_title;
                                    color: AppTheme.text-strong;
                                    font-size: 14px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_qr_desc;
                                    color: AppTheme.text-muted;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                // Botão Re-gerar QR Code
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 30px;
                                        width: 150px;
                                        background: re_qr_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-input;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: re_qr_ta.has-hover ? AppTheme.info : AppTheme.border-subtle;
                                        animate background { duration: 120ms; }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/qr.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    colorize: AppTheme.info;
                                                    image-fit: contain;
                                                }
                                            }
                                            Text {
                                                text: "Re-gerar QR Code";
                                                color: AppTheme.text-strong;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }

                                        re_qr_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.refresh_qr_code(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

        if root.is_logged_in: HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // 1. Guilds Sidebar (Servidores com Scroll e tamanho fixado)
            Rectangle {
                width: 72px;
                background: AppTheme.surface-guild-rail;

                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 0px;
                    padding-right: 0px;
                    spacing: 0px;

                    Rectangle {
                        vertical-stretch: 1;

                        Flickable {
                            VerticalLayout {
                                padding: 0px;
                                spacing: 10px;
                                alignment: start;

                                for guild in root.guilds: HorizontalLayout {
                                    alignment: center;
                                    spacing: 0px;

                                    // Left indicator pill (Discord style)
                                    VerticalLayout {
                                        alignment: center;
                                        width: 8px;
                                        Rectangle {
                                            width: 4px;
                                            height: (guild.id == root.active_guild_id) ? 36px : (guild_ta.has-hover ? 16px : 0px);
                                            background: AppTheme.text-strong;
                                            border-top-right-radius: 4px;
                                            border-bottom-right-radius: 4px;
                                            animate height { duration: 150ms; easing: ease-out; }
                                        }
                                    }

                                    Rectangle {
                                        height: 48px;
                                        width: 48px;
                                        background: (guild.id == root.active_guild_id) ? AppTheme.accent : (guild_ta.has-hover ? AppTheme.accent : AppTheme.surface-chat);
                                        border-radius: (guild.id == root.active_guild_id || guild_ta.has-hover) ? 14px : 16px;
                                        clip: true;
                                        animate border-radius, background { duration: 150ms; easing: ease-out; }

                                        if guild.has_image: Image {
                                            source: guild.icon_image;
                                            width: 48px;
                                            height: 48px;
                                            image-fit: cover;
                                        }

                                        if !guild.has_image: Text {
                                            text: guild.icon;
                                            color: AppTheme.text-on-accent;
                                            font-size: 14px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        guild_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.active_guild_id = guild.id;
                                                root.select_guild(guild.id);
                                            }
                                        }
                                    }

                                    // Spacer to balance the 8px on the left
                                    Rectangle { width: 8px; }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Channels Sidebar
            ChannelSidebar {
                active_guild_name: root.active_guild_name;
                tr_server_channels: root.tr_server_channels;
                channels: root.channels;
                is_in_voice: root.is_in_voice;
                is_voice_connecting: root.is_voice_connecting;
                is_muted: root.is_muted;
                is_deafened: root.is_deafened;
                tr_voice_connecting: root.tr_voice_connecting;
                tr_voice_connected: root.tr_voice_connected;
                current_voice_channel: root.current_voice_channel;
                tr_leave: root.tr_leave;
                user_tag: root.user_tag;
                active_channel_id <=> root.active_channel_id;
                select_channel(id) => { root.select_channel(id); }
                toggle_category(id) => { root.toggle_category(id); }
                leave_voice => { root.leave_voice(); }
                toggle_mute => { root.toggle_mute(); }
                toggle_deafen => { root.toggle_deafen(); }
                open_settings => { root.open_settings(); }
                toggle_user_menu => { root.show_user_menu = !root.show_user_menu; }
            }

            // 3. Main Content View (Text Chat OR Voice Room View)
            Rectangle {
                background: AppTheme.surface-sidebar;
                horizontal-stretch: 1;

                if root.is_voice_focused && root.is_in_voice: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Voice Room Header Bar
                    Rectangle {
                        height: 44px;
                        background: AppTheme.surface-sidebar;

                        // Left vertical divider line separating channel sidebar from voice header bar
                        Rectangle {
                            x: 0px;
                            y: 8px;
                            width: 1px;
                            height: parent.height - 16px;
                            background: AppTheme.separator;
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: AppTheme.text-on-accent;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.current_voice_channel;
                                    color: AppTheme.text-on-accent;
                                    font-size: 15px;
                                    font-weight: 800;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_share_ta.pressed ? (root.is_screen_sharing ? AppTheme.danger-deep : AppTheme.surface-pressed) : (btn_share_ta.has-hover ? (root.is_screen_sharing ? AppTheme.danger-medium : AppTheme.separator) : (root.is_screen_sharing ? AppTheme.danger-action : AppTheme.surface-chat));
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/monitor.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: AppTheme.text-on-accent;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.is_screen_sharing ? root.tr_stop_screen_share : root.tr_start_screen_share;
                                            color: AppTheme.text-on-accent;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_share_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if root.is_screen_sharing {
                                                root.toggle_screen_share();
                                            } else {
                                                root.open_stream_modal();
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_chat_ta.pressed ? AppTheme.surface-pressed : (btn_chat_ta.has-hover ? AppTheme.separator : AppTheme.surface-chat);
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/message-square.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: AppTheme.text-on-accent;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.tr_view_text_chat;
                                            color: AppTheme.text-on-accent;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_chat_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.toggle_voice_focus();
                                            root.scroll_chat_to_bottom();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_leave_ta.pressed ? AppTheme.danger-deep : (btn_leave_ta.has-hover ? AppTheme.danger-action : AppTheme.surface-chat);
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/log-out.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: AppTheme.text-on-accent;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.tr_leave_call;
                                            color: AppTheme.text-on-accent;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_leave_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.leave_voice();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Voice Room Connecting Loading State
                    if root.is_voice_connecting: Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.surface-input;
                        border-top-left-radius: 8px;
                        clip: true;

                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 68px;
                                    height: 68px;
                                    border-radius: 34px;
                                    background: AppTheme.surface-sidebar;
                                    border-width: 2px;
                                    border-color: AppTheme.accent;

                                    Image {
                                        source: @image-url("../assets/speaker.svg");
                                        width: 28px;
                                        height: 28px;
                                        colorize: AppTheme.accent;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.tr_voice_connecting_title;
                                    color: AppTheme.text-on-accent;
                                    font-size: 16px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_voice_connecting_desc;
                                    color: AppTheme.text-muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_cancel;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // Voice Room Participants Dynamic Stage Grid
                    if !root.is_voice_connecting: voice_stage_container := Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.surface-input;
                        border-top-left-radius: 8px;
                        clip: true;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: root.tr_voice_participants_title + " (" + root.voice_participants.length + ")";
                                color: AppTheme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            ListView {
                                for p in root.voice_participants: Rectangle {
                                    property <bool> is_streaming_attached: (p.is_self && root.is_screen_sharing)
                                        ? (!p.is_stream_hidden && root.popped_out_stream_uid != p.user_id && root.popped_out_stream_uid != "self")
                                        : (root.has_active_stream && (p.is_streaming || root.active_stream_user_id == p.user_id || root.active_stream_user_id == "") && !p.is_stream_hidden && root.popped_out_stream_uid != p.user_id);
                                    property <bool> is_this_stream_focused: (root.focused_stream_uid == p.user_id || (p.is_self && (root.focused_stream_uid == "self" || root.focused_stream_uid == p.user_id)));

                                    height: is_streaming_attached
                                        ? (is_this_stream_focused
                                            ? Math.max(360px, voice_stage_container.height - 52px)
                                            : Math.max(200px, Math.min(280px, (voice_stage_container.height - 80px) * 0.5)))
                                        : 76px;
                                    animate height { duration: 200ms; }
                                    background: transparent;

                                    // 1. EXPANDED STREAM VIEWPORT (When Streaming in the room & NOT popped out)
                                    if is_streaming_attached: Rectangle {
                                        y: 4px;
                                        height: parent.height - 8px;
                                        background: AppTheme.surface-media;
                                        border-radius: 8px;
                                        border-width: p.is_speaking ? 3px : ((p.is_self && root.is_screen_sharing) ? 2px : 1px);
                                        border-color: p.is_speaking ? AppTheme.success : ((p.is_self && root.is_screen_sharing) ? AppTheme.accent : AppTheme.border-subtle);
                                        clip: true;

                                        // Video Canvas (Independent dual buffers: active_stream_frame for self transmitter, remote_stream_frame for remote peer)
                                        Image {
                                            source: (p.is_self && root.is_screen_sharing) ? root.active_stream_frame : root.remote_stream_frame;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: contain;
                                        }

                                        // Top Overlay Bar (Left: Live badge, username, mute, prio | Right: Popout, Fullscreen)
                                        stream_top_bar := Rectangle {
                                            x: 8px;
                                            y: 8px;
                                            width: parent.width - 16px;
                                            height: 32px;
                                            background: transparent;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: space-between;

                                                // Left side info container (clipped, expands to take available space)
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    clip: true;
                                                    background: transparent;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;

                                                        // 6. AO VIVO Badge (Priority 6 - least important, hidden first when width < 380px)
                                                        if (stream_top_bar.width >= 380px): Rectangle {
                                                            background: AppTheme.danger;
                                                            border-radius: 4px;
                                                            height: 24px;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 5px;
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 6px;
                                                                        height: 6px;
                                                                        border-radius: 3px;
                                                                        background: AppTheme.solid-white;
                                                                    }
                                                                }
                                                                Text {
                                                                    text: root.tr_live_badge;
                                                                    color: AppTheme.text-on-accent;
                                                                    font-size: 10px;
                                                                    font-weight: 800;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        // 4. Username & Quality Pill (Priority 4 - hidden when width < 210px)
                                                        if (stream_top_bar.width >= 210px): Rectangle {
                                                            background: AppTheme.backdrop;
                                                            border-radius: 4px;
                                                            height: 24px;
                                                            clip: true;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 6px;
                                                                alignment: start;
                                                                Text {
                                                                    text: (stream_top_bar.width >= 320px) ? (p.username + " • " + root.tr_stream_quality) : p.username;
                                                                    color: AppTheme.text-primary;
                                                                    font-size: 11px;
                                                                    font-weight: 600;
                                                                    vertical-alignment: center;
                                                                    overflow: elide;
                                                                }
                                                            }
                                                        }

                                                        // 5. FPS Counter Badge (Priority 5 - hidden when width < 310px)
                                                        if (((p.is_self && root.is_screen_sharing && root.local_preview_fps != "") || (!(p.is_self && root.is_screen_sharing) && root.remote_stream_fps != "")) && stream_top_bar.width >= 310px): Rectangle {
                                                        background: AppTheme.success-subtle;
                                                            border-radius: 4px;
                                                            border-width: 1px;
                                                            border-color: AppTheme.success;
                                                            height: 24px;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 5px;
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 6px;
                                                                        height: 6px;
                                                                        border-radius: 3px;
                                                                        background: AppTheme.success;
                                                                    }
                                                                }
                                                                Text {
                                                                    text: (p.is_self && root.is_screen_sharing) ? root.local_preview_fps : root.remote_stream_fps;
                                                                    color: AppTheme.success;
                                                                    font-size: 11px;
                                                                    font-weight: 800;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        // Stream Audio Volume Slider (only shown for remote stream cards when plenty of room >= 560px)
                                                        if !(p.is_self && root.is_screen_sharing) && stream_top_bar.width >= 560px: Rectangle {
                                                            background: AppTheme.backdrop;
                                                            border-radius: 4px;
                                                            height: 24px;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                spacing: 6px;
                                                                alignment: center;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Image {
                                                                        source: root.stream_remote_volume <= 0.01 ? @image-url("../assets/volume-x.svg") : @image-url("../assets/speaker.svg");
                                                                        width: 12px;
                                                                        height: 12px;
                                                                        colorize: root.stream_remote_volume <= 0.01 ? AppTheme.danger : AppTheme.text-muted;
                                                                        image-fit: contain;
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 55px;
                                                                        height: 5px;
                                                                        background: AppTheme.interactive-hover;
                                                                        border-radius: 2.5px;

                                                                        // Progress fill
                                                                        Rectangle {
                                                                            x: 0;
                                                                            y: 0;
                                                                            width: parent.width * (root.stream_remote_volume.clamp(0.0, 1.0));
                                                                            height: 100%;
                                                                            background: root.stream_remote_volume <= 0.01 ? AppTheme.danger : AppTheme.accent;
                                                                            border-radius: 2.5px;
                                                                        }

                                                                        TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => {
                                                                                let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                                                                root.stream_remote_volume = new_vol;
                                                                                root.set_stream_volume(p.user_id, new_vol);
                                                                            }
                                                                            moved => {
                                                                                if self.pressed {
                                                                                    let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                                                                    root.stream_remote_volume = new_vol;
                                                                                    root.set_stream_volume(p.user_id, new_vol);
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Text {
                                                                        text: "\{Math.round(root.stream_remote_volume * 100)}%";
                                                                        color: AppTheme.text-muted;
                                                                        font-size: 9px;
                                                                        font-weight: 700;
                                                                        vertical-alignment: center;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        // If another user is streaming: Mute button and Priority controls directly on the stream card (when plenty of room >= 700px)
                                                        if !(p.is_self && root.is_screen_sharing) && stream_top_bar.width >= 700px: HorizontalLayout {
                                                            spacing: 4px;
                                                            alignment: start;

                                                            // Stream Mute Button
                                                            Rectangle {
                                                                width: 26px;
                                                                height: 24px;
                                                                border-radius: 4px;
                                                                background: str_mute_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    HorizontalLayout {
                                                                        alignment: center;
                                                                        Image {
                                                                            source: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                                            width: 12px;
                                                                            height: 12px;
                                                                            colorize: p.is_muted ? AppTheme.danger : AppTheme.text-primary;
                                                                            image-fit: contain;
                                                                        }
                                                                    }
                                                                }

                                                                str_mute_ta := TouchArea {
                                                                    mouse-cursor: pointer;
                                                                    clicked => { root.toggle_user_mute(p.user_id); }
                                                                }
                                                            }

                                                            // Stream Speech Priority Control Box
                                                            Rectangle {
                                                                width: 76px;
                                                                height: 24px;
                                                                background: AppTheme.backdrop;
                                                                border-radius: 4px;
                                                                border-width: 1px;
                                                                border-color: p.priority > 0 ? AppTheme.accent : AppTheme.border-subtle;

                                                                HorizontalLayout {
                                                                    padding: 1px;
                                                                    spacing: 2px;

                                                                    Rectangle {
                                                                        width: 18px;
                                                                        height: 20px;
                                                                        border-radius: 3px;
                                                                        background: str_pdec_ta.has-hover ? AppTheme.border-subtle : transparent;
                                                                        Text { text: "-"; color: AppTheme.text-primary; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                                        str_pdec_ta := TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => { if p.priority > 0 { root.set_user_priority(p.user_id, p.priority - 1); } }
                                                                        }
                                                                    }

                                                                    VerticalLayout {
                                                                        horizontal-stretch: 1;
                                                                        alignment: center;
                                                                        Text {
                                                                            text: p.priority == 0 ? "Normal" : ("P" + p.priority);
                                                                            color: p.priority > 0 ? AppTheme.accent : AppTheme.text-muted;
                                                                            font-size: 9px;
                                                                            font-weight: 700;
                                                                            horizontal-alignment: center;
                                                                        }
                                                                    }

                                                                    Rectangle {
                                                                        width: 18px;
                                                                        height: 20px;
                                                                        border-radius: 3px;
                                                                        background: str_pinc_ta.has-hover ? AppTheme.border-subtle : transparent;
                                                                        Text { text: "+"; color: AppTheme.text-primary; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                                        str_pinc_ta := TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => { if p.priority < 3 { root.set_user_priority(p.user_id, p.priority + 1); } }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                // Right side action buttons (Priority: x > desanexar > max)
                                                HorizontalLayout {
                                                    horizontal-stretch: 0;
                                                    spacing: 6px;
                                                    alignment: end;

                                                    // 3. max (Stream Card Focus / Expand Toggle - Priority 3, hidden when width < 160px)
                                                    if (stream_top_bar.width >= 160px): Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_fs_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: is_this_stream_focused ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: is_this_stream_focused ? AppTheme.accent : AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_fs_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if is_this_stream_focused {
                                                                    root.focused_stream_uid = "";
                                                                } else {
                                                                    root.focused_stream_uid = (p.is_self && root.is_screen_sharing) ? "self" : p.user_id;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // 2. desanexar (Popout Button - Priority 2, hidden when width < 110px)
                                                    if (stream_top_bar.width >= 110px): Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_pop_ta.has-hover ? AppTheme.backdrop-max : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/popout.svg");
                                                                    width: 12px;
                                                                    height: 12px;
                                                                    colorize: AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_pop_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.popped_out_stream_uid = p.user_id;
                                                                root.popout_stream_window(p.user_id, p.username);
                                                            }
                                                        }
                                                    }

                                                    // 1. x (Stop Screen Share or Hide Stream - Priority 1, ALWAYS visible)
                                                    Rectangle {
                                                        width: 28px;
                                                        height: 24px;
                                                        border-radius: 4px;
                                                        background: card_stop_ta.has-hover ? AppTheme.danger : AppTheme.backdrop;

                                                        VerticalLayout {
                                                            alignment: center;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/chrome-close.svg");
                                                                    width: 10px;
                                                                    height: 10px;
                                                                    colorize: AppTheme.text-on-accent;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                        }

                                                        card_stop_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if (p.is_self && root.is_screen_sharing) {
                                                                    root.toggle_screen_share();
                                                                } else {
                                                                    root.hide_stream(p.user_id);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Self-Preview Resource Notice (Single compact line below AO VIVO badge)
                                        if (p.is_self && root.is_screen_sharing && root.show_self_preview_notice): Rectangle {
                                            x: 8px;
                                            y: 38px;
                                            width: parent.width > 230px ? 215px : (parent.width - 16px > 0px ? parent.width - 16px : 0px);
                                            height: 20px;
                                            background: AppTheme.surface-media-overlay-strong;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: AppTheme.accent-border-strong;
                                            clip: true;

                                            HorizontalLayout {
                                                width: 100%;
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/info.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }

                                                Text {
                                                    text: "Prévia reduzida para poupar recursos";
                                                    color: AppTheme.text-primary;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.show_self_preview_notice = false; }
                                            }
                                        }

                                        // Self-Stream Discord-Style Banner Overlay
                                        if (p.is_self && root.is_screen_sharing): Rectangle {
                                            x: (parent.width - 200px) / 2;
                                            y: parent.height - 34px;
                                            width: 200px;
                                            height: 26px;
                                            background: AppTheme.backdrop-stronger;
                                            border-radius: 13px;
                                            border-width: 1px;
                                            border-color: AppTheme.accent;

                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/monitor.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: AppTheme.accent;
                                                        image-fit: contain;
                                                    }
                                                }
                                                Text {
                                                    text: "Você está transmitindo";
                                                    color: AppTheme.text-on-accent;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // 2. STANDARD VOICE AUDIO RECTANGLE (When NOT streaming OR when Popped Out)
                                    if !is_streaming_attached: Rectangle {
                                        y: 4px;
                                        height: 68px;
                                        background: p.is_self ? AppTheme.surface-reply : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: p.is_speaking ? 2px : (p.is_self ? 1px : 0px);
                                        border-color: p.is_speaking ? AppTheme.success : (p.is_self ? AppTheme.accent : transparent);

                                        HorizontalBox {
                                             padding-left: 12px;
                                             padding-right: 12px;
                                             spacing: 12px;

                                             // Avatar Badge with Glowing Green Ring when speaking / Blue accent for self!
                                             VerticalLayout {
                                                 alignment: center;
                                                 Rectangle {
                                                     width: 42px;
                                                     height: 42px;
                                                     border-radius: 21px;
                                                     background: p.is_speaking ? AppTheme.success : (p.is_self ? AppTheme.accent : AppTheme.border-subtle);
                                                     border-width: p.is_speaking ? 3px : (p.is_self ? 2px : 0px);
                                                     border-color: p.is_speaking ? AppTheme.success : (p.is_self ? AppTheme.accent-medium : transparent);

                                                     Text {
                                                         text: p.avatar_text;
                                                         color: AppTheme.text-on-accent;
                                                         font-size: 16px;
                                                         font-weight: 700;
                                                         horizontal-alignment: center;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                             }

                                             // Username & Controls in a Vertical Stack!
                                             VerticalBox {
                                                 horizontal-stretch: 1;
                                                 alignment: center;
                                                 spacing: 6px;
                                                 padding: 0px;

                                                 // Row 1: Username & Badges
                                                 HorizontalLayout {
                                                     spacing: 8px;
                                                     Text {
                                                         text: p.username;
                                                         color: p.is_self ? AppTheme.accent-medium : (p.is_speaking ? AppTheme.text-on-accent : AppTheme.text-primary);
                                                         font-weight: 700;
                                                         font-size: 14px;
                                                         vertical-alignment: center;
                                                     }

                                                     if p.is_self: Rectangle {
                                                         background: AppTheme.accent;
                                                         border-radius: 4px;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: root.tr_badge_you;
                                                                 color: AppTheme.text-on-accent;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     if (root.popped_out_stream_uid == p.user_id || (p.is_self && root.popped_out_stream_uid == "self")): Rectangle {
                                                         background: AppTheme.accent-subtle;
                                                         border-radius: 4px;
                                                         border-width: 1px;
                                                         border-color: AppTheme.accent;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: "DESANEXADO";
                                                                 color: AppTheme.accent;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     // Live Badge if streaming while card is audio-only/hidden
                                                     if (p.is_streaming || (p.is_self && root.is_screen_sharing)): Rectangle {
                                                                        background: AppTheme.danger-subtle;
                                                         border-radius: 4px;
                                                         border-width: 1px;
                                                         border-color: AppTheme.danger;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             spacing: 4px;
                                                             VerticalLayout {
                                                                 alignment: center;
                                                                 Rectangle {
                                                                     width: 4px;
                                                                     height: 4px;
                                                                     border-radius: 2px;
                                                                     background: AppTheme.danger;
                                                                 }
                                                             }
                                                             Text {
                                                                 text: "AO VIVO";
                                                                 color: AppTheme.danger;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     if p.is_muted: HorizontalLayout {
                                                         spacing: 4px;
                                                         alignment: start;
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Image {
                                                                 source: @image-url("../assets/volume-x.svg");
                                                                 width: 12px;
                                                                 height: 12px;
                                                                 colorize: AppTheme.danger;
                                                                 image-fit: contain;
                                                             }
                                                         }
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Text {
                                                                 text: "MUTED";
                                                                 color: AppTheme.danger;
                                                                 font-size: 11px;
                                                                 font-weight: 700;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     Rectangle { horizontal-stretch: 1; }

                                                      // Intangible Deactivation Button (Active when popout is clicked-through)
                                                      if (root.is_popout_intangible && (root.popped_out_stream_uid == p.user_id || (p.is_self && root.popped_out_stream_uid == "self"))): Rectangle {
                                                          height: 22px;
                                                          border-radius: 4px;
                                                          background: ghost_deact_ta.has-hover ? AppTheme.success-action-hover : AppTheme.success;

                                                          HorizontalLayout {
                                                              padding-left: 8px;
                                                              padding-right: 8px;
                                                              spacing: 5px;

                                                              VerticalLayout {
                                                                  alignment: center;
                                                                  Image {
                                                                      source: @image-url("../assets/ghost.svg");
                                                                      width: 12px;
                                                                      height: 12px;
                                                                      colorize: AppTheme.text-on-accent;
                                                                      image-fit: contain;
                                                                  }
                                                              }

                                                              Text {
                                                                  text: "Desativar Intangível";
                                                                  color: AppTheme.text-on-accent;
                                                                  font-size: 10px;
                                                                  font-weight: 700;
                                                                  vertical-alignment: center;
                                                              }
                                                          }

                                                          ghost_deact_ta := TouchArea {
                                                              mouse-cursor: pointer;
                                                              clicked => {
                                                                  root.toggle_popout_intangible();
                                                              }
                                                          }
                                                      }

                                                     // Square button in top-right corner to re-enable/unhide stream (ONLY visible if user is currently streaming!)
                                                     if (p.is_streaming || (p.is_self && root.is_screen_sharing)): Rectangle {
                                                         width: 26px;
                                                         height: 22px;
                                                         border-radius: 4px;
                                                         background: unhide_stream_ta.has-hover ? AppTheme.accent : AppTheme.interactive-hover;

                                                         VerticalLayout {
                                                             alignment: center;
                                                             HorizontalLayout {
                                                                 alignment: center;
                                                                 Image {
                                                                     source: @image-url("../assets/window.svg");
                                                                     width: 12px;
                                                                     height: 12px;
                                                                     colorize: AppTheme.text-on-accent;
                                                                     image-fit: contain;
                                                                 }
                                                             }
                                                         }

                                                         unhide_stream_ta := TouchArea {
                                                             mouse-cursor: pointer;
                                                             clicked => {
                                                                 root.unhide_stream(p.user_id);
                                                             }
                                                         }
                                                     }
                                                 }

                                                 // Row 2: Controls vs Self Info
                                                 if p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Mic Volume Meter Bar for Self
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: AppTheme.surface-input;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? AppTheme.success : AppTheme.accent;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Status description for Self
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: root.is_muted ? "Muted" : (p.is_speaking ? "Transmitting..." : "Mic active");
                                                             color: root.is_muted ? AppTheme.danger : (p.is_speaking ? AppTheme.success : AppTheme.text-subtle);
                                                             font-size: 11px;
                                                             font-weight: 600;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                 }

                                                 if !p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Volume Level Meter Bar
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: AppTheme.surface-input;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? AppTheme.success : AppTheme.accent;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Mute Button
                                                     VerticalLayout {
                                                         alignment: center;
                                                         IconButton {
                                                             icon: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                             icon-color: p.is_muted ? AppTheme.danger : AppTheme.text-primary;
                                                             clicked => { root.toggle_user_mute(p.user_id); }
                                                         }
                                                     }

                                                     // Volume Text
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: "Vol: " + Math.round(p.volume * 100) + "%";
                                                             color: AppTheme.text-secondary;
                                                             font-size: 11px;
                                                             vertical-alignment: center;
                                                         }
                                                     }

                                                      // Slider (0% to 200% with amplification boost like Discord)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Slider {
                                                              width: 110px;
                                                              minimum: 0.0;
                                                              maximum: 2.0;
                                                              value: p.volume;
                                                              changed(val) => { root.set_user_volume(p.user_id, val); }
                                                          }
                                                      }

                                                      // Speech Priority Control Box (Prioridade de Fala)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Rectangle {
                                                              width: 86px;
                                                              height: 24px;
                                                              background: AppTheme.surface-sidebar;
                                                              border-radius: 6px;
                                                              border-width: 1px;
                                                              border-color: p.priority > 0 ? AppTheme.accent : AppTheme.border-subtle;

                                                              HorizontalLayout {
                                                                  padding: 2px;
                                                                  spacing: 2px;

                                                                  // "-" Decrement Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: prio_dec_ta.has-hover ? AppTheme.border-subtle : transparent;

                                                                      Text {
                                                                          text: "-";
                                                                          color: AppTheme.text-primary;
                                                                          font-size: 12px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      prio_dec_ta := TouchArea {
                                                                          clicked => {
                                                                              if p.priority > 0 {
                                                                                  root.set_user_priority(p.user_id, p.priority - 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }

                                                                  // Priority Display
                                                                  VerticalLayout {
                                                                      horizontal-stretch: 1;
                                                                      alignment: center;
                                                                      Text {
                                                                          text: p.priority == 0 ? "Normal" : ("Prio " + p.priority);
                                                                          color: p.priority > 0 ? AppTheme.accent : AppTheme.text-muted;
                                                                          font-size: 10px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }
                                                                  }

                                                                  // "+" Increment Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: prio_inc_ta.has-hover ? AppTheme.border-subtle : transparent;

                                                                      Text {
                                                                          text: "+";
                                                                          color: AppTheme.text-primary;
                                                                          font-size: 12px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      prio_inc_ta := TouchArea {
                                                                          clicked => {
                                                                              if p.priority < 3 {
                                                                                  root.set_user_priority(p.user_id, p.priority + 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }
                                                              }
                                                          }
                                                      }
                                                 }
                                             }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if (!root.is_voice_focused || !root.is_in_voice): VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Channel Header
                    Rectangle {
                        height: 44px;
                        background: AppTheme.surface-sidebar;

                        // Left vertical divider line separating channel sidebar from text header bar
                        Rectangle {
                            x: 0px;
                            y: 8px;
                            width: 1px;
                            height: parent.height - 16px;
                            background: AppTheme.separator;
                        }

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            Text {
                                text: "#";
                                color: AppTheme.text-subtle;
                                font-size: 18px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.active_channel_name;
                                color: AppTheme.text-strong;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.is_in_voice: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_vroom_ta.pressed ? AppTheme.accent-hover : (btn_vroom_ta.has-hover ? AppTheme.accent : AppTheme.interactive-muted);
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 12px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/speaker.svg");
                                                width: 15px;
                                                height: 15px;
                                                colorize: AppTheme.text-on-accent;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.tr_view_voice_room;
                                                color: AppTheme.text-on-accent;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    btn_vroom_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle_voice_focus(); }
                                    }
                                }
                            }
                        }
                    }

                    // Messages Chat Feed & Input Container with rounded top-left corner
                    Rectangle {
                        vertical-stretch: 1;
                        background: AppTheme.surface-chat;
                        border-top-left-radius: 8px;
                        clip: true;

                        VerticalBox {
                            padding: 0px;
                            spacing: 0px;

                            // Messages Chat Feed View
                            chat_view := ChatMessagesView {
                        vertical-stretch: 1;
                        messages: root.messages;
                        has_more_older_messages: root.has_more_older_messages;
                        is_loading_older_messages: root.is_loading_older_messages;
                        tr_replying_to: root.tr_replying_to;
                        scroll_trigger: root.scroll_to_bottom_trigger;
                        load_older_messages => { root.load_older_messages(); }
                        open_link(url) => { root.open_link(url); }
                        download_attachment(id, fn, url) => { root.download_attachment(id, fn, url); }
                        click_command(cmd) => {
                            root.click_command(cmd);
                        }
                    }

                    // Smart Slash Command Autocomplete / Suggestions Box (Discord Style)
                    if root.show_command_suggestions : Rectangle {
                        height: Math.min(220px, (root.command_suggestions.length * 44 + 36) * 1px);
                        background: AppTheme.surface-sidebar;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: AppTheme.surface-scrim;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/terminal.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: AppTheme.accent;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: "COMANDOS INTELIGENTES DO DISCORD";
                                    color: AppTheme.text-muted;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "Clique para autocompletar";
                                    color: AppTheme.accent;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 3px;
                                    for cmd[idx] in root.command_suggestions: Rectangle {
                                        height: 38px;
                                        background: (idx == root.active_suggestion_index || cmd_sug_ta.has-hover) ? AppTheme.interactive-hover : AppTheme.surface-input;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: (idx == root.active_suggestion_index) ? AppTheme.accent : (cmd_sug_ta.has-hover ? AppTheme.accent-border-muted : transparent);

                                         HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/terminal.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: (idx == root.active_suggestion_index) ? AppTheme.accent-link-hover : AppTheme.text-subtle;
                                                    image-fit: contain;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.name;
                                                    color: (idx == root.active_suggestion_index) ? AppTheme.text-strong : AppTheme.accent-link-hover;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Bot Identifier Badge (e.g. [ Jockie Music ] or [ FredBoat ])
                                            if cmd.app_name != "" : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 18px;
                                                    background: (idx == root.active_suggestion_index) ? AppTheme.accent-selected : AppTheme.accent-subtle;
                                                    border-radius: 3px;
                                                    border-width: 1px;
                                                    border-color: (idx == root.active_suggestion_index) ? AppTheme.accent-border-strong : AppTheme.accent-selected;
                                                    HorizontalLayout {
                                                        padding-left: 5px;
                                                        padding-right: 5px;
                                                        alignment: center;
                                                        Text {
                                                            text: cmd.app_name;
                                                            color: (idx == root.active_suggestion_index) ? AppTheme.text-strong : AppTheme.accent-soft;
                                                            font-size: 10px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.desc;
                                                    color: (idx == root.active_suggestion_index) ? AppTheme.text-primary : AppTheme.text-muted;
                                                    font-size: 11.5px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: cmd.usage;
                                                    color: (idx == root.active_suggestion_index) ? AppTheme.text-muted : AppTheme.text-faint;
                                                    font-size: 10.5px;
                                                    font-family: "Courier New";
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        cmd_sug_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.select_suggestion(idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Message / Smart Command Input Box
                    Rectangle {
                        height: 56px;
                        background: AppTheme.surface-chat;

                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;

                            if root.active_command_name != "" : HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                // Command Pill (e.g. /play or /247)
                                Rectangle {
                                    background: AppTheme.accent-subtle;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: AppTheme.accent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/terminal.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: AppTheme.accent-link-hover;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.active_command_name;
                                            color: AppTheme.accent-link-hover;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/x.svg");
                                                width: 10px;
                                                height: 10px;
                                                colorize: close_cmd_ta.has-hover ? AppTheme.text-strong : AppTheme.text-muted;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                    close_cmd_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active_command_name = "";
                                            root.command_arg_text = "";
                                        }
                                    }
                                }

                                // Parameter Pill (e.g. [query] or [song] or [volume])
                                if root.active_param_name != "" : Rectangle {
                                    background: AppTheme.surface-elevated;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: AppTheme.separator;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/param.svg");
                                                width: 11px;
                                                height: 11px;
                                                colorize: AppTheme.accent;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: root.active_param_name + ":";
                                            color: AppTheme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Value Input
                                msg_arg_input := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.command_arg_text;
                                    placeholder-text: root.active_param_name != "" ? (root.active_param_desc != "" ? root.active_param_desc : "Digite o valor para " + root.active_param_name + "...") : "Pressione Enter ou Enviar para executar " + root.active_command_name + "...";
                                    accepted => {
                                        root.execute_active_command(
                                            root.active_command_name,
                                            root.command_arg_text,
                                            root.active_command_app_id,
                                            root.active_command_cmd_id,
                                            root.active_command_version,
                                            root.active_param_name
                                        );
                                        root.active_command_name = "";
                                        root.command_arg_text = "";
                                    }
                                }
                            }

                            if root.active_command_name == "" : Rectangle {
                                horizontal-stretch: 1;
                                background: AppTheme.surface-input;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: chat_text_input.has-focus ? AppTheme.accent : AppTheme.border-subtle;
                                clip: true;

                                if root.chat_input_text == "" : Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text: root.tr_chat_placeholder_prefix + root.active_channel_name + "...";
                                    color: AppTheme.text-subtle;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                }

                                chat_text_input := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: 100%;
                                    text <=> root.chat_input_text;
                                    color: AppTheme.text-primary;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    key-pressed(event) => {
                                        if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                            if (event.text == Key.UpArrow) {
                                                root.move_suggestion_up();
                                                return accept;
                                            }
                                            if (event.text == Key.DownArrow) {
                                                root.move_suggestion_down();
                                                return accept;
                                            }
                                            if (event.text == Key.Tab) {
                                                root.select_suggestion(root.active_suggestion_index);
                                                return accept;
                                            }
                                            if (event.text == Key.Escape) {
                                                root.show_command_suggestions = false;
                                                return accept;
                                            }
                                        }
                                        reject
                                    }
                                    edited => {
                                        root.active_suggestion_index = 0;
                                        root.handle_input_change(self.text);
                                    }
                                    accepted => {
                                        if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                            root.select_suggestion(root.active_suggestion_index);
                                        } else if (root.chat_input_text != "") {
                                            root.send_message(root.chat_input_text);
                                            root.chat_input_text = "";
                                            root.show_command_suggestions = false;
                                        }
                                    }
                                }
                            }

                            Button {
                                text: root.tr_send;
                                primary: true;
                                clicked => {
                                    if (root.active_command_name != "") {
                                        root.execute_active_command(
                                            root.active_command_name,
                                            root.command_arg_text,
                                            root.active_command_app_id,
                                            root.active_command_cmd_id,
                                            root.active_command_version,
                                            root.active_param_name
                                        );
                                        root.active_command_name = "";
                                        root.command_arg_text = "";
                                    } else if (root.show_command_suggestions && root.command_suggestions.length > 0) {
                                        root.select_suggestion(root.active_suggestion_index);
                                    } else if (root.chat_input_text != "") {
                                        root.send_message(root.chat_input_text);
                                        root.chat_input_text = "";
                                        root.show_command_suggestions = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }

    // Modal Popup Overlay for Settings (Modern Horizontal 2-Column Synchronized Architecture)
    if root.show_settings_modal: Rectangle {
        background: AppTheme.backdrop-strong;
        width: 100%;
        height: 100%;

        // Dismiss modal and stop test loopback on clicking outside backdrop
        TouchArea {
            clicked => {
                root.close_settings();
            }
        }

        modal_box := Rectangle {
            width: Math.min(1060px, parent.width - 32px);
            height: Math.min(640px, parent.height - 32px);
            background: AppTheme.surface-sidebar;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.border-subtle;
            clip: true;

            // Absorb any click inside modal box so it doesn't close modal or click through to underlying window
            modal_touch := TouchArea {
                clicked => {}
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // 1. TOP HEADER BAR (Clean & Minimalist)
                Rectangle {
                    height: 52px;
                    background: AppTheme.surface-input;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/settings.svg");
                                width: 18px;
                                height: 18px;
                                colorize: AppTheme.accent;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.tr_settings_title;
                            color: AppTheme.text-strong;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: "Litecord " + root.app_version;
                            color: AppTheme.text-subtle;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                height: 16px;
                                background: AppTheme.interactive-hover;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("../assets/x.svg");
                                icon-color: AppTheme.text-muted;
                                            hover-color: AppTheme.danger-subtle;
                                clicked => { root.close_settings(); }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: AppTheme.surface-elevated; }

                // 2. MAIN HORIZONTAL BODY (Sidebar + Synchronized Scrollable Center & Guide)
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    // =========================================================
                    // LEFT SIDEBAR: CATEGORY NAVIGATION TABS (Width: 200px)
                    // =========================================================
                    Rectangle {
                        width: 200px;
                        background: AppTheme.surface-input;

                        VerticalLayout {
                            padding-top: 14px;
                            padding-bottom: 14px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                Text {
                                    text: "CONFIGURAÇÕES";
                                    color: AppTheme.text-subtle;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }

                            // Tab 0: Voz & Áudio
                            Rectangle {
                                height: 38px;
                                border-radius: 6px;
                                background: root.settings_active_tab == 0 ? AppTheme.interactive-hover : tab0_touch.has-hover ? AppTheme.surface-sidebar : #0000;

                                if root.settings_active_tab == 0: Rectangle {
                                    x: 0px;
                                    y: 10px;
                                    width: 3px;
                                    height: 18px;
                                    background: AppTheme.accent;
                                    border-radius: 2px;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/microphone.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: root.settings_active_tab == 0 ? AppTheme.accent : AppTheme.text-muted;
                                            image-fit: contain;
                                        }
                                    }

                                    Text {
                                        text: root.tr_settings_tab_voice;
                                        color: root.settings_active_tab == 0 ? AppTheme.text-strong : AppTheme.text-primary;
                                        font-size: 13px;
                                        font-weight: root.settings_active_tab == 0 ? 700 : 500;

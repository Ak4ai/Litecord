                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/microphone.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.accent;

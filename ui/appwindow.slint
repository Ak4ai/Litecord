import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView, TextEdit, CheckBox, Slider } from "std-widgets.slint";

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: #dbdee1;
    in property <color> hover-color: #35373c;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? hover-color : #0000;

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: root.icon-color;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

struct LinkItem {
    label: string,
    url: string,
}

struct ChatMessage {
    author: string,
    timestamp: string,
    content: string,
    embed_content: string,
    embed_color: color,
    embed_footer: string,
    code_block: string,
    links: [LinkItem],
}

struct ChannelItem {
    id: string,
    name: string,
    is_voice: bool,
}

struct GuildItem {
    id: string,
    name: string,
    icon: string,
    has_image: bool,
    icon_image: image,
}

struct AudioDeviceItem {
    id: string,
    name: string,
    is_selected: bool,
}

struct VoiceParticipant {
    user_id: string,
    username: string,
    avatar_text: string,
    is_speaking: bool,
    audio_level: float,
    is_muted: bool,
    volume: float,
}

export component AppWindow inherits Window {
    title: "Litecord - Ultra-Lightweight Discord Client";
    icon: @image-url("../assets/app_icon.png");
    preferred-width: 980px;
    preferred-height: 620px;
    background: #1e1f22;

    // Callbacks to Rust backend
    callback login(string /* token */);
    callback send_message(string /* content */);
    callback select_channel(string /* channel_id */);
    callback select_guild(string /* guild_id */);
    callback toggle_mute();
    callback toggle_deafen();
    callback leave_voice();
    callback minimize_to_tray();
    callback open_settings();
    callback close_settings();
    callback select_input_device(string /* device_name */);
    callback select_output_device(string /* device_name */);
    callback auto_detect_token();
    callback toggle_user_mute(string /* user_id */);
    callback set_user_volume(string /* user_id */, float /* volume */);
    callback toggle_voice_focus();
    callback open_link(string /* url */);

    // Properties exposed to Rust backend
    in-out property <bool> is_logged_in: false;
    in-out property <string> connection_status: "Aguardando Token de Acesso...";
    in-out property <string> user_tag: "Não conectado";
    in-out property <string> active_channel_name: "Selecione um canal";
    in-out property <bool> is_muted: false;
    in-out property <bool> is_deafened: false;
    in-out property <bool> is_in_voice: false;
    in-out property <string> current_voice_channel: "";
    in-out property <bool> is_voice_focused: false;
    in-out property <[VoiceParticipant]> voice_participants: [];

    // Voice & Audio Settings Properties
    in-out property <bool> show_settings_modal: false;
    in-out property <[AudioDeviceItem]> input_devices: [];
    in-out property <[AudioDeviceItem]> output_devices: [];
    in-out property <string> selected_input_device: "Microfone Padrão do Sistema";
    in-out property <string> selected_output_device: "Alto-falantes Padrão do Sistema";
    in-out property <float> mic_level: 0.0; // Real-time mic volume level (0.0 to 1.0)

    in-out property <[GuildItem]> guilds: [];
    in-out property <[ChannelItem]> channels: [];
    in-out property <[ChatMessage]> messages: [
        { author: "Litecord System", timestamp: "Agora", content: "Bem-vindo ao Litecord! Seus servidores carregarão na barra lateral à esquerda." }
    ];

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Status Header Bar
        Rectangle {
            height: 42px;
            background: #111214;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 0px;
                padding-bottom: 0px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Image {
                            source: @image-url("../assets/app_icon.png");
                            width: 16px;
                            height: 16px;
                            colorize: #ffffff;
                        }
                        Text {
                            text: "LITECORD";
                            color: #ffffff;
                            font-weight: 800;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.connection_status;
                        color: #949ba4;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("../assets/settings.svg");
                        clicked => { root.open_settings(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Button {
                        icon: @image-url("../assets/pin.svg");
                        text: "Minimizar p/ Tray";
                        clicked => { root.minimize_to_tray(); }
                    }
                }
            }
        }

        // Body Content
        if !root.is_logged_in: Rectangle {
            background: #2b2d31;

            VerticalBox {
                alignment: center;
                spacing: 16px;
                width: 420px;

                Text {
                    text: "Entrar no Litecord";
                    color: #f2f3f5;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Insira seu Discord User Token para conexão direta à Gateway v9.\n(Consumo de RAM estimado em ~15MB)";
                    color: #b5bac1;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                token_input := LineEdit {
                    placeholder-text: "Cole seu Discord User Token aqui...";
                    input-type: password;
                    accepted => {
                        if (token_input.text != "") {
                            root.login(token_input.text);
                        }
                    }
                }

                HorizontalBox {
                    alignment: center;
                    spacing: 10px;

                    Button {
                        icon: @image-url("../assets/rocket.svg");
                        text: "Conectar à Gateway";
                        primary: true;
                        clicked => {
                            if (token_input.text != "") {
                                root.login(token_input.text);
                            }
                        }
                    }

                    Button {
                        icon: @image-url("../assets/search.svg");
                        text: "Detectar Token do Discord";
                        clicked => {
                            root.auto_detect_token();
                        }
                    }
                }
            }
        }

        if root.is_logged_in: HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // 1. Guilds Sidebar (Servidores com Scroll e tamanho fixado)
            Rectangle {
                width: 72px;
                background: #1e1f22;

                VerticalBox {
                    padding: 8px;
                    spacing: 0px;

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 10px;
                                alignment: start;

                                for guild in root.guilds: Rectangle {
                                    height: 48px;
                                    width: 48px;
                                    background: #313338;
                                    border-radius: 24px;
                                    clip: true;

                                    if guild.has_image: Image {
                                        source: guild.icon_image;
                                        width: 48px;
                                        height: 48px;
                                    }

                                    if !guild.has_image: Text {
                                        text: guild.icon;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    TouchArea {
                                        clicked => { root.select_guild(guild.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Channels Sidebar (Canais com Scroll e tamanho fixado)
            Rectangle {
                width: 230px;
                background: #2b2d31;

                VerticalBox {
                    padding: 8px;
                    spacing: 6px;

                    Text {
                        text: "CANAIS DO SERVIDOR";
                        color: #949ba4;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 4px;
                                alignment: start;

                                for channel in root.channels: Rectangle {
                                    height: 34px;
                                    background: #35373c;
                                    border-radius: 6px;

                                    HorizontalBox {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;

                                        if channel.is_voice : Image {
                                            source: @image-url("../assets/speaker.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #23a55a;
                                        }
                                        if !channel.is_voice : Text {
                                            text: "#";
                                            color: #80848e;
                                            font-size: 16px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: channel.name;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.select_channel(channel.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Active Voice Channel Banner
                    if root.is_in_voice: Rectangle {
                        height: 44px;
                        background: #23a55a;
                        border-radius: 6px;

                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: root.current_voice_channel;
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                icon: @image-url("../assets/log-out.svg");
                                text: "Sair";
                                clicked => { root.leave_voice(); }
                            }
                        }
                    }

                    // User Footer in Channels bar
                    Rectangle {
                        height: 54px;
                        background: #232428;
                        border-radius: 6px;

                        VerticalBox {
                            padding: 6px;
                            spacing: 2px;

                            Text {
                                text: root.user_tag;
                                color: #f2f3f5;
                                font-size: 12px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 4px;

                                IconButton {
                                    icon: root.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                    icon-color: root.is_muted ? #f23f43 : #dbdee1;
                                    clicked => { root.toggle_mute(); }
                                }

                                IconButton {
                                    icon: root.is_deafened ? @image-url("../assets/headphones-mute.svg") : @image-url("../assets/headphones.svg");
                                    icon-color: root.is_deafened ? #f23f43 : #dbdee1;
                                    clicked => { root.toggle_deafen(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/settings.svg");
                                    clicked => { root.open_settings(); }
                                }
                            }
                        }
                    }
                }
            }

            // 3. Main Content View (Text Chat OR Voice Room View)
            Rectangle {
                background: #313338;
                horizontal-stretch: 1;

                if root.is_voice_focused && root.is_in_voice: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Voice Room Header Bar
                    Rectangle {
                        height: 44px;
                        background: #2b2d31;

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            Text {
                                text: root.current_voice_channel;
                                color: #23a55a;
                                font-size: 15px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                icon: @image-url("../assets/message-square.svg");
                                text: "Ver Chat de Texto";
                                clicked => { root.toggle_voice_focus(); }
                            }

                            Button {
                                icon: @image-url("../assets/log-out.svg");
                                text: "Sair da Call";
                                clicked => { root.leave_voice(); }
                            }
                        }
                    }

                    // Voice Room Participants List View
                    Rectangle {
                        vertical-stretch: 1;
                        background: #313338;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "PARTICIPANTES NA SALA DE ÁUDIO (" + root.voice_participants.length + ")";
                                color: #949ba4;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            ListView {
                                for p in root.voice_participants: Rectangle {
                                    height: 68px;
                                    background: #2b2d31;
                                    border-radius: 8px;

                                    HorizontalBox {
                                         padding-left: 12px;
                                         padding-right: 12px;
                                         spacing: 12px;

                                         // Avatar Badge with Glowing Green Ring when speaking!
                                         VerticalLayout {
                                             alignment: center;
                                             Rectangle {
                                                 width: 42px;
                                                 height: 42px;
                                                 border-radius: 21px;
                                                 background: p.is_speaking ? #23a55a : #383a40;
                                                 border-width: p.is_speaking ? 3px : 0px;
                                                 border-color: #23a55a;

                                                 Text {
                                                     text: p.avatar_text;
                                                     color: #ffffff;
                                                     font-size: 16px;
                                                     font-weight: 700;
                                                     horizontal-alignment: center;
                                                     vertical-alignment: center;
                                                 }
                                             }
                                         }

                                         // Username & Controls in a Vertical Stack!
                                         VerticalBox {
                                             horizontal-stretch: 1;
                                             alignment: center;
                                             spacing: 6px;
                                             padding: 0px;

                                             // Row 1: Username & Mute Status Badge
                                             HorizontalLayout {
                                                 spacing: 8px;
                                                 Text {
                                                     text: p.username;
                                                     color: p.is_speaking ? #ffffff : #dbdee1;
                                                     font-weight: 700;
                                                     font-size: 14px;
                                                     vertical-alignment: center;
                                                 }

                                                 if p.is_muted: HorizontalLayout {
                                                     spacing: 4px;
                                                     alignment: start;
                                                     Image {
                                                         source: @image-url("../assets/volume-x.svg");
                                                         width: 12px;
                                                         height: 12px;
                                                         colorize: #f23f43;
                                                     }
                                                     Text {
                                                         text: "MUTADO";
                                                         color: #f23f43;
                                                         font-size: 11px;
                                                         font-weight: 700;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                             }

                                             // Row 2: Dynamic Volume bar & Per-User Controls
                                             HorizontalLayout {
                                                 spacing: 16px;

                                                 // Animated Volume Level Meter Bar (sobe e desce à medida que fala!)
                                                 VerticalLayout {
                                                     horizontal-stretch: 1;
                                                     alignment: center;
                                                     Rectangle {
                                                         height: 8px;
                                                         background: #1e1f22;
                                                         border-radius: 4px;

                                                         Rectangle {
                                                             x: 0px;
                                                             y: 0px;
                                                             height: 8px;
                                                             width: p.audio_level * parent.width;
                                                             background: p.is_speaking ? #23a55a : #5865f2;
                                                             border-radius: 4px;
                                                         }
                                                     }
                                                 }

                                                 // Mute Button
                                                 VerticalLayout {
                                                     alignment: center;
                                                     IconButton {
                                                         icon: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                         icon-color: p.is_muted ? #f23f43 : #dbdee1;
                                                         clicked => { root.toggle_user_mute(p.user_id); }
                                                     }
                                                 }

                                                 // Volume Text
                                                 VerticalLayout {
                                                     alignment: center;
                                                     Text {
                                                         text: "Vol: " + Math.round(p.volume * 100) + "%";
                                                         color: #b5bac1;
                                                         font-size: 11px;
                                                         vertical-alignment: center;
                                                     }
                                                 }

                                                 // Slider
                                                 VerticalLayout {
                                                     alignment: center;
                                                     Slider {
                                                         width: 120px;
                                                         minimum: 0.0;
                                                         maximum: 1.0;
                                                         value: p.volume;
                                                         changed(val) => { root.set_user_volume(p.user_id, val); }
                                                     }
                                                 }
                                             }
                                         }
                                    }
                                }
                            }
                        }
                    }
                }

                if (!root.is_voice_focused || !root.is_in_voice): VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Channel Header
                    Rectangle {
                        height: 42px;
                        background: #313338;

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;

                            Text {
                                text: root.active_channel_name;
                                color: #f2f3f5;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.is_in_voice: Button {
                                icon: @image-url("../assets/speaker.svg");
                                text: "Ver Sala de Voz";
                                clicked => { root.toggle_voice_focus(); }
                            }
                        }
                    }

                    // Messages Scroll View
                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 12px;
                                spacing: 10px;

                                for msg in root.messages: Rectangle {
                                    background: #2b2d31;
                                    border-radius: 6px;
                                    property <bool> is-collapsed: true;

                                    VerticalBox {
                                        padding: 8px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: msg.author;
                                                color: #5865f2;
                                                font-weight: 700;
                                                font-size: 13px;
                                            }

                                            Text {
                                                text: msg.timestamp;
                                                color: #949ba4;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }

                                            // Push the button to the right end
                                            Rectangle { }

                                            // Collapse/Expand button (only if links are present)
                                            if msg.links.length > 0 : Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                background: transparent;
                                                Text {
                                                    text: is-collapsed ? "▼" : "▲";
                                                    color: #949ba4;
                                                    font-size: 10px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        is-collapsed = !is-collapsed;
                                                    }
                                                }
                                            }
                                        }

                                        // Regular message content
                                        if msg.content != "": Text {
                                            text: msg.content;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }

                                        // Monospaced Code Block Box (visual representation of block code)
                                        if msg.code-block != "": Rectangle {
                                            background: #1e1f22;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #2b2d31;

                                            VerticalLayout {
                                                padding: 8px;
                                                Text {
                                                    text: msg.code-block;
                                                    color: #e6c07b;
                                                    font-family: "Courier New";
                                                    font-size: 12.5px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Embed box with colored left bar (always visible if present)
                                        if msg.embed-content != "" || msg.embed-footer != "": Rectangle {
                                            background: #232428;
                                            border-radius: 4px;

                                            HorizontalLayout {
                                                // Colored left bar
                                                Rectangle {
                                                    width: 4px;
                                                    background: msg.embed_color;
                                                    border-top-left-radius: 4px;
                                                    border-bottom-left-radius: 4px;
                                                }

                                                // Embed content layout
                                                VerticalLayout {
                                                    padding: 10px;
                                                    padding-left: 12px;
                                                    spacing: 8px;

                                                    if msg.embed-content != "": Text {
                                                        text: msg.embed-content;
                                                        color: #d2d5d9;
                                                        font-size: 12.5px;
                                                        wrap: word-wrap;
                                                    }

                                                    // Horizontal separator (representing dashes)
                                                    if msg.embed-footer != "": Rectangle {
                                                        height: 1px;
                                                        background: #3f4147;
                                                    }

                                                    // Footer content
                                                    if msg.embed-footer != "": Text {
                                                        text: msg.embed-footer;
                                                        color: #949ba4;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }

                                        // Clickable attachments / links list (toggled by is-collapsed, starts hidden)
                                        if msg.links.length > 0 && !is-collapsed : VerticalLayout {
                                            spacing: 6px;
                                            padding-top: 4px;
                                            for link in msg.links : Rectangle {
                                                height: 20px;
                                                background: transparent;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "🔗";
                                                        color: #00b0f4;
                                                        vertical-alignment: center;
                                                        font-size: 11px;
                                                    }
                                                    Text {
                                                        text: link.label;
                                                        color: #00b0f4;
                                                        vertical-alignment: center;
                                                        font-size: 13px;
                                                        font-weight: 500;
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.open_link(link.url);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Message Input Box
                    Rectangle {
                        height: 56px;
                        background: #313338;

                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;

                            msg_input := LineEdit {
                                placeholder-text: "Conversar em " + root.active_channel_name + "...";
                                accepted => {
                                    if (msg_input.text != "") {
                                        root.send_message(msg_input.text);
                                        msg_input.text = "";
                                    }
                                }
                            }

                            Button {
                                text: "Enviar";
                                primary: true;
                                clicked => {
                                    if (msg_input.text != "") {
                                        root.send_message(msg_input.text);
                                        msg_input.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Popup Overlay for Voice & Audio Settings (Discord Style)
    if root.show_settings_modal: Rectangle {
        background: #000000bb;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 560px;
            height: 490px;
            background: #2b2d31;
            border-radius: 12px;

            VerticalBox {
                padding: 18px;
                spacing: 14px;

                // Header Title & Close Button
                HorizontalBox {
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/settings.svg");
                            width: 20px;
                            height: 20px;
                        }
                        Text {
                            text: "Configurações de Voz e Áudio";
                            color: #f2f3f5;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        icon: @image-url("../assets/x.svg");
                        text: "Sair";
                        clicked => { root.close_settings(); }
                    }
                }

                // 1. Microphone Input Device Selection
                HorizontalLayout {
                    spacing: 6px;
                    Image {
                        source: @image-url("../assets/microphone.svg");
                        width: 14px;
                        height: 14px;
                    }
                    Text {
                        text: "DISPOSITIVO DE ENTRADA (MICROFONE)";
                        color: #b5bac1;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 110px;
                    background: #1e1f22;
                    border-radius: 8px;

                    ScrollView {
                        height: 100%;
                        width: 100%;

                        VerticalBox {
                            padding: 6px;
                            spacing: 4px;

                            for dev in root.input_devices: Rectangle {
                                height: 30px;
                                background: dev.is_selected ? #35373c : #2b2d31;
                                border-radius: 6px;

                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    Image {
                                        source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                        width: 14px;
                                        height: 14px;
                                    }

                                    Text {
                                        text: dev.name;
                                        color: dev.is_selected ? #5865f2 : #dbdee1;
                                        font-size: 12px;
                                        font-weight: dev.is_selected ? 700 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.select_input_device(dev.name); }
                                }
                            }
                        }
                    }
                }

                // 2. Speaker / Headphone Output Device Selection
                // 2. Speaker / Headphone Output Device Selection
                HorizontalLayout {
                    spacing: 6px;
                    Image {
                        source: @image-url("../assets/headphones.svg");
                        width: 14px;
                        height: 14px;
                    }
                    Text {
                        text: "DISPOSITIVO DE SAÍDA (ALTO-FALANTES / FONE DE OUVIDO)";
                        color: #b5bac1;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 110px;
                    background: #1e1f22;
                    border-radius: 8px;

                    ScrollView {
                        height: 100%;
                        width: 100%;

                        VerticalBox {
                            padding: 6px;
                            spacing: 4px;

                            for dev in root.output_devices: Rectangle {
                                height: 30px;
                                background: dev.is_selected ? #35373c : #2b2d31;
                                border-radius: 6px;

                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    Image {
                                        source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                        width: 14px;
                                        height: 14px;
                                    }

                                    Text {
                                        text: dev.name;
                                        color: dev.is_selected ? #5865f2 : #dbdee1;
                                        font-size: 12px;
                                        font-weight: dev.is_selected ? 700 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.select_output_device(dev.name); }
                                }
                            }
                        }
                    }
                }

                // 3. Mic Level Test Indicator Bar (Dynamic Real-Time Level)
                HorizontalBox {
                    HorizontalLayout {
                        spacing: 6px;
                        Image {
                            source: @image-url("../assets/speaker.svg");
                            width: 14px;
                            height: 14px;
                        }
                        Text {
                            text: "TESTE DE SENSIBILIDADE DO MICROFONE AO VIVO";
                            color: #b5bac1;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: Math.round(root.mic_level * 100) + "%";
                        color: root.mic_level > 0.1 ? #23a55a : #949ba4;
                        font-size: 11px;
                        font-weight: 700;
                    }
                }

                Rectangle {
                    height: 16px;
                    background: #1e1f22;
                    border-radius: 8px;

                    HorizontalBox {
                        padding: 2px;
                        spacing: 0px;

                        Rectangle {
                            width: Math.max(8px, (root.mic_level * 500) * 1px);
                            height: 12px;
                            background: root.mic_level > 0.1 ? #23a55a : #5865f2;
                            border-radius: 6px;
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                HorizontalBox {
                    alignment: end;

                    Button {
                        text: "Concluído";
                        primary: true;
                        clicked => { root.close_settings(); }
                    }
                }
            }
        }
    }
}

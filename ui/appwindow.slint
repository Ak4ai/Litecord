import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView, TextEdit, CheckBox, Slider } from "std-widgets.slint";

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: #dbdee1;
    in property <color> hover-color: #35373c;
    callback clicked();

    width: 32px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? hover-color : #0000;

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: root.icon-color;
        image-fit: contain;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

struct LinkItem {
    label: string,
    url: string,
}

struct ChatMessage {
    author: string,
    timestamp: string,
    content: string,
    embed_content: string,
    embed_color: color,
    embed_footer: string,
    code_block: string,
    reply_author: string,
    reply_content: string,
    links: [LinkItem],
}

struct ChannelItem {
    id: string,
    name: string,
    is_voice: bool,
    voice_count: int,
}

struct GuildItem {
    id: string,
    name: string,
    icon: string,
    has_image: bool,
    icon_image: image,
}

struct LanguageItem {
    code: string,
    name: string,
    native_name: string,
    is_selected: bool,
}

struct AudioDeviceItem {
    id: string,
    name: string,
    is_selected: bool,
}

struct VoiceParticipant {
    user_id: string,
    username: string,
    avatar_text: string,
    is_speaking: bool,
    audio_level: float,
    is_muted: bool,
    volume: float,
    priority: int,
    is_self: bool,
}

export component AppWindow inherits Window {
    title: "Litecord - Ultra-Lightweight Discord Client";
    icon: @image-url("../assets/app_icon.png");
    no-frame: false;
    preferred-width: 980px;
    preferred-height: 620px;
    min-width: 680px;
    min-height: 480px;
    background: #1e1f22;

    // Callbacks to Rust backend
    callback drag_window();
    callback minimize_window();
    callback maximize_window();
    callback close_window();
    callback login(string /* token */);
    callback send_message(string /* content */);
    callback select_channel(string /* channel_id */);
    callback select_guild(string /* guild_id */);
    callback toggle_mute();
    callback toggle_deafen();
    callback leave_voice();
    callback minimize_to_tray();
    callback open_settings();
    callback close_settings();
    callback select_input_device(string /* device_name */);
    callback select_output_device(string /* device_name */);
    callback auto_detect_token();
    callback toggle_user_mute(string /* user_id */);
    callback set_user_volume(string /* user_id */, float /* volume */);
    callback set_user_priority(string /* user_id */, int /* priority */);
    callback toggle_voice_focus();
    callback open_link(string /* url */);
    callback set_vad_threshold(float /* threshold */);
    callback toggle_test_mic();
    callback logout();
    callback change_language(string /* "auto", "en", "pt" */);
    callback refresh_qr_code();
    callback drag_resize(string /* "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right" */);

    // Translations (i18n)
    in-out property <string> current_language_code: "auto";
    in-out property <string> tr_login_title: "Sign in to Litecord";
    in-out property <string> tr_login_desc: "Enter your Discord User Token for direct connection to Gateway v9.\n(Estimated RAM usage ~15MB)";
    in-out property <string> tr_login_placeholder: "Paste your Discord User Token here...";
    in-out property <string> tr_login_btn_connect: "Connect to Gateway";
    in-out property <string> tr_login_btn_detect: "Detect Discord Token";
    in-out property <string> tr_server_channels: "SERVER CHANNELS";
    in-out property <string> tr_leave: "Leave";
    in-out property <string> tr_view_text_chat: "View Text Chat";
    in-out property <string> tr_leave_call: "Disconnect Call";
    in-out property <string> tr_voice_participants_title: "VOICE ROOM PARTICIPANTS";
    in-out property <string> tr_badge_you: "YOU";
    in-out property <string> tr_view_voice_room: "View Voice Room";
    in-out property <string> tr_replying_to: "Replying to @";
    in-out property <string> tr_chat_placeholder_prefix: "Message ";
    in-out property <string> tr_send: "Send";
    in-out property <string> tr_settings_title: "Voice & Audio Settings";
    in-out property <string> tr_settings_language_label: "LANGUAGE / IDIOMA";
    in-out property <string> tr_settings_input_device: "INPUT DEVICE (MICROPHONE)";
    in-out property <string> tr_settings_output_device: "OUTPUT DEVICE (SPEAKERS / HEADPHONES)";
    in-out property <string> tr_settings_threshold: "VOICE DETECTION SENSITIVITY (THRESHOLD)";
    in-out property <string> tr_settings_mic_level: "REAL-TIME MICROPHONE LEVEL";
    in-out property <string> tr_settings_btn_test_start: "🎧 Test Microphone (\"Hear Yourself\")";
    in-out property <string> tr_settings_btn_test_stop: "🎙️ Stop Testing (Listening...)";
    in-out property <string> tr_settings_done: "Done";
    in-out property <string> tr_logout_title: "Sign Out";
    in-out property <string> tr_logout_confirm_prefix: "Do you want to log out from ";
    in-out property <string> tr_cancel: "Cancel";
    in-out property <string> tr_confirm_logout: "Sign Out";
    in-out property <string> tr_voice_connecting: "Connecting...";
    in-out property <string> tr_voice_connecting_title: "Connecting to Voice Channel...";
    in-out property <string> tr_voice_connecting_desc: "Authenticating with Voice Gateway v9 and negotiating DAVE E2EE encryption...";
    in-out property <string> tr_voice_connected: "Voice Connected";
    in-out property <string> tr_qr_title: "Log in with QR Code";
    in-out property <string> tr_qr_desc: "Scan this with the Discord mobile app to log in instantly.";
    in-out property <string> tr_qr_confirm: "Approve login on your phone!";

    // QR Code Login Properties
    in-out property <image> qr_code_image;
    in-out property <bool> has_qr_code: false;
    in-out property <bool> is_qr_loading: false;
    in-out property <string> qr_scanned_user: "";

    // Properties exposed to Rust backend
    in-out property <bool> is_logged_in: false;
    in-out property <string> connection_status: "Aguardando Token de Acesso...";
    in-out property <string> user_tag: "Não conectado";
    in-out property <string> active_channel_name: "Selecione um canal";
    in-out property <bool> is_muted: false;
    in-out property <bool> is_deafened: false;
    in-out property <bool> is_in_voice: false;
    in-out property <bool> is_voice_connecting: false;
    in-out property <string> current_voice_channel: "";
    in-out property <bool> is_voice_focused: false;
    in-out property <[VoiceParticipant]> voice_participants: [];
    in-out property <bool> show_user_menu: false;

    // Voice & Audio Settings Properties
    in-out property <bool> show_settings_modal: false;
    in-out property <[LanguageItem]> languages: [];
    in-out property <[AudioDeviceItem]> input_devices: [];
    in-out property <[AudioDeviceItem]> output_devices: [];
    in-out property <string> selected_input_device: "Microfone Padrão do Sistema";
    in-out property <string> selected_output_device: "Alto-falantes Padrão do Sistema";
    in-out property <float> mic_level: 0.0; // Real-time mic volume level (0.0 to 1.0)
    in-out property <float> vad_threshold: 0.05; // Voice Activity Detection Threshold (0.0 to 1.0)
    in-out property <bool> is_testing_mic: false; // Mic loopback ("Se ouvir") test active

    in-out property <[GuildItem]> guilds: [];
    in-out property <[ChannelItem]> channels: [];
    in-out property <[ChatMessage]> messages: [
        { author: "Litecord System", timestamp: "Agora", content: "Bem-vindo ao Litecord! Seus servidores carregarão na barra lateral à esquerda." }
    ];

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Status Header Bar (Frameless Custom Titlebar)
        Rectangle {
            height: 32px;
            background: #111214;

            TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.drag_window();
                    }
                }
            }

            HorizontalBox {
                padding-left: 12px;
                padding-right: 146px;
                padding-top: 0px;
                padding-bottom: 0px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/app_icon.png");
                                width: 16px;
                                height: 16px;
                                colorize: #ffffff;
                                image-fit: contain;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "LITECORD";
                                color: #ffffff;
                                font-weight: 800;
                                font-size: 13px;
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.connection_status;
                        color: #949ba4;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("../assets/settings.svg");
                        clicked => { root.open_settings(); }
                    }
                }
            }

            // Custom Window Control Buttons (Minimize, Maximize, Close)
            HorizontalLayout {
                x: parent.width - 138px;
                y: 0px;
                width: 138px;
                height: 32px;
                spacing: 0px;

                // Minimize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: min-touch.has-hover ? #2b2d31 : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-minimize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: #dbdee1;
                                image-fit: contain;
                            }
                        }
                    }

                    min-touch := TouchArea {
                        clicked => { root.minimize_window(); }
                    }
                }

                // Maximize
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: max-touch.has-hover ? #2b2d31 : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-maximize.svg");
                                width: 10px;
                                height: 10px;
                                colorize: #dbdee1;
                                image-fit: contain;
                            }
                        }
                    }

                    max-touch := TouchArea {
                        clicked => { root.maximize_window(); }
                    }
                }

                // Close
                Rectangle {
                    width: 46px;
                    height: 32px;
                    background: close-touch.has-hover ? #f23f43 : transparent;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/chrome-close.svg");
                                width: 10px;
                                height: 10px;
                                colorize: close-touch.has-hover ? #ffffff : #dbdee1;
                                image-fit: contain;
                            }
                        }
                    }

                    close-touch := TouchArea {
                        clicked => { root.close_window(); }
                    }
                }
            }
        }

        // Body Content
        if !root.is_logged_in: Rectangle {
            background: #1e1f22;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 720px;
                        height: 380px;
                        background: #2b2d31;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #383a40;

                        HorizontalLayout {
                            padding: 32px;
                            spacing: 32px;

                            // Left Column: Token / Auto-Detect Login
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;

                                    Image {
                                        source: @image-url("../assets/app_icon.png");
                                        width: 26px;
                                        height: 26px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: root.tr_login_title;
                                        color: #f2f3f5;
                                        font-size: 20px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.tr_login_desc;
                                    color: #949ba4;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                token_input := LineEdit {
                                    placeholder-text: root.tr_login_placeholder;
                                    input-type: password;
                                    accepted => {
                                        if (token_input.text != "") {
                                            root.login(token_input.text);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/rocket.svg");
                                        text: root.tr_login_btn_connect;
                                        primary: true;
                                        clicked => {
                                            if (token_input.text != "") {
                                                root.login(token_input.text);
                                            }
                                        }
                                    }

                                    Button {
                                        horizontal-stretch: 1;
                                        icon: @image-url("../assets/search.svg");
                                        text: root.tr_login_btn_detect;
                                        clicked => {
                                            root.auto_detect_token();
                                        }
                                    }
                                }
                            }

                            // Middle Divider
                            Rectangle {
                                width: 1px;
                                background: #383a40;
                            }

                            // Right Column: Official QR Code Login
                            VerticalLayout {
                                width: 230px;
                                alignment: center;
                                spacing: 12px;

                                // QR Code Card Container
                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 160px;
                                        height: 160px;
                                        background: #ffffff;
                                        border-radius: 8px;
                                        clip: true;

                                        if root.has_qr_code: Image {
                                            source: root.qr_code_image;
                                            width: 160px;
                                            height: 160px;
                                            image-fit: contain;
                                        }

                                        if !root.has_qr_code: VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("../assets/qr.svg");
                                                    width: 32px;
                                                    height: 32px;
                                                    colorize: #5865f2;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Gerar QR";
                                                    clicked => { root.refresh_qr_code(); }
                                                }
                                            }
                                        }

                                        // User Scanned Overlay Badge
                                        if root.qr_scanned_user != "": Rectangle {
                                            background: #111214e6;
                                            width: 100%;
                                            height: 100%;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                padding: 8px;

                                                Text {
                                                    text: "✅ " + root.qr_scanned_user;
                                                    color: #23a55a;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: root.tr_qr_confirm;
                                                    color: #ffffff;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.tr_qr_title;
                                    color: #f2f3f5;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_qr_desc;
                                    color: #949ba4;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.is_logged_in: HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // 1. Guilds Sidebar (Servidores com Scroll e tamanho fixado)
            Rectangle {
                width: 72px;
                background: #1e1f22;

                VerticalBox {
                    padding: 8px;
                    spacing: 0px;

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 10px;
                                alignment: start;

                                for guild in root.guilds: Rectangle {
                                    height: 48px;
                                    width: 48px;
                                    background: #313338;
                                    border-radius: 24px;
                                    clip: true;

                                    if guild.has_image: Image {
                                        source: guild.icon_image;
                                        width: 48px;
                                        height: 48px;
                                        image-fit: cover;
                                    }

                                    if !guild.has_image: Text {
                                        text: guild.icon;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    TouchArea {
                                        clicked => { root.select_guild(guild.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Channels Sidebar (Canais com Scroll e tamanho fixado)
            Rectangle {
                width: 230px;
                background: #2b2d31;

                VerticalBox {
                    padding: 8px;
                    spacing: 6px;

                    Text {
                        text: root.tr_server_channels;
                        color: #949ba4;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 4px;
                                alignment: start;

                                for channel in root.channels: Rectangle {
                                    height: 34px;
                                    background: #35373c;
                                    border-radius: 6px;

                                    HorizontalBox {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;

                                        if channel.is_voice : Image {
                                            source: @image-url("../assets/speaker.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #23a55a;
                                        }
                                        if !channel.is_voice : Text {
                                            text: "#";
                                            color: #80848e;
                                            font-size: 16px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: channel.name;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if channel.is_voice && channel.voice_count > 0 : Rectangle {
                                            width: 22px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: #23a55a;

                                            Text {
                                                text: "\{channel.voice_count}";
                                                color: #ffffff;
                                                font-size: 10px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.select_channel(channel.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Active Voice Channel Banner
                    if root.is_in_voice: Rectangle {
                        height: 44px;
                        background: root.is_voice_connecting ? #d97706 : #23a55a;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: #ffffff;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: root.is_voice_connecting ? root.tr_voice_connecting : root.tr_voice_connected;
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 800;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.current_voice_channel;
                                    color: #f1f5f9;
                                    font-size: 10px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_leave;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // User Footer in Channels bar
                    Rectangle {
                        height: 58px;
                        background: #232428;
                        border-radius: 6px;

                        VerticalBox {
                            padding-top: 4px;
                            padding-bottom: 6px;
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;

                            Rectangle {
                                background: user_tag_touch.has-hover ? #35373c : transparent;
                                border-radius: 4px;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 4px;

                                    Text {
                                        text: root.user_tag;
                                        color: user_tag_touch.has-hover ? #5865f2 : #f2f3f5;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                user_tag_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = !root.show_user_menu;
                                    }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 4px;

                                IconButton {
                                    icon: root.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                    icon-color: root.is_muted ? #f23f43 : #dbdee1;
                                    clicked => { root.toggle_mute(); }
                                }

                                IconButton {
                                    icon: root.is_deafened ? @image-url("../assets/headphones-mute.svg") : @image-url("../assets/headphones.svg");
                                    icon-color: root.is_deafened ? #f23f43 : #dbdee1;
                                    clicked => { root.toggle_deafen(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/settings.svg");
                                    clicked => { root.open_settings(); }
                                }
                            }
                        }
                    }
                }
            }

            // 3. Main Content View (Text Chat OR Voice Room View)
            Rectangle {
                background: #313338;
                horizontal-stretch: 1;

                if root.is_voice_focused && root.is_in_voice: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Voice Room Header Bar
                    Rectangle {
                        height: 44px;
                        background: #2b2d31;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #ffffff;
                                    image-fit: contain;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.current_voice_channel;
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 800;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/message-square.svg");
                                    text: root.tr_view_text_chat;
                                    clicked => { root.toggle_voice_focus(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_leave_call;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // Voice Room Connecting Loading State
                    if root.is_voice_connecting: Rectangle {
                        vertical-stretch: 1;
                        background: #1e1f22;

                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 68px;
                                    height: 68px;
                                    border-radius: 34px;
                                    background: #2b2d31;
                                    border-width: 2px;
                                    border-color: #5865f2;

                                    Image {
                                        source: @image-url("../assets/speaker.svg");
                                        width: 28px;
                                        height: 28px;
                                        colorize: #5865f2;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: root.tr_voice_connecting_title;
                                    color: #ffffff;
                                    font-size: 16px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.tr_voice_connecting_desc;
                                    color: #949ba4;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("../assets/log-out.svg");
                                    text: root.tr_cancel;
                                    clicked => { root.leave_voice(); }
                                }
                            }
                        }
                    }

                    // Voice Room Participants List View
                    if !root.is_voice_connecting: Rectangle {
                        vertical-stretch: 1;
                        background: #313338;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: root.tr_voice_participants_title + " (" + root.voice_participants.length + ")";
                                color: #949ba4;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            ListView {
                                for p in root.voice_participants: Rectangle {
                                    height: 76px;
                                    background: #00000000;

                                    Rectangle {
                                        y: 4px;
                                        height: 68px;
                                        background: p.is_self ? #232738 : #2b2d31;
                                        border-radius: 8px;
                                        border-width: p.is_self ? 1px : 0px;
                                        border-color: p.is_self ? #5865f2 : #00000000;

                                        HorizontalBox {
                                             padding-left: 12px;
                                             padding-right: 12px;
                                             spacing: 12px;

                                             // Avatar Badge with Glowing Green Ring when speaking / Blue accent for self!
                                             VerticalLayout {
                                                 alignment: center;
                                                 Rectangle {
                                                     width: 42px;
                                                     height: 42px;
                                                     border-radius: 21px;
                                                     background: p.is_speaking ? #23a55a : (p.is_self ? #5865f2 : #383a40);
                                                     border-width: p.is_speaking ? 3px : (p.is_self ? 2px : 0px);
                                                     border-color: p.is_speaking ? #23a55a : (p.is_self ? #7983f5 : #00000000);

                                                     Text {
                                                         text: p.avatar_text;
                                                         color: #ffffff;
                                                         font-size: 16px;
                                                         font-weight: 700;
                                                         horizontal-alignment: center;
                                                         vertical-alignment: center;
                                                     }
                                                 }
                                             }

                                             // Username & Controls in a Vertical Stack!
                                             VerticalBox {
                                                 horizontal-stretch: 1;
                                                 alignment: center;
                                                 spacing: 6px;
                                                 padding: 0px;

                                                 // Row 1: Username & Badges
                                                 HorizontalLayout {
                                                     spacing: 8px;
                                                     Text {
                                                         text: p.username;
                                                         color: p.is_self ? #7983f5 : (p.is_speaking ? #ffffff : #dbdee1);
                                                         font-weight: 700;
                                                         font-size: 14px;
                                                         vertical-alignment: center;
                                                     }

                                                     if p.is_self: Rectangle {
                                                         background: #5865f2;
                                                         border-radius: 4px;
                                                         height: 16px;
                                                         HorizontalLayout {
                                                             padding-left: 6px;
                                                             padding-right: 6px;
                                                             Text {
                                                                 text: root.tr_badge_you;
                                                                 color: #ffffff;
                                                                 font-size: 9px;
                                                                 font-weight: 800;
                                                                 vertical-alignment: center;
                                                             }
                                                         }
                                                     }

                                                     if p.is_muted: HorizontalLayout {
                                                         spacing: 4px;
                                                         alignment: start;
                                                         Image {
                                                             source: @image-url("../assets/volume-x.svg");
                                                             width: 12px;
                                                             height: 12px;
                                                             colorize: #f23f43;
                                                         }
                                                         Text {
                                                             text: p.is_self ? "MUTED" : "MUTED";
                                                             color: #f23f43;
                                                             font-size: 11px;
                                                             font-weight: 700;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                 }

                                                 // Row 2: Controls vs Self Info
                                                 if p.is_self: HorizontalLayout {
                                                     spacing: 12px;

                                                     // Animated Mic Volume Meter Bar for Self
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: #1e1f22;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? #23a55a : #5865f2;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Status description for Self
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: root.is_muted ? "Muted" : (p.is_speaking ? "Transmitting..." : "Mic active");
                                                             color: root.is_muted ? #f23f43 : (p.is_speaking ? #23a55a : #80848e);
                                                             font-size: 11px;
                                                             font-weight: 600;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                 }

                                                 if !p.is_self: HorizontalLayout {
                                                     spacing: 16px;

                                                     // Animated Volume Level Meter Bar
                                                     VerticalLayout {
                                                         horizontal-stretch: 1;
                                                         alignment: center;
                                                         Rectangle {
                                                             height: 8px;
                                                             background: #1e1f22;
                                                             border-radius: 4px;

                                                             Rectangle {
                                                                 x: 0px;
                                                                 y: 0px;
                                                                 height: 8px;
                                                                 width: p.audio_level * parent.width;
                                                                 background: p.is_speaking ? #23a55a : #5865f2;
                                                                 border-radius: 4px;
                                                             }
                                                         }
                                                     }

                                                     // Mute Button
                                                     VerticalLayout {
                                                         alignment: center;
                                                         IconButton {
                                                             icon: p.is_muted ? @image-url("../assets/microphone-mute.svg") : @image-url("../assets/microphone.svg");
                                                             icon-color: p.is_muted ? #f23f43 : #dbdee1;
                                                             clicked => { root.toggle_user_mute(p.user_id); }
                                                         }
                                                     }

                                                     // Volume Text
                                                     VerticalLayout {
                                                         alignment: center;
                                                         Text {
                                                             text: "Vol: " + Math.round(p.volume * 100) + "%";
                                                             color: #b5bac1;
                                                             font-size: 11px;
                                                             vertical-alignment: center;
                                                         }
                                                     }

                                                      // Slider
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Slider {
                                                              width: 110px;
                                                              minimum: 0.0;
                                                              maximum: 1.0;
                                                              value: p.volume;
                                                              changed(val) => { root.set_user_volume(p.user_id, val); }
                                                          }
                                                      }

                                                      // Speech Priority Control Box (Prioridade de Fala)
                                                      VerticalLayout {
                                                          alignment: center;
                                                          Rectangle {
                                                              width: 86px;
                                                              height: 24px;
                                                              background: #2b2d31;
                                                              border-radius: 6px;
                                                              border-width: 1px;
                                                              border-color: p.priority > 0 ? #5865f2 : #383a40;

                                                              HorizontalLayout {
                                                                  padding: 2px;
                                                                  spacing: 2px;

                                                                  // "-" Decrement Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: btn_minus.has-hover ? #35373c : #1e1f22;

                                                                      Text {
                                                                          text: "-";
                                                                          color: p.priority > 0 ? #f23f43 : #4e5058;
                                                                          font-size: 14px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      btn_minus := TouchArea {
                                                                          clicked => {
                                                                              if (p.priority > 0) {
                                                                                  root.set_user_priority(p.user_id, p.priority - 1);
                                                                              }
                                                                          }
                                                                      }
                                                                  }

                                                                  // Priority Indicator Text (P:0, P:1, P:2...)
                                                                  Text {
                                                                      text: "P:" + p.priority;
                                                                      color: p.priority > 0 ? #5865f2 : #949ba4;
                                                                      font-size: 11px;
                                                                      font-weight: 700;
                                                                      horizontal-alignment: center;
                                                                      vertical-alignment: center;
                                                                      horizontal-stretch: 1;
                                                                  }

                                                                  // "+" Increment Button
                                                                  Rectangle {
                                                                      width: 20px;
                                                                      height: 20px;
                                                                      border-radius: 4px;
                                                                      background: btn_plus.has-hover ? #35373c : #1e1f22;

                                                                      Text {
                                                                          text: "+";
                                                                          color: #23a55a;
                                                                          font-size: 14px;
                                                                          font-weight: 700;
                                                                          horizontal-alignment: center;
                                                                          vertical-alignment: center;
                                                                      }

                                                                      btn_plus := TouchArea {
                                                                          clicked => {
                                                                              root.set_user_priority(p.user_id, p.priority + 1);
                                                                          }
                                                                      }
                                                                  }
                                                              }
                                                          }
                                                      }
                                                 }
                                             }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if (!root.is_voice_focused || !root.is_in_voice): VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Channel Header
                    Rectangle {
                        height: 42px;
                        background: #313338;

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;

                            Text {
                                text: root.active_channel_name;
                                color: #f2f3f5;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.is_in_voice: Button {
                                icon: @image-url("../assets/speaker.svg");
                                text: root.tr_view_voice_room;
                                clicked => { root.toggle_voice_focus(); }
                            }
                        }
                    }

                    // Messages Scroll View
                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 12px;
                                spacing: 10px;

                                for msg in root.messages: Rectangle {
                                    background: #2b2d31;
                                    border-radius: 6px;
                                    property <bool> is-collapsed: true;

                                     VerticalBox {
                                         padding: 8px;
                                         spacing: 4px;

                                         if msg.reply-author != "": Rectangle {
                                             background: #1e293b;
                                             border-radius: 4px;
                                             border-width: 1px;
                                             border-color: #3b82f6;

                                             VerticalLayout {
                                                 padding: 6px;
                                                 spacing: 4px;

                                                 HorizontalLayout {
                                                     spacing: 6px;

                                                     VerticalLayout {
                                                         alignment: center;
                                                         Image {
                                                             source: @image-url("../assets/reply.svg");
                                                             width: 11px;
                                                             height: 11px;
                                                             colorize: #3b82f6;
                                                             image-fit: contain;
                                                         }
                                                     }

                                                     Text {
                                                         text: root.tr_replying_to + msg.reply-author;
                                                         color: #3b82f6;
                                                         font-size: 10px;
                                                         font-weight: 700;
                                                         vertical-alignment: center;
                                                     }
                                                 }

                                                 Text {
                                                     text: msg.reply-content;
                                                     color: #94a3b8;
                                                     font-size: 10.5px;
                                                     wrap: word-wrap;
                                                 }
                                             }
                                         }

                                         HorizontalLayout {
                                             spacing: 8px;
                                            Text {
                                                text: msg.author;
                                                color: #5865f2;
                                                font-weight: 700;
                                                font-size: 13px;
                                            }

                                            Text {
                                                text: msg.timestamp;
                                                color: #949ba4;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }

                                            // Push the button to the right end
                                            Rectangle { }

                                            // Collapse/Expand button (only if links are present)
                                            if msg.links.length > 0 : Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                background: transparent;
                                                Text {
                                                    text: is-collapsed ? "▼" : "▲";
                                                    color: #949ba4;
                                                    font-size: 10px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        is-collapsed = !is-collapsed;
                                                    }
                                                }
                                            }
                                        }

                                        // Regular message content
                                        if msg.content != "": Text {
                                            text: msg.content;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }

                                        // Monospaced Code Block Box (visual representation of block code)
                                        if msg.code-block != "": Rectangle {
                                            background: #1e1f22;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #2b2d31;

                                            VerticalLayout {
                                                padding: 8px;
                                                Text {
                                                    text: msg.code-block;
                                                    color: #e6c07b;
                                                    font-family: "Courier New";
                                                    font-size: 12.5px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Embed box with colored left bar (always visible if present)
                                        if msg.embed-content != "" || msg.embed-footer != "": Rectangle {
                                            background: #232428;
                                            border-radius: 4px;

                                            HorizontalLayout {
                                                // Colored left bar
                                                Rectangle {
                                                    width: 4px;
                                                    background: msg.embed_color;
                                                    border-top-left-radius: 4px;
                                                    border-bottom-left-radius: 4px;
                                                }

                                                // Embed content layout
                                                VerticalLayout {
                                                    padding: 10px;
                                                    padding-left: 12px;
                                                    spacing: 8px;

                                                    if msg.embed-content != "": Text {
                                                        text: msg.embed-content;
                                                        color: #d2d5d9;
                                                        font-size: 12.5px;
                                                        wrap: word-wrap;
                                                    }

                                                    // Horizontal separator (representing dashes)
                                                    if msg.embed-footer != "": Rectangle {
                                                        height: 1px;
                                                        background: #3f4147;
                                                    }

                                                    // Footer content
                                                    if msg.embed-footer != "": Text {
                                                        text: msg.embed-footer;
                                                        color: #949ba4;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }

                                        // Clickable attachments / links list (toggled by is-collapsed, starts hidden)
                                        if msg.links.length > 0 && !is-collapsed : VerticalLayout {
                                            spacing: 6px;
                                            padding-top: 4px;
                                            for link in msg.links : Rectangle {
                                                height: 20px;
                                                background: transparent;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "🔗";
                                                        color: #00b0f4;
                                                        vertical-alignment: center;
                                                        font-size: 11px;
                                                    }
                                                    Text {
                                                        text: link.label;
                                                        color: #00b0f4;
                                                        vertical-alignment: center;
                                                        font-size: 13px;
                                                        font-weight: 500;
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.open_link(link.url);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Message Input Box
                    Rectangle {
                        height: 56px;
                        background: #313338;

                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;

                            msg_input := LineEdit {
                                placeholder-text: root.tr_chat_placeholder_prefix + root.active_channel_name + "...";
                                accepted => {
                                    if (msg_input.text != "") {
                                        root.send_message(msg_input.text);
                                        msg_input.text = "";
                                    }
                                }
                            }

                            Button {
                                text: root.tr_send;
                                primary: true;
                                clicked => {
                                    if (msg_input.text != "") {
                                        root.send_message(msg_input.text);
                                        msg_input.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Popup Overlay for Voice & Audio Settings (Discord Style)
    if root.show_settings_modal: Rectangle {
        background: #000000bb;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 580px;
            height: Math.min(560px, parent.height - 40px);
            background: #2b2d31;
            border-radius: 12px;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                // Header Title & Close Button
                HorizontalBox {
                    HorizontalLayout {
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/settings.svg");
                            width: 20px;
                            height: 20px;
                        }
                        Text {
                            text: root.tr_settings_title;
                            color: #f2f3f5;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        icon: @image-url("../assets/x.svg");
                        text: root.tr_leave;
                        clicked => { root.close_settings(); }
                    }
                }

                // Scrollable Settings Content Body
                ScrollView {
                    vertical-stretch: 1;

                    VerticalBox {
                        padding-right: 6px;
                        spacing: 12px;

                        // 0. Language Selector (Idioma / Language)
                        HorizontalLayout {
                            spacing: 6px;
                            Image {
                                source: @image-url("../assets/globe.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #5865f2;
                            }
                            Text {
                                text: root.tr_settings_language_label;
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 105px;
                            background: #1e1f22;
                            border-radius: 8px;

                            ScrollView {
                                height: 100%;
                                width: 100%;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for lang in root.languages: Rectangle {
                                        height: 30px;
                                        background: lang.is_selected ? #35373c : #2b2d31;
                                        border-radius: 6px;

                                        HorizontalBox {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: lang.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                width: 14px;
                                                height: 14px;
                                            }

                                            Text {
                                                text: lang.name;
                                                color: lang.is_selected ? #5865f2 : #dbdee1;
                                                font-size: 12px;
                                                font-weight: lang.is_selected ? 700 : 400;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            Text {
                                                text: lang.native_name;
                                                color: #80848e;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.change_language(lang.code); }
                                        }
                                    }
                                }
                            }
                        }

                        // 1. Microphone Input Device Selection
                        HorizontalLayout {
                            spacing: 6px;
                            Image {
                                source: @image-url("../assets/microphone.svg");
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                text: root.tr_settings_input_device;
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 95px;
                            background: #1e1f22;
                            border-radius: 8px;

                            ScrollView {
                                height: 100%;
                                width: 100%;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for dev in root.input_devices: Rectangle {
                                        height: 30px;
                                        background: dev.is_selected ? #35373c : #2b2d31;
                                        border-radius: 6px;

                                        HorizontalBox {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                width: 14px;
                                                height: 14px;
                                            }

                                            Text {
                                                text: dev.name;
                                                color: dev.is_selected ? #5865f2 : #dbdee1;
                                                font-size: 12px;
                                                font-weight: dev.is_selected ? 700 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.select_input_device(dev.name); }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Speaker / Headphone Output Device Selection
                        HorizontalLayout {
                            spacing: 6px;
                            Image {
                                source: @image-url("../assets/headphones.svg");
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                text: root.tr_settings_output_device;
                                color: #b5bac1;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 95px;
                            background: #1e1f22;
                            border-radius: 8px;

                            ScrollView {
                                height: 100%;
                                width: 100%;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for dev in root.output_devices: Rectangle {
                                        height: 30px;
                                        background: dev.is_selected ? #35373c : #2b2d31;
                                        border-radius: 6px;

                                        HorizontalBox {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;

                                            Image {
                                                source: dev.is_selected ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                width: 14px;
                                                height: 14px;
                                            }

                                            Text {
                                                text: dev.name;
                                                color: dev.is_selected ? #5865f2 : #dbdee1;
                                                font-size: 12px;
                                                font-weight: dev.is_selected ? 700 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.select_output_device(dev.name); }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. VAD Threshold Control Slider
                        HorizontalBox {
                            HorizontalLayout {
                                spacing: 6px;
                                Image {
                                    source: @image-url("../assets/microphone.svg");
                                    width: 14px;
                                    height: 14px;
                                }
                                Text {
                                    text: root.tr_settings_threshold;
                                    color: #b5bac1;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // High-visibility Percentage Badge
                            Rectangle {
                                background: #5865f2;
                                border-radius: 4px;
                                height: 18px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: Math.round(root.vad_threshold * 100) + "%";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;

                            Text {
                                text: "0%";
                                color: #80848e;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0.0;
                                maximum: 0.40;
                                value: root.vad_threshold;
                                changed(val) => {
                                    root.vad_threshold = val;
                                    root.set_vad_threshold(val);
                                }
                            }

                            Text {
                                text: "40%";
                                color: #80848e;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // 4. Mic Level Test Indicator Bar (Dynamic Real-Time Level & Threshold Marker)
                        HorizontalBox {
                            HorizontalLayout {
                                spacing: 6px;
                                Image {
                                    source: @image-url("../assets/speaker.svg");
                                    width: 14px;
                                    height: 14px;
                                }
                                Text {
                                    text: root.tr_settings_mic_level;
                                    color: #b5bac1;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.mic_level >= root.vad_threshold 
                                    ? "VOICE ACTIVE (" + Math.round(root.mic_level * 100) + "% / Lim: " + Math.round(root.vad_threshold * 100) + "%)" 
                                    : "SILENCE (" + Math.round(root.mic_level * 100) + "% / Lim: " + Math.round(root.vad_threshold * 100) + "%)";
                                color: root.mic_level >= root.vad_threshold ? #23a55a : #949ba4;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            background: #1e1f22;
                            border-radius: 6px;

                            // Active Mic Volume Fill
                            HorizontalBox {
                                padding: 3px;
                                spacing: 0px;

                                Rectangle {
                                    width: Math.max(4px, (root.mic_level * 460) * 1px);
                                    height: 14px;
                                    background: root.mic_level >= root.vad_threshold ? #23a55a : #f0b232;
                                    border-radius: 4px;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            // Threshold position indicator marker line
                            Rectangle {
                                x: (root.vad_threshold * 460) * 1px;
                                y: 0px;
                                width: 2px;
                                height: 20px;
                                background: #ffffff;
                            }
                        }
                    }
                }

                // 5. Pinned Footer Action Bar (Always Visible!)
                HorizontalBox {
                    spacing: 10px;

                    Button {
                        text: root.is_testing_mic ? root.tr_settings_btn_test_stop : root.tr_settings_btn_test_start;
                        primary: root.is_testing_mic;
                        clicked => { root.toggle_test_mic(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: root.tr_settings_done;
                        primary: true;
                        clicked => { root.close_settings(); }
                    }
                }
            }
        }
    }

    // Small Centered Logout Confirmation Modal
    if root.show_user_menu: Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => { root.show_user_menu = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 280px;
                    height: 135px;
                    background: #2b2d31;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #383a40;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000088;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.tr_logout_title;
                            color: #f2f3f5;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.tr_logout_confirm_prefix + root.user_tag + "?";
                            color: #b5bac1;
                            font-size: 12px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        HorizontalBox {
                            spacing: 8px;
                            padding: 0px;

                            // Voltar Button
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                background: back_touch.has-hover ? #3b3e45 : #35373c;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.tr_cancel;
                                        color: #dbdee1;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                back_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = false;
                                    }
                                }
                            }

                            // Sair Button (Danger Red / Logout)
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                background: logout_btn_touch.has-hover ? #c0353b : #da373c;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/log-out.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: #ffffff;
                                            image-fit: contain;
                                        }
                                    }

                                    Text {
                                        text: root.tr_confirm_logout;
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                logout_btn_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = false;
                                        root.logout();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Window Drag Resize Borders & Corner Handles (on PointerEventKind.down for 0-latency instant resize)
    // Left edge
    TouchArea {
        x: 0px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge
    TouchArea {
        x: parent.width - 7px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge
    TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    TouchArea {
        x: 12px;
        y: parent.height - 7px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    TouchArea {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Top-Right Corner
    TouchArea {
        x: parent.width - 12px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }
    // Bottom-Left Corner
    TouchArea {
        x: 0px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    TouchArea {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }
}

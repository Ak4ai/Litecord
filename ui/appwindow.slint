                                        // Horizontal Row Separator
                                        Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                        // --- ROW 4: VAD THRESHOLD SLIDER + GUIDE ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;

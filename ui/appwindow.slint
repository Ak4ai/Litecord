                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text {
                                                        text: "MLS RFC 9420";
                                                        color: AppTheme.success;
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text {
                                                    text: "Comunicação de voz criptografada ponta a ponta com os servidores de voz oficiais do Discord sem intermediários.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/lightning.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.success;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Zero Intermediários";
                                                        color: AppTheme.success;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: "Conexões 100% diretas com a API do Discord. Não existem servidores de terceiros ou telemetria embutida.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Generous Bottom Spacer
                                        Rectangle { height: 16px; }
                                    }

                                    // =============================================================
                                    // TAB 6: REDE & PROXY (OPTIONS AND GUIDES)
                                    // =============================================================
                                    if root.settings_active_tab == 6: VerticalLayout {
                                        spacing: 16px;

                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Options Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                min-width: 240px;
                                                padding-right: 12px;
                                                spacing: 12px;

                                                // Section 1: Proxy Mode Selector
                                                VerticalLayout {
                                                    spacing: 6px;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("../assets/globe.svg");
                                                                width: 14px;
                                                                height: 14px;
                                                                colorize: AppTheme.info;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        Text {
                                                            text: "Modo de Conexão Proxy";
                                                            color: AppTheme.text-strong;
                                                            font-size: 13px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Rectangle {
                                                        background: AppTheme.surface-input;
                                                        border-radius: 8px;
                                                        border-width: 1px;
                                                        border-color: AppTheme.surface-sidebar;

                                                        VerticalLayout {
                                                            padding-top: 4px;
                                                            padding-bottom: 4px;
                                                            padding-left: 4px;
                                                            padding-right: 4px;
                                                            spacing: 3px;

                                                            for opt in root.proxy_mode_options: Rectangle {
                                                                height: 40px;
                                                                background: (opt.id == root.selected_proxy_mode) ? AppTheme.interactive-hover : (opt_proxy_ta.has-hover ? AppTheme.surface-sidebar : transparent);
                                                                border-radius: 6px;
                                                                animate background { duration: 120ms; }

                                                                HorizontalLayout {
                                                                    padding-left: 8px;
                                                                    padding-right: 10px;
                                                                    spacing: 8px;

                                                                    VerticalLayout {
                                                                        alignment: center;
                                                                        Image {
                                                                            source: (opt.id == root.selected_proxy_mode) ? @image-url("../assets/radio-selected.svg") : @image-url("../assets/radio-unselected.svg");
                                                                            width: 16px;
                                                                            height: 16px;
                                                                            image-fit: contain;
                                                                        }
                                                                    }

                                                                    VerticalLayout {
                                                                        alignment: center;
                                                                        spacing: 1px;
                                                                        horizontal-stretch: 1;

                                                                        Text {
                                                                            text: opt.name;
                                                                            color: (opt.id == root.selected_proxy_mode) ? AppTheme.text-strong : AppTheme.text-primary;
                                                                            font-size: 11px;
                                                                            font-weight: (opt.id == root.selected_proxy_mode) ? 700 : 500;
                                                                            overflow: elide;
                                                                        }

                                                                        Text {
                                                                            text: opt.desc;
                                                                            color: (opt.id == root.selected_proxy_mode) ? AppTheme.text-muted : AppTheme.text-subtle;
                                                                            font-size: 10px;
                                                                            overflow: elide;
                                                                        }
                                                                    }
                                                                }

                                                                opt_proxy_ta := TouchArea {
                                                                    mouse-cursor: pointer;
                                                                    clicked => {
                                                                        root.selected_proxy_mode = opt.id;
                                                                        root.select_proxy_mode(opt.id);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                // Section 2: Host / Port / Credentials Inputs (only when HTTP or SOCKS5)
                                                if root.selected_proxy_mode == "http" || root.selected_proxy_mode == "socks5": VerticalLayout {
                                                    spacing: 8px;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("../assets/settings.svg");
                                                                width: 14px;
                                                                height: 14px;
                                                                colorize: AppTheme.info;
                                                                image-fit: contain;
                                                            }
                                                        }
                                                        Text {
                                                            text: "Endereço e Autenticação do Proxy";
                                                            color: AppTheme.text-strong;
                                                            font-size: 13px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    // Host & Port Row
                                                    HorizontalLayout {
                                                        spacing: 8px;

                                                        // Host Field
                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            min-width: 130px;
                                                            spacing: 4px;
                                                            Text {
                                                                text: "Servidor / IP Host:";
                                                                color: AppTheme.text-muted;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                            }
                                                            Rectangle {
                                                                height: 34px;
                                                                background: AppTheme.surface-input;
                                                                border-radius: 6px;
                                                                border-width: 1px;
                                                                border-color: proxy_host_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                                HorizontalLayout {
                                                                    padding-left: 10px;
                                                                    padding-right: 10px;
                                                                    proxy_host_input_box := TextInput {
                                                                        text <=> root.proxy_host_input;
                                                                        color: AppTheme.text-strong;
                                                                        font-size: 12px;
                                                                        vertical-alignment: center;
                                                                        single-line: true;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        // Port Field
                                                        VerticalLayout {
                                                            width: 80px;
                                                            spacing: 4px;
                                                            Text {
                                                                text: "Porta:";
                                                                color: AppTheme.text-muted;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                            }
                                                            Rectangle {
                                                                height: 34px;
                                                                background: AppTheme.surface-input;
                                                                border-radius: 6px;
                                                                border-width: 1px;
                                                                border-color: proxy_port_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                                HorizontalLayout {
                                                                    padding-left: 10px;
                                                                    padding-right: 10px;
                                                                    proxy_port_input_box := TextInput {
                                                                        text <=> root.proxy_port_input;
                                                                        color: AppTheme.text-strong;
                                                                        font-size: 12px;
                                                                        vertical-alignment: center;
                                                                        single-line: true;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // Username & Password Row
                                                    HorizontalLayout {
                                                        spacing: 8px;

                                                        // Username Field
                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            min-width: 100px;
                                                            spacing: 4px;
                                                            Text {
                                                                text: "Usuário (Opcional):";
                                                                color: AppTheme.text-muted;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                            }
                                                            Rectangle {
                                                                height: 34px;
                                                                background: AppTheme.surface-input;
                                                                border-radius: 6px;
                                                                border-width: 1px;
                                                                border-color: proxy_user_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                                HorizontalLayout {
                                                                    padding-left: 10px;
                                                                    padding-right: 10px;
                                                                    proxy_user_input_box := TextInput {
                                                                        text <=> root.proxy_username_input;
                                                                        color: AppTheme.text-strong;
                                                                        font-size: 12px;
                                                                        vertical-alignment: center;
                                                                        single-line: true;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        // Password Field
                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            min-width: 100px;
                                                            spacing: 4px;
                                                            Text {
                                                                text: "Senha (Opcional):";
                                                                color: AppTheme.text-muted;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                            }
                                                            Rectangle {
                                                                height: 34px;
                                                                background: AppTheme.surface-input;
                                                                border-radius: 6px;
                                                                border-width: 1px;
                                                                border-color: proxy_pass_input_box.has-focus ? AppTheme.info : AppTheme.border-subtle;

                                                                HorizontalLayout {
                                                                    padding-left: 10px;
                                                                    padding-right: 10px;
                                                                    proxy_pass_input_box := TextInput {
                                                                        text <=> root.proxy_password_input;
                                                                        color: AppTheme.text-strong;
                                                                        font-size: 12px;
                                                                        vertical-alignment: center;
                                                                        single-line: true;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                // Action Buttons & Status Feedback
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;

                                                    // Test Button
                                                    Rectangle {
                                                        height: 32px;
                                                        width: 115px;
                                                        background: test_btn_ta.has-hover ? AppTheme.surface-sidebar : AppTheme.surface-input;
                                                        border-radius: 6px;
                                                        border-width: 1px;
                                                        border-color: AppTheme.border-subtle;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            spacing: 6px;
                                                            VerticalLayout {
                                                                alignment: center;
                                                                Image {
                                                                    source: @image-url("../assets/lightning.svg");
                                                                    width: 13px;
                                                                    height: 13px;
                                                                    colorize: AppTheme.info;
                                                                    image-fit: contain;
                                                                }
                                                            }
                                                            Text {
                                                                text: root.proxy_is_testing ? "Testando..." : "Testar Proxy";
                                                                color: AppTheme.text-strong;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        test_btn_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.test_proxy_requested(
                                                                    root.selected_proxy_mode,
                                                                    root.proxy_host_input,
                                                                    root.proxy_port_input,
                                                                    root.proxy_username_input,
                                                                    root.proxy_password_input
                                                                );
                                                            }
                                                        }
                                                    }

                                                    // Save & Apply Button
                                                    Rectangle {
                                                        height: 32px;
                                                        width: 125px;
                                                        background: save_btn_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                                        border-radius: 6px;

                                                        HorizontalLayout {
                                                            alignment: center;
                                                            spacing: 6px;
                                                            Text {
                                                                text: "Salvar e Aplicar";
                                                                color: AppTheme.text-on-accent;
                                                                font-size: 11px;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        save_btn_ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.save_proxy_settings(
                                                                    root.selected_proxy_mode,
                                                                    root.proxy_host_input,
                                                                    root.proxy_port_input,
                                                                    root.proxy_username_input,
                                                                    root.proxy_password_input,
                                                                    root.proxy_route_media_enabled
                                                                );
                                                            }
                                                        }
                                                    }
                                                }

                                                // Test Status Message (Flexible auto-expanding container for multi-line error/success)
                                                if root.proxy_test_status_text != "": Rectangle {
                                                    background: root.proxy_test_is_success ? AppTheme.surface-success : AppTheme.surface-danger;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;

                                                    VerticalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        padding-top: 8px;
                                                        padding-bottom: 8px;

                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: start;

                                                            VerticalLayout {
                                                                alignment: start;
                                                                padding-top: 1px;
                                                                Image {
                                                                    source: root.proxy_test_is_success ? @image-url("../assets/lightning.svg") : @image-url("../assets/alert-triangle.svg");
                                                                    width: 13px;
                                                                    height: 13px;
                                                                    colorize: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;
                                                                    image-fit: contain;
                                                                }
                                                            }

                                                            Text {
                                                                text: root.proxy_test_status_text;
                                                                color: root.proxy_test_is_success ? AppTheme.success : AppTheme.danger;
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                                wrap: word-wrap;
                                                                horizontal-stretch: 1;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3)
                                            VerticalLayout {
                                                width: 220px;
                                                padding-left: 12px;
                                                padding-right: 10px;
                                                padding-top: 2px;
                                                spacing: 12px;

                                                // Guide 1: Burlar Bloqueios
                                                VerticalLayout {
                                                    spacing: 3px;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                             alignment: center;
                                                             Image {
                                                                 source: @image-url("../assets/shield.svg");
                                                                 width: 13px;
                                                                 height: 13px;
                                                                 colorize: AppTheme.info;
                                                                 image-fit: contain;
                                                             }
                                                         }
                                                         Text {
                                                             text: "Burlar Bloqueios";
                                                             color: AppTheme.info;
                                                             font-size: 11px;
                                                             font-weight: 700;
                                                             wrap: word-wrap;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Permite contornar firewalls e bloqueios de DNS em colégios ou empresas.";
                                                         color: AppTheme.text-muted;
                                                         font-size: 10px;
                                                         wrap: word-wrap;
                                                     }
                                                 }

                                                 // Guide 2: Tor e SOCKS5
                                                 VerticalLayout {
                                                     spacing: 3px;
                                                     HorizontalLayout {
                                                         spacing: 6px;
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Image {
                                                                 source: @image-url("../assets/key.svg");
                                                                 width: 13px;
                                                                 height: 13px;
                                                                 colorize: AppTheme.accent;
                                                                 image-fit: contain;
                                                             }
                                                         }
                                                         Text {
                                                             text: "Tor & SOCKS5";
                                                             color: AppTheme.accent;
                                                             font-size: 11px;
                                                             font-weight: 700;
                                                             wrap: word-wrap;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Compatível com a porta 9050 do Tor e túneis SSH locais para anonimizar seu IP.";
                                                         color: AppTheme.text-muted;
                                                         font-size: 10px;
                                                         wrap: word-wrap;
                                                     }
                                                 }

                                                 // Guide 3: Burp Suite & Devs
                                                 VerticalLayout {
                                                     spacing: 3px;
                                                     HorizontalLayout {
                                                         spacing: 6px;
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Image {
                                                                 source: @image-url("../assets/terminal.svg");
                                                                 width: 13px;
                                                                 height: 13px;
                                                                 colorize: AppTheme.warning;
                                                                 image-fit: contain;
                                                             }
                                                         }
                                                         Text {
                                                             text: "Debugging & Burp";
                                                             color: AppTheme.warning;
                                                             font-size: 11px;
                                                             font-weight: 700;
                                                             wrap: word-wrap;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Aponte para 127.0.0.1:8080 para inspecionar requisições da API REST.";
                                                         color: AppTheme.text-muted;
                                                         font-size: 10px;
                                                         wrap: word-wrap;
                                                     }
                                                 }

                                                 // Guide 4: Latência em Jogos
                                                 VerticalLayout {
                                                     spacing: 3px;
                                                     HorizontalLayout {
                                                         spacing: 6px;
                                                         VerticalLayout {
                                                             alignment: center;
                                                             Image {
                                                                 source: @image-url("../assets/lightning.svg");
                                                                 width: 13px;
                                                                 height: 13px;
                                                                 colorize: AppTheme.success;
                                                                 image-fit: contain;
                                                             }
                                                         }
                                                         Text {
                                                             text: "Desempenho em Jogos";
                                                             color: AppTheme.success;
                                                             font-size: 11px;
                                                             font-weight: 700;
                                                             wrap: word-wrap;
                                                             vertical-alignment: center;
                                                         }
                                                     }
                                                     Text {
                                                         text: "Com proxy desativado, o impacto é 0%. Voz e vídeo mantêm rotas UDP diretas.";
                                                         color: AppTheme.text-muted;
                                                         font-size: 10px;
                                                         wrap: word-wrap;
                                                     }
                                                 }
                                             }
                                        }

                                        // Generous Bottom Spacer
                                        Rectangle { height: 16px; }
                                    }

                                    // =============================================================
                                    // TAB 4: ATUALIZAÇÕES & SISTEMA (OPTIONS AND GUIDES)
                                    // =============================================================
                                    if root.settings_active_tab == 4: VerticalLayout {
                                        spacing: 16px;

                                        // --- ROW 1: UPDATER + GUIDE ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            HorizontalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 14px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 4px;
                                                    horizontal-stretch: 1;

                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text {
                                                            text: "Litecord Client";
                                                            color: AppTheme.text-strong;
                                                            font-size: 14px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: root.app_version;
                                                            color: AppTheme.accent;
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }

                                                        Rectangle { horizontal-stretch: 1; }
                                                    }

                                                    if root.update_check_feedback != "": Text {
                                                        text: root.update_check_feedback;
                                                        color: AppTheme.success;
                                                        font-size: 11px;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Button {
                                                        text: root.is_checking_update ? "Verificando..." : "Verificar Atualizações";
                                                        enabled: !root.is_checking_update;
                                                        clicked => { root.check_for_updates(); }
                                                    }
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/rocket.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.warning;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Canal Oficial de Releases";
                                                        color: AppTheme.warning;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: "As atualizações são verificadas diretamente no repositório do GitHub com validação de assinatura de domínio.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Horizontal Row Separator
                                        Rectangle { height: 1px; background: AppTheme.surface-divider-strong; }

                                        // --- ROW 2: ARCHITECTURE & DEEPSLEEP + GUIDE ---
                                        HorizontalLayout {
                                            spacing: 0px;

                                            // Option Block (Left - Col 2)
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                padding-right: 16px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/lightning.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.warning;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Performance Nativa em Rust";
                                                        color: AppTheme.text-strong;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: "• Uso de CPU: < 0.1% em idle (0.0% no modo DeepSleep na bandeja)\n• Memória RAM: ~32 MB (contra mais de 700 MB do Electron)\n• Pipeline de áudio Opus PLC com atenuação de volume inteligente";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            // Vertical Separator Line between Col 2 and Col 3
                                            Rectangle {
                                                width: 1px;
                                                background: AppTheme.border-subtle;
                                            }

                                            // Guide Block (Right - Col 3)
                                            VerticalLayout {
                                                width: 290px;
                                                padding-left: 16px;
                                                padding-top: 2px;
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/moon.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: AppTheme.success;
                                                            image-fit: contain;
                                                        }
                                                    }
                                                    Text {
                                                        text: "Modo DeepSleep";
                                                        color: AppTheme.success;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text {
                                                    text: "Ao minimizar para a bandeja, a interface congela sua renderização para garantir 100% de FPS para seus jogos.";
                                                    color: AppTheme.text-muted;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        // Generous Bottom Spacer
                                        Rectangle { height: 16px; }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: AppTheme.surface-elevated; }

                // 3. BOTTOM PINNED FOOTER BAR
                Rectangle {
                    height: 52px;
                    background: AppTheme.surface-input;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 12px;

                        Text {
                            text: "Litecord • Ultra-Fast Native Discord Client";
                            color: AppTheme.text-subtle;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.tr_settings_done;
                                primary: true;
                                clicked => { root.close_settings(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Multi-Account / Switch Account & Logout Modal
    if root.show_user_menu: Rectangle {
        background: AppTheme.backdrop-soft;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => { root.show_user_menu = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 350px;
                    background: AppTheme.surface-sidebar;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;

                    TouchArea {
                        clicked => {}
                    }

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        // Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Gerenciar Contas";
                                color: AppTheme.text-strong;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: close_menu_touch.has-hover ? AppTheme.surface-control-hover : transparent;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/x.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppTheme.text-primary;
                                        }
                                    }
                                }
                                close_menu_touch := TouchArea {
                                    clicked => { root.show_user_menu = false; }
                                }
                            }
                        }

                        Text {
                            text: "Troque rapidamente de conta ou adicione uma segunda conta salva.";
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        // List of Saved Accounts
                        VerticalBox {
                            padding: 0px;
                            spacing: 6px;

                            for acc in root.saved_accounts: Rectangle {
                                height: 54px;
                                background: acc.is_active ? AppTheme.surface-input : (card_info_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-elevated);
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: acc.is_active ? AppTheme.accent : AppTheme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    // Left Clickable Area (Avatar + Names)
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 10px;

                                        // Avatar circle with initials (centered vertically)
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                border-radius: 17px;
                                                background: acc.is_active ? AppTheme.accent : AppTheme.surface-control;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: acc.avatar_initials != "" ? acc.avatar_initials : "@";
                                                        color: AppTheme.text-on-accent;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Username & Tag (centered vertically)
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: acc.username != "" ? acc.username : acc.tag;
                                                color: AppTheme.text-strong;
                                                font-size: 12px;
                                                font-weight: 700;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: acc.tag;
                                                color: AppTheme.text-muted;
                                                font-size: 10px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        card_info_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if !acc.is_active {
                                                    root.show_user_menu = false;
                                                    root.switch_account(acc.id);
                                                }
                                            }
                                        }
                                    }

                                    // Right Action / Status Area (centered vertically)
                                    if acc.is_active: VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: "● Conectada";
                                                color: AppTheme.success;
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if !acc.is_active: VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            // Switch button (centered vertically)
                                            Rectangle {
                                                width: 62px;
                                                height: 28px;
                                                background: sw_btn.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                                border-radius: 4px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Entrar";
                                                        color: AppTheme.text-on-accent;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                sw_btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.show_user_menu = false;
                                                        root.switch_account(acc.id);
                                                    }
                                                }
                                            }

                                            // Remove single account trash button (centered vertically)
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                        background: del_btn.has-hover ? AppTheme.danger-action-muted : transparent;
                                                border-radius: 4px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/x.svg");
                                                            width: 12px;
                                                            height: 12px;
                                                            colorize: del_btn.has-hover ? AppTheme.danger : AppTheme.text-muted;
                                                        }
                                                    }
                                                }

                                                del_btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.remove_account(acc.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Add new account button
                        Rectangle {
                            height: 36px;
                            background: add_acc_touch.has-hover ? AppTheme.surface-control-hover : AppTheme.surface-chat;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: AppTheme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: "+ Adicionar Outra Conta";
                                    color: AppTheme.accent;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            add_acc_touch := TouchArea {
                                clicked => {
                                    root.show_user_menu = false;
                                    root.add_new_account();
                                }
                            }
                        }

                        // Separator
                        Rectangle {
                            height: 1px;
                            background: AppTheme.border-subtle;
                        }

                        // Bottom Actions
                        HorizontalBox {
                            spacing: 8px;
                            padding: 0px;

                            // Sair de Todas as Contas Button (Danger Red / Logout)
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                background: logout_btn_touch.has-hover ? AppTheme.danger-action-hover : AppTheme.danger-action;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/log-out.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: AppTheme.text-on-accent;
                                            image-fit: contain;
                                        }
                                    }

                                    Text {
                                        text: "Sair de Todas as Contas";
                                        color: AppTheme.text-on-accent;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                logout_btn_touch := TouchArea {
                                    clicked => {
                                        root.show_user_menu = false;
                                        root.logout();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Window Drag Resize Borders & Corner Handles (on PointerEventKind.down for 0-latency instant resize)
    // Left edge
    if root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge
    if root.drag_area_enabled: TouchArea {
        x: parent.width - 7px;
        y: 12px;
        width: 7px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge
    if root.drag_area_enabled: TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    if root.drag_area_enabled: TouchArea {
        x: 12px;
        y: parent.height - 7px;
        width: parent.width - 24px;
        height: 7px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    if root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Top-Right Corner
    if root.drag_area_enabled: TouchArea {
        x: parent.width - 12px;
        y: 0px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }
    // Bottom-Left Corner
    if root.drag_area_enabled: TouchArea {
        x: 0px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    if root.drag_area_enabled: TouchArea {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }

    // Modal Update Available Dialog
    if root.show_update_dialog: Rectangle {
        background: AppTheme.backdrop;
        width: 100%;
        height: 100%;
        z: 9999;

        TouchArea {
            // Block background click events
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 440px;
                    background: AppTheme.surface-sidebar;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;

                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;

                        // Header Icon and Title
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;

                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: AppTheme.accent-subtle;

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../assets/rocket.svg");
                                    width: 20px;
                                    height: 20px;
                                    colorize: AppTheme.accent;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Nova Atualização Disponível!";
                                    color: AppTheme.text-strong;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "Litecord " + root.update_version;
                                    color: AppTheme.success;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Body Description
                        Text {
                            text: root.is_updating ? root.update_status_text : "Uma nova versão do Litecord com melhorias e correções está pronta para instalação. Deseja atualizar agora?";
                            color: AppTheme.text-secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        // Progress Bar (when downloading)
                        if root.is_updating: VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 8px;
                                background: AppTheme.surface-input;
                                border-radius: 4px;
                                clip: true;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    height: 8px;
                                    width: root.update_progress * parent.width;
                                    background: AppTheme.success;
                                    border-radius: 4px;
                                }
                            }

                            Text {
                                text: Math.round(root.update_progress * 100) + "%";
                                color: AppTheme.text-subtle;
                                font-size: 11px;
                                horizontal-alignment: right;
                            }
                        }

                        // Action Buttons
                        if !root.is_updating: HorizontalLayout {
                            spacing: 10px;

                            // Não Mostrar Mais (Ignore)
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: ignore_touch.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: AppTheme.separator;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Não mostrar mais";
                                        color: AppTheme.text-muted;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                ignore_touch := TouchArea {
                                    clicked => { root.update_app_ignore(); }
                                }
                            }

                            // Lembrar Depois (Não)
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: dismiss_touch.has-hover ? AppTheme.surface-control-hover : AppTheme.interactive-hover;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Lembrar Depois";
                                        color: AppTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                dismiss_touch := TouchArea {
                                    clicked => { root.update_app_dismiss(); }
                                }
                            }

                            // Sim, Atualizar
                            Rectangle {
                                height: 36px;
                                horizontal-stretch: 1;
                                background: accept_touch.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                                border-radius: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "Sim, Atualizar";
                                        color: AppTheme.text-on-accent;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                accept_touch := TouchArea {
                                    clicked => { root.update_app_accept(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // DISCORD-STYLE SCREEN SHARE SELECTION MODAL
    // ==========================================
    if root.show_stream_modal: Rectangle {
        background: AppTheme.backdrop;
        width: 100%;
        height: 100%;

        // Dismiss when clicking outer backdrop
        TouchArea {
            clicked => { root.show_stream_modal = false; }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 500px;
                    background: AppTheme.surface-chat;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppTheme.border-subtle;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: AppTheme.backdrop;
                    clip: true;

                    TouchArea {
                        clicked => {}
                    }

                    VerticalBox {
                        padding: 0px;
                        spacing: 0px;

                        // 1. Modal Header
                        Rectangle {
                            height: 52px;
                            background: AppTheme.surface-chat;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Compartilhe sua tela";
                                        color: AppTheme.text-strong;
                                        font-size: 16px;
                                        font-weight: 700;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: close_modal_ta.has-hover ? AppTheme.interactive-hover : transparent;

                                        Image {
                                            source: @image-url("../assets/chrome-close.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: AppTheme.text-secondary;
                                            image-fit: contain;
                                        }

                                        close_modal_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_stream_modal = false; }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Tabs Bar (Captura de Tela vs Captura de Janela)
                        Rectangle {
                            height: 38px;
                            background: AppTheme.surface-sidebar;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 24px;

                                // Tab: Telas (Captura de Tela)
                                Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/monitor.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "screens" ? AppTheme.text-strong : AppTheme.text-muted;
                                            }
                                            Text {
                                                text: root.is_linux ? "Telas / Janelas" : "Telas";
                                                color: root.stream_source_tab == "screens" ? AppTheme.text-strong : AppTheme.text-muted;
                                                font-size: 13px;
                                                font-weight: root.stream_source_tab == "screens" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "screens": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: AppTheme.accent;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "screens";
                                            root.stream_selected_source_index = 0;
                                            root.stream_selected_window_id = "";
                                            root.stream_include_audio = true;
                                        }
                                    }
                                }

                                // Tab: Janelas (Captura de Janela apenas no Windows)
                                if !root.is_linux: Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/window.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "windows" ? AppTheme.text-strong : AppTheme.text-muted;
                                            }
                                            Text {
                                                text: "Janelas";
                                                color: root.stream_source_tab == "windows" ? AppTheme.text-strong : AppTheme.text-muted;
                                                font-size: 13px;
                                                font-weight: root.stream_source_tab == "windows" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "windows": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: AppTheme.accent;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "windows";
                                            root.stream_selected_source_index = 0;
                                            root.stream_include_audio = true;
                                            if root.available_windows.length > 0 {
                                                root.stream_selected_window_id = root.available_windows[0].id;
                                            }
                                        }
                                    }
                                }

                                // Tab: Câmera (Webcam)
                                Rectangle {
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/camera.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.stream_source_tab == "cameras" ? AppTheme.text-strong : AppTheme.text-muted;
                                            }
                                            Text {
                                                text: "Câmera";
                                                color: root.stream_source_tab == "cameras" ? AppTheme.text-strong : AppTheme.text-muted;
                                                font-size: 13px;
                                                font-weight: root.stream_source_tab == "cameras" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Active Tab Underline
                                    if root.stream_source_tab == "cameras": Rectangle {
                                        y: parent.height - 2px;
                                        height: 2px;
                                        width: 100%;
                                        background: AppTheme.accent;
                                        border-radius: 1px;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stream_source_tab = "cameras";
                                            root.stream_selected_source_index = 0;
                                            root.stream_include_audio = false;
                                            if root.available_cameras.length > 0 {
                                                root.stream_selected_camera_id = root.available_cameras[0].id;
                                            }
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        // 3. Source Selection Preview Area
                        VerticalBox {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: 14px;

                            // Source Cards (Telas vs Janelas)
                            if root.stream_source_tab == "screens": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for scr[idx] in root.available_screens: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? AppTheme.accent-subtle : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.border-subtle;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            // Screen Illustration Box
                                            Rectangle {
                                                height: 52px;
                                                background: AppTheme.surface-input;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? AppTheme.accent-border-muted : AppTheme.border-subtle;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/monitor.svg");
                                                            width: 24px;
                                                            height: 24px;
                                                            colorize: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.text-subtle;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: root.is_linux ? "Tela / Janela" : scr.name;
                                                color: root.stream_selected_source_index == idx ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: root.is_linux ? "Portal nativo do sistema" : scr.resolution;
                                                color: AppTheme.text-subtle;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_window_id = "";
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.is_linux && root.stream_source_tab == "windows": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for win[idx] in root.available_windows: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? AppTheme.accent-subtle : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.border-subtle;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                height: 52px;
                                                background: AppTheme.surface-input;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? AppTheme.accent-border-muted : AppTheme.border-subtle;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: win.has_icon ? win.icon_image : (win.app_name == "Litecord" ? @image-url("../assets/app_icon.png") : (win.app_name == "Google Chrome" ? @image-url("../assets/globe.svg") : @image-url("../assets/window.svg")));
                                                            width: 28px;
                                                            height: 28px;
                                                            colorize: win.has_icon || win.app_name == "Litecord" ? transparent : (root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.text-subtle);
                                                            image-fit: contain;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: win.title;
                                                color: root.stream_selected_source_index == idx ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: win.app_name;
                                                color: AppTheme.text-subtle;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_window_id = win.id;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "cameras": Flickable {
                                viewport-height: 110px;
                                height: 110px;
                                interactive: true;

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    height: 110px;

                                    for cam[idx] in root.available_cameras: Rectangle {
                                        width: 140px;
                                        height: 110px;
                                        background: root.stream_selected_source_index == idx ? AppTheme.accent-subtle : AppTheme.surface-sidebar;
                                        border-radius: 8px;
                                        border-width: 2px;
                                        border-color: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.border-subtle;
                                        clip: true;

                                        VerticalBox {
                                            padding: 8px;
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                height: 52px;
                                                background: AppTheme.surface-input;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: root.stream_selected_source_index == idx ? AppTheme.accent-border-muted : AppTheme.border-subtle;

                                                VerticalLayout {
                                                    alignment: center;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Image {
                                                            source: @image-url("../assets/camera.svg");
                                                            width: 24px;
                                                            height: 24px;
                                                            colorize: root.stream_selected_source_index == idx ? AppTheme.accent : AppTheme.text-subtle;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: cam.name;
                                                color: root.stream_selected_source_index == idx ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: "Webcam";
                                                color: AppTheme.text-subtle;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.stream_selected_source_index = idx;
                                                root.stream_selected_camera_id = cam.id;
                                            }
                                        }
                                    }

                                    if root.available_cameras.length == 0: Rectangle {
                                        width: 440px;
                                        height: 110px;
                                        background: AppTheme.surface-sidebar;
                                        border-radius: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: "Nenhuma câmera / webcam detectada no sistema.";
                                                color: AppTheme.text-muted;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // 4. Stream Quality Section (Displayed ONLY for Screens and Windows, as Cameras use their optimal native sensor stream)
                            if root.stream_source_tab != "cameras": Text {
                                text: "QUALIDADE DA TRANSMISSÃO";
                                color: AppTheme.text-secondary;
                                font-size: 11px;
                                font-weight: 800;
                            }

                            // Resolution Selection (1080p, 720p, 480p)
                            if root.stream_source_tab != "cameras": VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                Text {
                                    text: "RESOLUÇÃO";
                                    color: AppTheme.text-muted;
                                    font-size: 10px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    // 1080p (1920x1080)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "1080p" ? AppTheme.accent : (res_1080_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "1080p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "1080p (1920×1080)";
                                                color: root.stream_selected_res == "1080p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_1080_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "1080p"; }
                                        }
                                    }

                                    // 720p (1280x720)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "720p" ? AppTheme.accent : (res_720_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "720p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "720p (1280×720)";
                                                color: root.stream_selected_res == "720p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_720_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "720p"; }
                                        }
                                    }

                                    // 480p (854x480)
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_res == "480p" ? AppTheme.accent : (res_480_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_res == "480p" ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "480p (854×480)";
                                                color: root.stream_selected_res == "480p" ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        res_480_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_res = "480p"; }
                                        }
                                    }
                                }
                            }

                            // Framerate Selection (60 FPS, 30 FPS, 15 FPS)
                            if root.stream_source_tab != "cameras": VerticalBox {
                                padding: 0px;
                                spacing: 6px;

                                Text {
                                    text: "TAXA DE QUADROS (FPS)";
                                    color: AppTheme.text-muted;
                                    font-size: 10px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 32px;

                                    // 60 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 60 ? AppTheme.accent : (fps_60_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 60 ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "60 FPS";
                                                color: root.stream_selected_fps == 60 ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_60_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 60; }
                                        }
                                    }

                                    // 30 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 30 ? AppTheme.accent : (fps_30_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 30 ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "30 FPS";
                                                color: root.stream_selected_fps == 30 ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_30_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 30; }
                                        }
                                    }

                                    // 15 FPS
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.stream_selected_fps == 15 ? AppTheme.accent : (fps_15_ta.has-hover ? AppTheme.interactive-hover : AppTheme.surface-sidebar);
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.stream_selected_fps == 15 ? AppTheme.accent : AppTheme.border-subtle;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "15 FPS";
                                                color: root.stream_selected_fps == 15 ? AppTheme.text-strong : AppTheme.text-primary;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        fps_15_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.stream_selected_fps = 15; }
                                        }
                                    }
                                }
                            }

                            // Camera Info Note (Single sleek note only when cameras exist)
                            if root.stream_source_tab == "cameras" && root.available_cameras.length > 0: Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 44px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/camera.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: AppTheme.accent;
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "A webcam transmitirá utilizando a resolução e taxa nativas do seu dispositivo.";
                                            color: AppTheme.text-muted;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }

                            // 5. Stream Audio Toggle Section (Disabled/informational for Cameras)
                            if root.stream_source_tab != "cameras": Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: root.stream_include_audio ? @image-url("../assets/speaker.svg") : @image-url("../assets/volume-x.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: root.stream_include_audio ? AppTheme.accent : AppTheme.text-subtle;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "Transmitir Áudio do Computador / Janela";
                                                color: AppTheme.text-strong;
                                                font-size: 12px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Inclui o som do aplicativo ou jogo durante a transmissão";
                                                color: AppTheme.text-muted;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    // Switch Toggle Button
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 40px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: root.stream_include_audio ? AppTheme.success : AppTheme.surface-control;

                                            // Knob
                                            Rectangle {
                                                x: root.stream_include_audio ? 20px : 2px;
                                                y: 2px;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: AppTheme.solid-white;
                                                animate x { duration: 150ms; easing: ease-out; }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.stream_include_audio = !root.stream_include_audio;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "windows": Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/globe.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: AppTheme.accent;
                                                image-fit: contain;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "Navegador para Transmissão (Vídeos / DRM)";
                                                color: AppTheme.text-strong;
                                                font-size: 12px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Abre o navegador sem travas de tela preta para assistir com amigos";
                                                color: AppTheme.text-muted;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    // Launch Button
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 4px;
                                            background: stream_browser_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 6px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("../assets/external-link.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        colorize: AppTheme.text-on-accent;
                                                        image-fit: contain;
                                                    }
                                                }

                                                Text {
                                                    text: "Abrir";
                                                    color: AppTheme.text-on-accent;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            stream_browser_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.launch_stream_browser();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.stream_source_tab == "cameras": Rectangle {
                                background: AppTheme.surface-sidebar;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppTheme.border-subtle;
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/camera.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: AppTheme.accent;
                                            image-fit: contain;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Transmissão Direta de Câmera";
                                            color: AppTheme.text-strong;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Apenas vídeo da webcam (sem captura de áudio do sistema)";
                                            color: AppTheme.text-muted;
                                            font-size: 10px;
                                        }
                                    }
                                }
                            }
                        }

                        // 6. Pinned Modal Footer Action Bar
                        Rectangle {
                            height: 60px;
                            background: AppTheme.surface-sidebar;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 12px;
                                alignment: space-between;

                                // Cancelar Button
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 4px;
                                        background: modal_cancel_ta.has-hover ? AppTheme.interactive-hover : transparent;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: "Cancelar";
                                                color: AppTheme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }

                                        modal_cancel_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show_stream_modal = false; }
                                        }
                                    }
                                }

                                // Transmitir Button
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 4px;
                                        background: modal_start_ta.has-hover ? AppTheme.accent-hover : AppTheme.accent;

                                        HorizontalLayout {
                                            alignment: center;
                                            padding-left: 18px;
                                            padding-right: 18px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: root.stream_source_tab == "cameras" ? @image-url("../assets/camera.svg") : (root.stream_source_tab == "windows" ? @image-url("../assets/window.svg") : @image-url("../assets/monitor.svg"));
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: AppTheme.text-on-accent;
                                                    image-fit: contain;
                                                }
                                            }

                                            Text {
                                                text: "Transmitir";
                                                color: AppTheme.text-on-accent;
                                                font-size: 13px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        modal_start_ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.show_stream_modal = false;
                                                root.toggle_screen_share();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Popout Detached Video Window Component
export component PopoutStreamWindow inherits Window {
    title: "Litecord - Transmissão Desanexada";
    no-frame: true;
    background: AppTheme.surface-media;
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 180px;
    min-height: 100px;
    default-font-family: "Segoe UI, Segoe UI Emoji, Segoe UI Symbol, sans-serif";

    // Visual boundary border
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: AppTheme.surface-sidebar;
    }

    in-out property <image> stream_frame;
    in-out property <string> username: "Transmissão";
    in-out property <string> user_id: "";
    in-out property <string> stream_fps: "";
    in-out property <float> stream_volume: 1.0;
    in-out property <bool> is_pinned: false;
    in-out property <bool> is_intangible: false;
    in-out property <bool> show_controls: true;
    in-out property <bool> is_maximized: false;
    in-out property <bool> drag_area_enabled: true;
    in-out property <bool> is_linux: false;
    in-out property <bool> is_self: false;
    in-out property <bool> show_self_preview_notice: false;

    callback toggle_pin();
    callback toggle_intangible();
    callback start_window_drag();
    callback toggle_fullscreen();
    callback close_popout();
    callback minimize_popout();
    callback drag_resize(string);
    callback mouse_activity();
    callback stream_volume_changed(string, float);

    // Global mouse activity tracker
    TouchArea {
        pointer-event(event) => {
            root.mouse_activity();
        }
    }

    // Video Canvas Viewport
    Image {
        width: 100%;
        height: 100%;
        source: root.stream_frame;
        image-fit: contain;
    }

    // Top Autohiding Controls Bar (Discord Floating Overlay Style)
    if root.show_controls: Rectangle {
        y: 8px;
        x: 8px;
        width: parent.width - 16px;
        height: 38px;
        background: AppTheme.surface-media-overlay;
        border-radius: 8px;
        border-width: 1px;
        border-color: AppTheme.surface-sidebar-overlay;
        drop-shadow-blur: 8px;
        drop-shadow-color: AppTheme.backdrop-soft;

        // Background Drag Handle (placed first so buttons on top receive clicks!)
        if root.drag_area_enabled: TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                root.mouse_activity();
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.start_window_drag();
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: space-between;

            // Left Side: Live Badge & Username Pill & Dynamic Volume Slider (Vertically Centered)
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Live Badge (hides when width <= 340px)
                if root.width > 340px : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: AppTheme.danger;
                        border-radius: 4px;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: AppTheme.solid-white;
                                }
                            }
                            Text {
                                text: "AO VIVO";
                                color: AppTheme.text-on-accent;
                                font-size: 10px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // FPS Counter Badge (Local) (hides when width <= 270px)
                if root.stream_fps != "" && root.width > 270px : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        background: AppTheme.success-subtle;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: AppTheme.success;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: AppTheme.success;
                                }
                            }
                            Text {
                                text: root.stream_fps;
                                color: AppTheme.success;
                                font-size: 10px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Stream Username & Tag (hides when width <= 200px)
                if root.width > 200px : VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.username;
                        color: AppTheme.text-strong;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Dynamic Volume Slider (only shown if popout width has enough space > 420px)
                if root.width > 420px : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.stream_volume <= 0.01 ? @image-url("../assets/volume-x.svg") : @image-url("../assets/speaker.svg");
                            width: 13px;
                            height: 13px;
                            colorize: root.stream_volume <= 0.01 ? AppTheme.danger : AppTheme.text-muted;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 65px;
                            height: 6px;
                            background: AppTheme.interactive-hover;
                            border-radius: 3px;

                            // Volume fill bar
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * (root.stream_volume.clamp(0.0, 1.0));
                                height: 100%;
                                background: root.stream_volume <= 0.01 ? AppTheme.danger : AppTheme.accent;
                                border-radius: 3px;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                    root.stream_volume = new_vol;
                                    root.stream_volume_changed(root.user_id, new_vol);
                                }
                                moved => {
                                    if self.pressed {
                                        let new_vol = (self.mouse-x / parent.width).clamp(0.0, 1.0);
                                        root.stream_volume = new_vol;
                                        root.stream_volume_changed(root.user_id, new_vol);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "\{Math.round(root.stream_volume * 100)}%";
                            color: AppTheme.text-muted;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Right Side: Window Control Action Buttons (Vertically Centered)
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                // Intangible / Click-Through Ghost Mode Toggle (Left of Pin)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.is_intangible ? AppTheme.success : (pop_ghost_ta.has-hover ? AppTheme.interactive-hover : transparent);

                        Image {
                            source: @image-url("../assets/ghost.svg");
                            width: 13px;
                            height: 13px;
                            colorize: root.is_intangible ? AppTheme.text-on-accent : (pop_ghost_ta.has-hover ? AppTheme.text-strong : AppTheme.text-primary);
                            image-fit: contain;
                        }

                        pop_ghost_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_intangible(); }
                        }
                    }
                }

                // Pin / Always-On-Top Toggle Button (Left of Minimize)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.is_pinned ? AppTheme.accent : (pop_pin_ta.has-hover ? AppTheme.interactive-hover : transparent);

                        Image {
                            source: @image-url("../assets/pin.svg");
                            width: 12px;
                            height: 12px;
                            colorize: root.is_pinned ? AppTheme.text-on-accent : (pop_pin_ta.has-hover ? AppTheme.text-strong : AppTheme.text-primary);
                            image-fit: contain;
                        }

                        pop_pin_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_pin(); }
                        }
                    }
                }

                // Minimize Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_min_ta.has-hover ? AppTheme.interactive-hover : transparent;

                        Image {
                            source: @image-url("../assets/chrome-minimize.svg");
                            width: 12px;
                            height: 12px;
                            colorize: AppTheme.text-primary;
                            image-fit: contain;
                        }

                        pop_min_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.minimize_popout(); }
                        }
                    }
                }

                // Fullscreen / Maximize Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_fs_ta.has-hover ? AppTheme.interactive-hover : transparent;

                        Image {
                            source: root.is_maximized ? @image-url("../assets/chrome-restore.svg") : @image-url("../assets/chrome-maximize.svg");
                            width: 12px;
                            height: 12px;
                            colorize: AppTheme.text-primary;
                            image-fit: contain;
                        }

                        pop_fs_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_fullscreen(); }
                        }
                    }
                }

                // Close / Re-attach Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: pop_close_ta.has-hover ? AppTheme.danger : transparent;

                        Image {
                            source: @image-url("../assets/chrome-close.svg");
                            width: 12px;
                            height: 12px;
                            colorize: pop_close_ta.has-hover ? AppTheme.text-on-accent : AppTheme.text-primary;
                            image-fit: contain;
                        }

                        pop_close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close_popout(); }
                        }
                    }
                }
            }
        }
    }

    // Self-Preview Resource Notice in Popout (Single compact line below AO VIVO badge)
    if (root.is_self && root.show_self_preview_notice): Rectangle {
        x: 8px;
        y: 44px;
        width: parent.width > 230px ? 215px : (parent.width - 16px > 0px ? parent.width - 16px : 0px);
        height: 20px;
        background: AppTheme.surface-media-overlay-strong;
        border-radius: 4px;
        border-width: 1px;
        border-color: AppTheme.accent-border-strong;
        clip: true;

        HorizontalLayout {
            width: 100%;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/info.svg");
                    width: 11px;
                    height: 11px;
                    colorize: AppTheme.accent;
                    image-fit: contain;
                }
            }

            Text {
                text: "Prévia reduzida para poupar recursos";
                color: AppTheme.text-primary;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.show_self_preview_notice = false; }
        }
    }

    // Window Drag Resize Borders & Corner Handles (0-latency hardware resize)
    // Left edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 12px;
        width: 8px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("left");
            }
        }
    }
    // Right edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 8px;
        y: 12px;
        width: 8px;
        height: parent.height - 24px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("right");
            }
        }
    }
    // Top edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top");
            }
        }
    }
    // Bottom edge
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 12px;
        y: parent.height - 8px;
        width: parent.width - 24px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom");
            }
        }
    }
    // Top-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: 0px;
        width: 14px;
        height: 14px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-left");
            }
        }
    }
    // Top-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 14px;
        y: 0px;
        width: 14px;
        height: 14px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("top-right");
            }
        }
    }
    // Bottom-Left Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: 0px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        mouse-cursor: nesw-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-left");
            }
        }
    }
    // Bottom-Right Corner
    if !root.is_maximized && root.drag_area_enabled: TouchArea {
        x: parent.width - 14px;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_resize("bottom-right");
            }
        }
    }
}

import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView, TextEdit, CheckBox } from "std-widgets.slint";

struct ChatMessage {
    author: string,
    timestamp: string,
    content: string,
}

struct ChannelItem {
    id: string,
    name: string,
    is_voice: bool,
}

struct GuildItem {
    id: string,
    name: string,
    icon: string,
    has_image: bool,
    icon_image: image,
}

struct AudioDeviceItem {
    id: string,
    name: string,
    is_selected: bool,
}

export component AppWindow inherits Window {
    title: "Litecord - Ultra-Lightweight Discord Client";
    preferred-width: 980px;
    preferred-height: 620px;
    background: #1e1f22;

    // Callbacks to Rust backend
    callback login(string /* token */);
    callback send_message(string /* content */);
    callback select_channel(string /* channel_id */);
    callback select_guild(string /* guild_id */);
    callback toggle_mute();
    callback toggle_deafen();
    callback leave_voice();
    callback minimize_to_tray();
    callback open_settings();
    callback close_settings();
    callback select_input_device(string /* device_name */);
    callback select_output_device(string /* device_name */);

    // Properties exposed to Rust backend
    in-out property <bool> is_logged_in: false;
    in-out property <string> connection_status: "Aguardando Token de Acesso...";
    in-out property <string> user_tag: "Não conectado";
    in-out property <string> active_channel_name: "Selecione um canal";
    in-out property <bool> is_muted: false;
    in-out property <bool> is_deafened: false;
    in-out property <bool> is_in_voice: false;
    in-out property <string> current_voice_channel: "";

    // Voice & Audio Settings Properties
    in-out property <bool> show_settings_modal: false;
    in-out property <[AudioDeviceItem]> input_devices: [];
    in-out property <[AudioDeviceItem]> output_devices: [];
    in-out property <string> selected_input_device: "Microfone Padrão do Sistema";
    in-out property <string> selected_output_device: "Alto-falantes Padrão do Sistema";
    in-out property <float> mic_level: 0.0; // Real-time mic volume level (0.0 to 1.0)

    in-out property <[GuildItem]> guilds: [];
    in-out property <[ChannelItem]> channels: [];
    in-out property <[ChatMessage]> messages: [
        { author: "Litecord System", timestamp: "Agora", content: "Bem-vindo ao Litecord! Seus servidores carregarão na barra lateral à esquerda." }
    ];

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Status Header Bar
        Rectangle {
            height: 36px;
            background: #111214;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: "⚡ LITECORD";
                    color: #5865f2;
                    font-weight: 800;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.connection_status;
                    color: #949ba4;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "⚙️ Configurações";
                    clicked => { root.open_settings(); }
                }

                Button {
                    text: "📌 Minimizar p/ Tray";
                    clicked => { root.minimize_to_tray(); }
                }
            }
        }

        // Body Content
        if !root.is_logged_in: Rectangle {
            background: #2b2d31;

            VerticalBox {
                alignment: center;
                spacing: 16px;
                width: 420px;

                Text {
                    text: "Entrar no Litecord";
                    color: #f2f3f5;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Insira seu Discord User Token para conexão direta à Gateway v9.\n(Consumo de RAM estimado em ~15MB)";
                    color: #b5bac1;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                token_input := LineEdit {
                    placeholder-text: "Cole seu Discord User Token aqui...";
                    input-type: password;
                    accepted => {
                        if (token_input.text != "") {
                            root.login(token_input.text);
                        }
                    }
                }

                HorizontalBox {
                    alignment: center;
                    Button {
                        text: "🚀 Conectar à Gateway";
                        primary: true;
                        clicked => {
                            if (token_input.text != "") {
                                root.login(token_input.text);
                            }
                        }
                    }
                }
            }
        }

        if root.is_logged_in: HorizontalBox {
            padding: 0px;
            spacing: 0px;

            // 1. Guilds Sidebar (Servidores com Scroll e tamanho fixado)
            Rectangle {
                width: 72px;
                background: #1e1f22;

                VerticalBox {
                    padding: 8px;
                    spacing: 0px;

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 10px;
                                alignment: start;

                                for guild in root.guilds: Rectangle {
                                    height: 48px;
                                    width: 48px;
                                    background: #313338;
                                    border-radius: 24px;
                                    clip: true;

                                    if guild.has_image: Image {
                                        source: guild.icon_image;
                                        width: 48px;
                                        height: 48px;
                                    }

                                    if !guild.has_image: Text {
                                        text: guild.icon;
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    TouchArea {
                                        clicked => { root.select_guild(guild.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Channels Sidebar (Canais com Scroll e tamanho fixado)
            Rectangle {
                width: 230px;
                background: #2b2d31;

                VerticalBox {
                    padding: 8px;
                    spacing: 6px;

                    Text {
                        text: "CANAIS DO SERVIDOR";
                        color: #949ba4;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 0px;
                                spacing: 4px;
                                alignment: start;

                                for channel in root.channels: Rectangle {
                                    height: 34px;
                                    background: #35373c;
                                    border-radius: 6px;

                                    HorizontalBox {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;

                                        Text {
                                            text: channel.is_voice ? "🔊" : "#";
                                            color: channel.is_voice ? #23a55a : #80848e;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: channel.name;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.select_channel(channel.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Active Voice Channel Banner
                    if root.is_in_voice: Rectangle {
                        height: 44px;
                        background: #23a55a;
                        border-radius: 6px;

                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: root.current_voice_channel;
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                text: "🔴 Sair";
                                clicked => { root.leave_voice(); }
                            }
                        }
                    }

                    // User Footer in Channels bar
                    Rectangle {
                        height: 54px;
                        background: #232428;
                        border-radius: 6px;

                        VerticalBox {
                            padding: 6px;
                            spacing: 2px;

                            Text {
                                text: root.user_tag;
                                color: #f2f3f5;
                                font-size: 12px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 4px;

                                Button {
                                    text: root.is_muted ? "🎙️ Unmute" : "🎙️ Mute";
                                    clicked => { root.toggle_mute(); }
                                }

                                Button {
                                    text: root.is_deafened ? "🎧 Undeafen" : "🎧 Deafen";
                                    clicked => { root.toggle_deafen(); }
                                }

                                Button {
                                    text: "⚙️";
                                    clicked => { root.open_settings(); }
                                }
                            }
                        }
                    }
                }
            }

            // 3. Main Chat View
            Rectangle {
                background: #313338;
                horizontal-stretch: 1;

                VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    // Channel Header
                    Rectangle {
                        height: 42px;
                        background: #313338;

                        HorizontalBox {
                            padding-left: 16px;

                            Text {
                                text: root.active_channel_name;
                                color: #f2f3f5;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Messages Scroll View
                    Rectangle {
                        vertical-stretch: 1;

                        ScrollView {
                            height: 100%;
                            width: 100%;

                            VerticalBox {
                                padding: 12px;
                                spacing: 10px;

                                for msg in root.messages: Rectangle {
                                    background: #2b2d31;
                                    border-radius: 6px;

                                    VerticalBox {
                                        padding: 8px;
                                        spacing: 4px;

                                        HorizontalBox {
                                            Text {
                                                text: msg.author;
                                                color: #5865f2;
                                                font-weight: 700;
                                                font-size: 13px;
                                            }

                                            Text {
                                                text: msg.timestamp;
                                                color: #949ba4;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: msg.content;
                                            color: #dbdee1;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Message Input Box
                    Rectangle {
                        height: 56px;
                        background: #313338;

                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;

                            msg_input := LineEdit {
                                placeholder-text: "Conversar em " + root.active_channel_name + "...";
                                accepted => {
                                    if (msg_input.text != "") {
                                        root.send_message(msg_input.text);
                                        msg_input.text = "";
                                    }
                                }
                            }

                            Button {
                                text: "Enviar";
                                primary: true;
                                clicked => {
                                    if (msg_input.text != "") {
                                        root.send_message(msg_input.text);
                                        msg_input.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Popup Overlay for Voice & Audio Settings (Discord Style)
    if root.show_settings_modal: Rectangle {
        background: #000000bb;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 560px;
            height: 490px;
            background: #2b2d31;
            border-radius: 12px;

            VerticalBox {
                padding: 18px;
                spacing: 14px;

                // Header Title & Close Button
                HorizontalBox {
                    Text {
                        text: "⚙️ Configurações de Voz e Áudio";
                        color: #f2f3f5;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "✖ Sair";
                        clicked => { root.close_settings(); }
                    }
                }

                // 1. Microphone Input Device Selection
                Text {
                    text: "🎙️ DISPOSITIVO DE ENTRADA (MICROFONE)";
                    color: #b5bac1;
                    font-size: 11px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 110px;
                    background: #1e1f22;
                    border-radius: 8px;

                    ScrollView {
                        height: 100%;
                        width: 100%;

                        VerticalBox {
                            padding: 6px;
                            spacing: 4px;

                            for dev in root.input_devices: Rectangle {
                                height: 30px;
                                background: dev.is_selected ? #35373c : #2b2d31;
                                border-radius: 6px;

                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    Text {
                                        text: dev.is_selected ? "🔘" : "⚪";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: dev.name;
                                        color: dev.is_selected ? #5865f2 : #dbdee1;
                                        font-size: 12px;
                                        font-weight: dev.is_selected ? 700 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.select_input_device(dev.name); }
                                }
                            }
                        }
                    }
                }

                // 2. Speaker / Headphone Output Device Selection
                Text {
                    text: "🎧 DISPOSITIVO DE SAÍDA (ALTO-FALANTES / FONE DE OUVIDO)";
                    color: #b5bac1;
                    font-size: 11px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 110px;
                    background: #1e1f22;
                    border-radius: 8px;

                    ScrollView {
                        height: 100%;
                        width: 100%;

                        VerticalBox {
                            padding: 6px;
                            spacing: 4px;

                            for dev in root.output_devices: Rectangle {
                                height: 30px;
                                background: dev.is_selected ? #35373c : #2b2d31;
                                border-radius: 6px;

                                HorizontalBox {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    Text {
                                        text: dev.is_selected ? "🔘" : "⚪";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: dev.name;
                                        color: dev.is_selected ? #5865f2 : #dbdee1;
                                        font-size: 12px;
                                        font-weight: dev.is_selected ? 700 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.select_output_device(dev.name); }
                                }
                            }
                        }
                    }
                }

                // 3. Mic Level Test Indicator Bar (Dynamic Real-Time Level)
                HorizontalBox {
                    Text {
                        text: "🔊 TESTE DE SENSIBILIDADE DO MICROFONE AO VIVO";
                        color: #b5bac1;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: Math.round(root.mic_level * 100) + "%";
                        color: root.mic_level > 0.1 ? #23a55a : #949ba4;
                        font-size: 11px;
                        font-weight: 700;
                    }
                }

                Rectangle {
                    height: 16px;
                    background: #1e1f22;
                    border-radius: 8px;

                    HorizontalBox {
                        padding: 2px;
                        spacing: 0px;

                        Rectangle {
                            width: Math.max(8px, (root.mic_level * 500) * 1px);
                            height: 12px;
                            background: root.mic_level > 0.1 ? #23a55a : #5865f2;
                            border-radius: 6px;
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                HorizontalBox {
                    alignment: end;

                    Button {
                        text: "Concluído";
                        primary: true;
                        clicked => { root.close_settings(); }
                    }
                }
            }
        }
    }
}
